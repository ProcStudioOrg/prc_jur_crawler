{
  "name": "jur",
  "version": "0.1.0",
  "private": true,
  "description": "CLI de busca de jurisprudência nos tribunais brasileiros",
  "bin": {
    "jur": "./bin/jur"
  },
  "main": "src/index.js",
  "scripts": {
    "postinstall": "echo 'Agora rode: npx playwright install chromium'",
