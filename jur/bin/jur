  .option('--origem <origem>', 'comum (2º grau, default) | turmas (Turmas Recursais) | ambas', 'comum')
  .option('-t, --tipo <tipo>', 'acordao (default) | homologacao | monocratica | todos', 'acordao')
  .option('-r, --relator <nome>', 'Relator(a) — nome ou trecho (campo nmAgente da tela)')
  .option('-p, --processo <numero>', 'Filtro por numero de processo DENTRO da busca (use -n p/ consulta direta)')
  .option('--sem-sinonimos', 'Desliga a busca por sinonimos (checkbox da tela)')
  .option('-ord, --ordem <ordem>', 'publicacao (default) | relevancia', 'publicacao')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (100 registros/pagina)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjms.json')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor (PDF) de cada resultado')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjms')
  .option('-v, --visible', 'Ignored (TJMS usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJMS usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJMSChecker().consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.relator) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      log('='.repeat(60));
      log('TJMS Jurisprudencia Crawler (e-SAJ cjsg, HTTP direto, sem browser)');
      log('ESCOPO: 2º grau + Turmas Recursais do sistema SAJ. NAO tem 1º grau,');
      log('e NAO cobre o acervo do e-Proc (migracao 01/07/2026) — ver CLAUDE-TJMS.md');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Origem: ${opts.origem} | Tipo: ${opts.tipo} | Escopo: ${opts.escopo}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJMSCrawler({ timeout: 90000, log });
      const filters = {
        escopo: opts.escopo,
        origem: opts.origem,
        tipo: opts.tipo,
        relator: opts.relator || null,
        processo: opts.processo || null,
        ordem: opts.ordem,
        sinonimos: !opts.semSinonimos,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJMSChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJMS : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nBaixando inteiro teor de ${results.length} julgados...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjac')
  .description('Search TJAC (Tribunal de Justica do Acre) jurisprudence — e-SAJ cjsg, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores: E, OU, NAO, "frase exata"; ADJ/PROX e $ NAO existem)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (TJACChecker); dispensa -q')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--escopo <escopo>', 'Onde buscar o termo: ementa (default) ou inteiroTeor', 'ementa')
  .option('--origem <origem>', 'comum (2º grau, default) | turmas (Turmas Recursais) | ambas', 'comum')
  .option('-t, --tipo <tipo>', 'acordao (default) | monocratica | todos (o TJAC NAO tem a aba homologacao)', 'acordao')
  .option('-r, --relator <nome>', 'Relator(a) — nome ou trecho (campo nmAgente da tela)')
  .option('-p, --processo <numero>', 'Filtro por numero de processo DENTRO da busca (use -n p/ consulta direta)')
  .option('--sem-sinonimos', 'Desliga a busca por sinonimos (checkbox da tela)')
  .option('-ord, --ordem <ordem>', 'publicacao (default) | relevancia', 'publicacao')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 registros/pagina)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjac.json')
  .option('--fetch-inteiro-teor', 'Grava a EMENTA integra (o PDF do inteiro teor tem reCAPTCHA)')
  .option('--tentar-pdf', 'Tenta mesmo assim o PDF por documento — so para reconferir se o bloqueio caiu')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjac')
  .option('-v, --visible', 'Ignored (TJAC usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJAC usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJACChecker().consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.relator) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      log('='.repeat(60));
      log('TJAC Jurisprudencia Crawler (e-SAJ cjsg, HTTP direto, sem browser)');
      log('ESCOPO: 2º grau + Turmas Recursais do sistema SAJ. NAO tem 1º grau,');
      log('e NAO cobre o acervo do e-Proc — ver CLAUDE-TJAC.md');
      log('ATENCAO: o INTEIRO TEOR (PDF) esta atras de reCAPTCHA. A busca e livre e a');
      log('ementa integra vem nela; o relatorio/voto completos NAO sao acessiveis.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Origem: ${opts.origem} | Tipo: ${opts.tipo} | Escopo: ${opts.escopo}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJACCrawler({ timeout: 90000, log });
      const filters = {
        escopo: opts.escopo,
        origem: opts.origem,
        tipo: opts.tipo,
        relator: opts.relator || null,
        processo: opts.processo || null,
        ordem: opts.ordem,
        sinonimos: !opts.semSinonimos,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJACChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJAC : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nGravando ${results.length} julgados (ementa integra; PDF bloqueado por reCAPTCHA)...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, {
          log, tentarPdf: opts.tentarPdf,
        });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nGravacao concluida: ${successCount} arquivo(s), ${failCount} falha(s)`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

