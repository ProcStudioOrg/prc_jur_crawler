  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    const baseNames = { '0': 'TRF3', '1': 'Turmas Recursais', '2': 'Monocráticas' };

    log('='.repeat(60));
    log('TRF3 Jurisprudencia Crawler');
