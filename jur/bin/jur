  .command('tjms')
  .description('Search TJMS (Tribunal de Justica de Mato Grosso do Sul) jurisprudence — e-SAJ cjsg, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores: E, OU, NAO, "frase exata", $ radical)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (TJMSChecker); dispensa -q')
