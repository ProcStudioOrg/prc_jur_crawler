  .option('--fetch-pdf', 'Baixa tambem o PDF ORIGINAL (base64 em /conteudo-documento)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcepe')
  .option('-v, --visible', 'Ignored (TCE-PE usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-PE usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.numero) {
        const res = await new TCEPEChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const nav = new (require('../src/TCEPENavigator'))({ log });
        const saida = {
          orgaosJulgadores: await nav.orgaosJulgadores(),
          relatores: await nav.relatores(),
          modalidades: await nav.modalidades(),
          tiposProcesso: await nav.tiposProcesso(),
          anosDeliberacao: await nav.anosDeliberacao(),
          unidadesGestoras: '(1.262 — ver human-codegen/TCEPE/01-jurisprudencia/unidades-gestoras.json)',
        };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.orgao && !opts.relator && !opts.unidade && !opts.modalidade
          && !opts.tipoProcesso && !opts.deliberacao && !opts.anoDeliberacao && !opts.dataInicio) {
        throw new Error('Informe -q "<termo>" (ou -n <numero>, ou um filtro como --orgao/--unidade)');
      }

      const avisosData = [];
      if (opts.dataPubInicio || opts.dataPubFim) {
        avisosData.push(
          'NAO EXISTE data de publicacao no TCE-PE, nem como filtro nem como campo do ' +
            'documento: o unico eixo temporal e a data da SESSAO DE JULGAMENTO. As flags ' +
            '-dpi/-dpf foram tratadas como -di/-df. Nunca apresente essa data como publicacao.',
        );
      }

      log('='.repeat(60));
      log('TCE-PE — Consulta de Deliberacoes (controle externo)');
      log('  [escopo] PERNAMBUCO NAO TEM TCM: o combo de unidades traz 184 Prefeituras');
      log('           e 183 Camaras Municipais, INCLUSIVE a Prefeitura da Cidade do');
      log('           Recife. Contas municipais estao NESTA base.');
      log('  [aviso] NAO ha operador booleano. O espaco ja e "E" implicito, e E/OU/NAO');
      log('          sao palavras comuns: "A OU B" devolve a INTERSECAO, nao a uniao.');
      log('  [aviso] ACENTO IMPORTA: licitacao = 40 contra licitação = 13.636. Sem acento');
      log('          a busca devolve um SUBCONJUNTO PLAUSIVEL, nao zero.');
      log('  [aviso] Nao ha EMENTA como campo: o que vem e o TEXTO INTEGRAL da deliberacao.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'}`);
      log('='.repeat(60));

      const crawler = new TCEPECrawler({ log });
      const res = await crawler.buscar({
        query: opts.query,
        expressaoExata: !!opts.exata,
        orgaoJulgador: opts.orgao,
        relator: opts.relator,
        unidadeGestora: opts.unidade,
        modalidade: opts.modalidade,
        tipoProcesso: opts.tipoProcesso,
        numeroDeliberacao: opts.deliberacao,
        anoDeliberacao: opts.anoDeliberacao,
        acordao: !opts.semAcordao,
        decisao: !opts.semDecisao,
        parecerPrevio: !opts.semParecerPrevio,
        dataInicio: opts.dataInicio || opts.dataPubInicio,
        dataFim: opts.dataFim || opts.dataPubFim,
        size: opts.size,
        maxPages: opts.maxPages,
      });

      log('='.repeat(60));
      log(`Total: ${res.total} documentos (exato) — ${res.retornados} baixados em ${res.paginas} pagina(s)`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} pelos permalinks oficiais...`);
        verificacao = await new TCEPEChecker({ log }).verificar(res.resultados, amostra);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(res.resultados, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (opts.fetchInteiroTeor || opts.fetchPdf) {
        const dir = path.resolve(opts.outputDir);
        fs.mkdirSync(dir, { recursive: true });
        let n = 0;
        let pdfs = 0;
        const nav = new (require('../src/TCEPENavigator'))({ log });
        for (const r of res.resultados) {
          const base = `${(r.processo || 'sem-processo').replace(/[^\w.-]/g, '_')}_${r.id}`;
          if (opts.fetchInteiroTeor && r.inteiroTeor) {
            fs.writeFileSync(path.join(dir, base + '.txt'), r.inteiroTeor, 'utf-8');
            n++;
          }
          // O PDF e o ARQUIVO ORIGINAL. O texto ja veio na busca, entao isto e opcional.
          if (opts.fetchPdf && r.processo) {
            const doc = await nav.baixarDocumento(r.processo);
            if (doc.ok) { fs.writeFileSync(path.join(dir, base + '.pdf'), doc.buffer); pdfs++; }
            else log(`   [pdf] ${r.processo}: HTTP ${doc.status} — ${String(doc.mensagem).slice(0, 90)}`);
          }
        }
        log(`Inteiro teor gravado: ${n} arquivo(s) de texto${opts.fetchPdf ? ` e ${pdfs} PDF(s)` : ''} em ${dir}`);
        if (opts.fetchInteiroTeor) log('   (o TEXTO ja vinha na busca — nao houve segundo salto para ele)');
      }

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({
            success: true,
            count: res.total,
            retornados: res.retornados,
            output: outputPath,
            totalExato: res.totalExato,
            semTexto: res.resultados.filter((r) => r.semTexto).length,
            avisos: [...avisosData, ...res.avisos],
            ...(verificacao ? { verificacao } : {}),
          }) + '\n',
        );
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcdf')
  .description('Search TCDF (Tribunal de Contas do Distrito Federal) — API REST publica, sem browser')
  .option('-q, --query <text>', 'Termo. E query_string Lucene: AND/OR/NOT, "frase", curinga*, campo:valor')
  .option('-n, --numero <numero>', 'Consulta por e-doc ("B0AB532D") ou processo ("4518/2020"); dispensa -q')
  .option('--selecionada', 'So a Jurisprudencia Selecionada (2.430 de 18.370 — a curadoria do TCDF)')
