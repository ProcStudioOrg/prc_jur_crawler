  .description('Search TJPB (Tribunal de Justica da Paraiba) jurisprudence — API REST publica, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (E/OU/NAO/NÃO e AND/OR/NOT funcionam; acento e OBRIGATORIO)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (TJPBChecker); dispensa -q')
  // 🔴 A base so tem data de JULGAMENTO — `meioPublicacao` veio null em 200/200.
