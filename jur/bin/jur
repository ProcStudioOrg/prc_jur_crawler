        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjap')
  .description('Search TJAP (Tribunal de Justica do Amapa) — Banco de Decisoes e Sentencas, 1o GRAU, HTTP direto, sem browser')
  // 🔴 O espaco entre termos e OR e NAO existe operador booleano. --frase e o unico AND.
  .option('-q, --query <text>', 'Busca livre — ATENCAO: o ESPACO entre termos e OR (uniao); nao ha operador booleano')
  .option('--frase <text>', 'Frase exata e ordenada (campo `match_phrase`) — a unica forma de exigir os termos juntos')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (TJAPChecker); dispensa -q')
  .option('--datajud', 'Com -n: confirma o processo tambem no DataJud/CNJ (cobre o TJAP alem desta base)')
  // 🔴 So existe data de JUNTADA — nao ha julgamento nem publicacao nesta base.
  .option('-di, --data-inicio <date>', 'Data de JUNTADA inicial (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Data de JUNTADA final (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Alias de -di — o TJAP NAO tem data de publicacao')
  .option('-dpf, --data-pub-fim <date>', 'Alias de -df — o TJAP NAO tem data de publicacao')
  .option('-t, --tipo <tipo>', 'ambos (default) | sentenca | decisao', 'ambos')
  .option('--sistema <sistema>', 'ambos (default) | pje | tucujuris — sistema de origem do ato', 'ambos')
  .option('--ano <anos>', 'Ano(s) de juntada, separados por virgula (ex: 2023,2024)')
  .option('-r, --relator <nome>', 'Magistrado(a) — NOME exato do combo (use --listar-filtros magistrados)')
  .option('--orgao <nome>', 'Orgao julgador (Vara) — NOME exato do combo')
  .option('-c, --classe <nome>', 'Classe processual — NOME exato do combo')
  .option('--assunto <nome>', 'Assunto — valor exato do combo (formato "<codigo>-<nome>")')
  .option('--listar-filtros [combo]', 'Lista os combos (orgaos, classes, assuntos, anos, magistrados)')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero e abrindo o permalink (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (10 documentos por pagina, teto 1000)', 10)
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjap.json')
  .option('--fetch-inteiro-teor', 'Grava o ato inteiro (ja vem na busca — sem request extra)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjap')
  .option('-v, --visible', 'Ignored (TJAP usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJAP usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const checker = new TJAPChecker({ log });
        const res = await checker.consultarProcesso(opts.numero);
        if (opts.datajud) res.datajud = await checker.consultarDataJud(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const combo = opts.listarFiltros === true ? null : opts.listarFiltros;
        const out = await new TJAPCrawler({ log }).listarFiltros(combo);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combo, opcoes: out }) + '\n');
        else console.log(JSON.stringify(out, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.frase) {
        throw new Error('Informe -q "<termos>" (ou --frase "<frase exata>", ou -n <numero>)');
      }

      const di = opts.dataInicio || opts.dataPubInicio || null;
      const df = opts.dataFim || opts.dataPubFim || null;
      if (opts.dataPubInicio || opts.dataPubFim) {
        log('AVISO: o TJAP NAO tem data de publicacao. -dpi/-dpf foram tratados como JUNTADA.');
      }

      log('='.repeat(60));
      log('TJAP Jurisprudencia Crawler (Banco de Decisoes e Sentencas, HTTP direto)');
      log('ESCOPO: 1º GRAU (sentencas e decisoes de Vara). Acordao do TJAP NAO esta aqui —');
      log('        ele fica no Tucujuris, atras de um desafio anti-robo. Esta base NAO TEM EMENTA.');
      log('ATENCAO: o ESPACO entre termos e OR — use --frase para exigir os termos juntos.');
      log('ATENCAO: acento e obrigatorio ("usucapiao" = 1, "usucapião" = 2.001).');
      log('ATENCAO: o total satura em 10.000 e a paginacao para junto.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      if (opts.frase) log(`Frase exata: ${opts.frase}`);
      log(`Data juntada: ${di || '-'} a ${df || '-'}`);
      log(`Tipo: ${opts.tipo} | Sistema: ${opts.sistema} | Ano(s): ${opts.ano || '-'}`);
      log(`Max Pages: ${opts.maxPages} (10 documentos por pagina)`);
      log('='.repeat(60));

      const crawler = new TJAPCrawler({
        timeout: 120000,
        log,
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        frase: opts.frase,
        dataInicio: di,
        dataFim: df,
        tipo: opts.tipo,
        sistema: opts.sistema,
        anos: opts.ano ? String(opts.ano).split(',').map((a) => a.trim()).filter(Boolean) : [],
        relator: opts.relator,
        orgao: opts.orgao,
        classe: opts.classe,
        assunto: opts.assunto,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
        maxResults: opts.maxResults ? parseInt(opts.maxResults, 10) : undefined,
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJAPChecker({ log }).verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJAP : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nGravando ${results.length} documentos (ja vieram na busca)...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter((r) => r.arquivo).length;
        const failCount = downloaded.filter((r) => !r.arquivo).length;
        log(`\nGravacao concluida: ${successCount} arquivo(s), ${failCount} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjro')
  .description('Search TJRO (Tribunal de Justica de Rondonia) jurisprudence — portal JURIS, HTTP direto, sem browser')
  // 🔴 O espaço entre termos e OR. Os campos estruturados abaixo sao o caminho certo.
  .option('-q, --query <text>', 'Busca livre — ATENCAO: o ESPACO entre termos e OR (uniao), nao AND')
  .option('--todas <text>', 'Todas as palavras (AND) — campo `todas_palavras` da pesquisa avancada')
  .option('--qualquer <text>', 'Quaisquer das palavras (OR) — campo `quaisquer_palavras`')
  .option('--excluir <text>', 'Sem as palavras (NOT) — campo `sem_palavras`; use isto em vez de "NÃO"')
  .option('--frase <text>', 'Trecho exato — campo `trecho_exato`')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (TJROChecker); dispensa -q')
  // 🔴 So existe data de JULGAMENTO — `dtpublicacao` e null em 20/20.
  .option('-di, --data-inicio <date>', 'Data de JULGAMENTO inicial (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Data de JULGAMENTO final (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Alias de -di — o TJRO NAO tem data de publicacao')
  .option('-dpf, --data-pub-fim <date>', 'Alias de -df — o TJRO NAO tem data de publicacao')
  .option('-t, --tipo <tipo>', 'todos (default) | ementa | acordao | sentenca | decisao | voto | relatorio | voto-vencedor', 'todos')
  .option('--origem <origem>', 'ambas (default) | comum (2º grau) | turmas (Juizado) | primeiro (1º grau)', 'ambas')
  .option('--instancia <grau>', 'todas (default) | 1 | 2 — ATENCAO: grau 2 EXCLUI as Turmas Recursais', 'todas')
  .option('-r, --relator <nome>', 'Magistrado(a) — NOME exato da faceta, nunca id')
  .option('-oj, --colegiado <nome>', 'Orgao julgador colegiado — NOME exato da faceta')
  .option('--orgao <nome>', 'Orgao julgador (gabinete) — NOME exato da faceta')
  .option('-c, --classe <nome>', 'Classe judicial — NOME exato da faceta, nunca codigo')
  .option('--listar-filtros [combo]', 'Lista os facets (sem argumento, lista os combos disponiveis)')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('--page-size <number>', 'Registros por pagina (max 500)', 20)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjro.json')
  .option('--fetch-inteiro-teor', 'Grava o texto do documento (ja vem na busca — sem request extra)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjro')
  .option('-v, --visible', 'Ignored (TJRO usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJRO usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJROChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const combo = opts.listarFiltros === true ? null : opts.listarFiltros;
        const out = await new TJROCrawler({ log }).listarFiltros(combo);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combo, opcoes: out }) + '\n');
        else console.log(JSON.stringify(out, null, 2));
        process.exit(0);
      }

      const temTermo = opts.query || opts.todas || opts.qualquer || opts.frase;
      if (!temTermo) {
        throw new Error('Informe -q "<termos>" (ou --todas/--qualquer/--frase, ou -n <numero>)');
      }

      const di = opts.dataInicio || opts.dataPubInicio || null;
      const df = opts.dataFim || opts.dataPubFim || null;
      if (opts.dataPubInicio || opts.dataPubFim) {
        log('AVISO: o TJRO NAO tem data de publicacao (`dtpublicacao` null em 20/20). ' +
            '-dpi/-dpf foram tratados como JULGAMENTO.');
      }

      log('='.repeat(60));
      log('TJRO Jurisprudencia Crawler (portal JURIS, HTTP direto, sem browser)');
      log('ESCOPO: 1º grau (48% da base) + 2º grau + Turmas Recursais.');
      log('ATENCAO: o ESPACO entre termos e OR — use --todas para exigir os dois.');
      log('ATENCAO: --origem comum EXCLUI as Turmas Recursais (Juizado e --origem turmas).');
      log('ATENCAO: NAO EXISTE PERMALINK. Verificacao e por reconsulta (-n).');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      if (opts.todas) log(`Todas as palavras (AND): ${opts.todas}`);
      if (opts.qualquer) log(`Quaisquer das palavras (OR): ${opts.qualquer}`);
      if (opts.excluir) log(`Sem as palavras (NOT): ${opts.excluir}`);
      if (opts.frase) log(`Trecho exato: ${opts.frase}`);
      log(`Data julgamento: ${di || '-'} a ${df || '-'}`);
      log(`Tipo: ${opts.tipo} | Origem: ${opts.origem} | Instancia: ${opts.instancia}`);
      log(`Max Pages: ${opts.maxPages} | Page Size: ${opts.pageSize}`);
      log('='.repeat(60));

      const crawler = new TJROCrawler({
        timeout: 120000,
        log,
        pageSize: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        todas: opts.todas,
        qualquer: opts.qualquer,
        excluir: opts.excluir,
        frase: opts.frase,
        dataInicio: di,
        dataFim: df,
        tipo: opts.tipo,
        origem: opts.origem,
        instancia: opts.instancia,
        relator: opts.relator,
        colegiado: opts.colegiado,
        orgao: opts.orgao,
        classe: opts.classe,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
        maxResults: opts.maxResults ? parseInt(opts.maxResults, 10) : undefined,
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJROChecker({ log }).verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJRO : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nGravando ${results.length} documentos (ja vieram na busca)...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nGravacao concluida: ${successCount} arquivo(s), ${failCount} falha(s)`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjto')
  .description('Search TJTO (Tribunal de Justica do Tocantins) jurisprudence — portal Jurisprudencia 4.0, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (ESPACO = OR; use E/AND para exigir os dois termos. "NÃO"/NOT excluem; "NAO" sem acento INFLA)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (aceita mascara OU 20 digitos); dispensa -q')
  .option('-t, --tipo <tipo>', 'acordao (default) | monocratica | sentenca — sao as 3 abas do portal', 'acordao')
  .option('--origem <origem>', 'ambas (default) | turmas (Turmas Recursais) | comum — Juizado x Justica Comum', 'ambas')
  .option('--instancia <grau>', 'todas (default) | 1 (1o grau) | 2 (2o grau)', 'todas')
  .option('-di, --data-inicio <date>', 'Data de JULGAMENTO inicial (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Data de JULGAMENTO final (DD/MM/YYYY)')
  .option('--somente-ementa', 'Procura o termo so na ementa (checkbox do portal)')
  .option('-c, --classe <classe>', 'Classe processual — NOME exato da faceta (use --listar-filtros)')
  .option('-r, --relator <nome>', 'Magistrado(a) — NOME exato da faceta')
  .option('-oj, --orgao <orgao>', 'Orgao julgador colegiado — NOME exato da faceta')
  .option('--competencia <nome>', 'Competencia — NOME exato da faceta (ex.: "TURMAS RECURSAIS")')
  .option('--assunto <nome>', 'Assunto CNJ — NOME exato da faceta')
  .option('--ordem <ord>', 'RELEV (default) | DESC (mais recentes) | ASC (mais antigos)')
  .option('--listar-filtros', 'Lista as facetas capturadas no mapeamento e sai')
  .option('--verificar [amostra]', 'Audita N resultados reabrindo o permalink publico (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--page-size <n>', 'Resultados por pagina (default 50; teto ~200 e OSCILA — e peso de payload)', 50)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjto.json')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor (1 GET por documento, pelo permalink)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjto')
  .option('-v, --visible', 'Ignored (TJTO usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJTO usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJTOChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const facetas = require('../human-codegen/TJTO/01-jurisprudencia/facetas.json');
        const combos = require('../human-codegen/TJTO/01-jurisprudencia/combos-select.json');
        const saida = { facetas, combos };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      if (!opts.query) throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta por processo)');

      log('='.repeat(60));
      log('TJTO Jurisprudencia Crawler (Jurisprudencia 4.0, HTTP direto, sem browser)');
      log('ESCOPO: 2o grau + Turmas Recursais + 1o GRAU (sentencas, de 2024 em diante).');
      log('ATENCAO: a janela de data e de JULGAMENTO — a base NAO tem data de publicacao.');
      log('ATENCAO: so ACORDAO tem ementa; sentenca e monocratica trazem a decisao inteira.');
      log('OK: ementa integra, CITACAO OFICIAL e PERMALINK publico, sem captcha.');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Tipo: ${opts.tipo} | Origem: ${opts.origem} | Instancia: ${opts.instancia}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'} | Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJTOCrawler({
        timeout: 90000,
        log,
        porPagina: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        tipo: opts.tipo,
        origem: opts.origem,
        instancia: opts.instancia === 'todas' ? null : opts.instancia,
        somenteEmenta: !!opts.somenteEmenta,
        classe: opts.classe || null,
        relator: opts.relator || null,
        orgao: opts.orgao || null,
        competencia: opts.competencia || null,
        assunto: opts.assunto || null,
        ordem: opts.ordem || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total no servidor: ${results.totalResults} (exato) | coletados: ${results.length}`);
      log(`Totais por tipo: ${JSON.stringify(results.totaisPorTipo)}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados pelo permalink publico...`);
        verificacao = await new TJTOChecker({ log }).auditar(results, amostra);
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.amostra} confirmados`);
      }

      const resumo = {
        totalResults: results.totalResults,
        totalExato: results.totalExato,
        totaisPorTipo: results.totaisPorTipo,
        paginasLidas: results.paginasLidas,
        porPagina: results.porPagina,
        avisos: results.avisos,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let ok = 0; let fail = 0;
        for (const r of results) {
          if (r.inteiroTeor && r.inteiroTeor.length > 0) {
            fs.writeFileSync(path.join(outputDir, `${r.id}.txt`), r.inteiroTeor, 'utf-8');
            ok++;
          } else fail++;
        }
        log(`\nGravacao concluida: ${ok} arquivo(s), ${fail} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: ok, failed: fail, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjrr')
  .description('Search TJRR (Tribunal de Justica de Roraima) jurisprudence — portal Juris (JSF), HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (ESPACO = E/AND. Operadores em PORTUGUES: E, OU, NAO/NÃO, "frase", * e $)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (aceita mascara OU 20 digitos); dispensa -q')
  .option('--datajud', 'Com -n: confirma o PROCESSO no DataJud/CNJ (nao confirma julgado)')
  .option('-t, --tipo <tipo>', 'todos (default) | acordao | monocratica — as 2 abas do portal', 'todos')
  .option('--origem <origem>', 'ambas (default) | turmas (Turma Recursal) | comum — Juizado x Justica Comum', 'ambas')
  .option('-oj, --orgao <orgaos>', 'Orgao(s) julgador(es), separados por virgula (use --listar-filtros)')
  .option('-c, --classe <value>', 'Especie de recurso — VALUE do combo (use --listar-filtros)')
  .option('--ementa <texto>', 'Texto no campo "Ementa/Indexacao" (so casa ACORDAO)')
  .option('-di, --data-inicio <date>', 'Data de JULGAMENTO inicial (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Data de JULGAMENTO final (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Data de PUBLICACAO inicial (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Data de PUBLICACAO final (DD/MM/YYYY)')
  .option('--listar-filtros', 'Lista os combos capturados no mapeamento e sai')
  .option('--verificar [amostra]', 'Audita N resultados baixando o PDF do inteiro teor (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--page-size <n>', 'Resultados por pagina (default 30; TETO 30 — acima disso a tabela volta VAZIA)', 30)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjrr.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF do inteiro teor (1 GET por documento)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjrr')
  .option('-v, --visible', 'Ignored (TJRR usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJRR usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const checker = new TJRRChecker({ log });
        const res = opts.datajud
          ? await checker.consultarDataJud(opts.numero)
          : await checker.consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const combos = require('../human-codegen/TJRR/01-jurisprudencia/combos-select.json');
        const filtros = require('../human-codegen/TJRR/01-jurisprudencia/filtros.json');
        const saida = { combos, filtros };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      if (!opts.query) throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta por processo)');

      log('='.repeat(60));
      log('TJRR Jurisprudencia Crawler (portal Juris/JSF, HTTP direto, sem browser)');
      log('ESCOPO: 2o grau + Turma Recursal. NAO ha 1o grau (sentencas) nesta base.');
      log('ATENCAO: so ACORDAO tem ementa — monocratica vem SEM ementa, so o PDF.');
      log('ATENCAO: a data final SOZINHA e ignorada em silencio; mande as duas pontas.');
      log('OK: ementa integra e PDF de inteiro teor publico, sem captcha em etapa nenhuma.');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Tipo: ${opts.tipo} | Origem: ${opts.origem}`);
      log(`Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'} | Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log('='.repeat(60));

      const crawler = new TJRRCrawler({
        timeout: 90000,
        log,
        porPagina: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        tipo: opts.tipo,
        origem: opts.origem,
        orgaos: opts.orgao ? String(opts.orgao).split(',').map((s) => s.trim()).filter(Boolean) : null,
        classe: opts.classe || null,
        ementa: opts.ementa || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
        dataInicioPublicacao: opts.dataPubInicio || null,
        dataFimPublicacao: opts.dataPubFim || null,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total no servidor: ${results.totalResults} (exato) | coletados: ${results.length}`);
      log(`Totais por aba: ${JSON.stringify(results.totaisPorAba)}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados pelo PDF do inteiro teor...`);
        verificacao = await new TJRRChecker({ log }).auditar(results, amostra);
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.amostra} confirmados`);
      }

      const resumo = {
        totalResults: results.totalResults,
        totaisPorAba: results.totaisPorAba,
        semEmenta: results.filter((r) => r.semEmenta).length,
        semInteiroTeor: results.filter((r) => r.semInteiroTeor).length,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let ok = 0; let fail = 0;
        for (const r of results) {
          if (r.inteiroTeorPdf && r.inteiroTeorPdf.length > 0) {
            fs.writeFileSync(path.join(outputDir, `${r.id}.pdf`), r.inteiroTeorPdf);
            ok++;
          } else fail++;
        }
        for (const r of results) delete r.inteiroTeorPdf;
        log(`\nGravacao concluida: ${ok} arquivo(s), ${fail} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: ok, failed: fail, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcepr')
  .description('Search TCE-PR (Tribunal de Contas do Estado do Parana) — portal ViaJuris, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Termo livre (ESPACO = E/AND. Operadores INGLESES: OR, NOT, "frase exata", *)')
  .option('-n, --numero <numero>', 'Consulta por numero de PROCESSO (<numero>/<ano>, ex. 393433/2026); dispensa -q')
  .option('--acordao <numero>', 'Consulta por numero de ACORDAO (<numero>/<ano>, ex. 1979/2026); dispensa -q')
  .option('--colegiado <c>', 'pleno | primeira-camara | segunda-camara (default: todos)')
  .option('--classificacao <c>', 'sumula | prejulgado | consulta-forca-normativa | consulta-sem-forca-normativa | uniformizacao-jurisprudencia | incidente-uniformizacao')
  .option('--ano-acordao <ano>', 'Ano do acordao (AAAA)')
  .option('--ano-processo <ano>', 'Ano do processo (AAAA)')
  .option('-r, --relator <nome>', 'Relator(a) — nome EXATO do combo (use --listar-filtros)')
  .option('-c, --classe <valor>', 'Classe processual — value do combo (use --listar-filtros)')
  .option('--municipio <id>', 'Municipio — id do combo, 399 municipios (use --listar-filtros)')
  .option('--interessado <texto>', 'Interessado (texto livre)')
  .option('--entidade <texto>', 'Entidade fiscalizada (texto livre)')
  .option('-di, --data-inicio <date>', 'Data da SESSAO inicial (DD/MM/YYYY) — mande as DUAS pontas')
  .option('-df, --data-fim <date>', 'Data da SESSAO final (DD/MM/YYYY) — mande as DUAS pontas')
  .option('--listar-filtros', 'Lista os combos capturados no mapeamento e sai')
  .option('--verificar [amostra]', 'Audita N resultados abrindo o permalink em requisicao limpa (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--page-size <n>', 'Resultados por pagina (default 20; a tela oferece ate 500 — acima disso a busca estoura)', 20)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcepr.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF do inteiro teor (1 GET por documento)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcepr')
  .option('-v, --visible', 'Ignored (TCE-PR usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-PR usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero || opts.acordao) {
        const checker = new TCEPRChecker({ log });
        const res = opts.acordao
          ? await checker.consultarAcordao(opts.acordao)
          : await checker.consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const combos = require('../human-codegen/TCEPR/01-viajuris/combos-select.json');
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos }) + '\n');
        else console.log(JSON.stringify(combos, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.classificacao && !opts.anoAcordao) {
        throw new Error('Informe -q "<termos>" (ou -n <numero>, ou um filtro como --classificacao/--ano-acordao)');
      }

      log('='.repeat(60));
      log('TCE-PR Jurisprudencia Crawler (portal ViaJuris, HTTP direto, sem browser)');
      log('ESCOPO: CONTROLE EXTERNO, nao Judiciario — contas, licitacoes, contratos,');
      log('        pessoal e consultas do Estado do PR e dos 399 municipios (PR nao tem TCM).');
      log('ATENCAO: SEM termo livre o card volta SEM inteiro teor (medido 0/50 x 50/50).');
      log('ATENCAO: os operadores sao os INGLESES (OR/NOT); "ou" e "nao" sao IGNORADOS');
      log('        e viram E (AND) — apesar de a tela anunciar "e ou nao".');
      log('OK: ementa, tema, inteiro teor, CITACAO OFICIAL e PERMALINK ja vem na busca, sem captcha.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'}`);
      log(`Colegiado: ${opts.colegiado || 'todos'} | Classificacao: ${opts.classificacao || 'todas'}`);
      log(`Sessao: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log('='.repeat(60));

      const crawler = new TCEPRCrawler({
        timeout: 180000,
        log,
        porPagina: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        colegiado: opts.colegiado || null,
        classificacao: opts.classificacao || null,
        anoAcordao: opts.anoAcordao || null,
        anoProcesso: opts.anoProcesso || null,
        relator: opts.relator || null,
        classe: opts.classe || null,
        municipio: opts.municipio || null,
        interessado: opts.interessado || null,
        entidade: opts.entidade || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total no servidor: ${results.totalResults} (exato) | coletados: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados pelo permalink publico...`);
        verificacao = await new TCEPRChecker({ log }).auditar(results, amostra);
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.amostra} confirmados`);
      }

      const resumo = {
        totalResults: results.totalResults,
        semInteiroTeor: results.filter((r) => r.semInteiroTeor).length,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let ok = 0; let fail = 0;
        for (const r of results) {
          if (r.inteiroTeorPdfBuffer && r.inteiroTeorPdfBuffer.length > 0) {
            fs.writeFileSync(path.join(outputDir, `${r.id}.pdf`), r.inteiroTeorPdfBuffer);
            ok++;
          } else fail++;
        }
        for (const r of results) delete r.inteiroTeorPdfBuffer;
        log(`\nGravacao concluida: ${ok} arquivo(s), ${fail} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: ok, failed: fail, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjrj-ejuris')
  .description('Search TJRJ eJURIS (modulo LEGADO: acervo historico desde 1995 + Turmas Recursais) — HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores PORTUGUESES: "frase", E, OU, NAO/NÃO, ADJ, PROX, $)')
  .option('-n, --numero <numero>', 'Consulta direta por numero (CNJ com/sem mascara ou numeracao antiga); dispensa -q')
  .option('--origem <origem>', 'comum (2a Inst, default) | turmas (Turma Recursal) | conselho | alcadacivel | alcadacriminal', 'comum')
  .option('--competencia <comp>', 'civel (default) | criminal — so particiona em --origem comum', 'civel')
  .option('-di, --data-inicio <ano>', 'Ano inicial (AAAA; aceita DD/MM/AAAA e reduz ao ano)')
  .option('-df, --data-fim <ano>', 'Ano final (AAAA; aceita DD/MM/AAAA e reduz ao ano)')
  .option('--escopo <escopo>', 'Onde procurar o termo: ementa (default) | acordao | monocratica | inteiroTeor | ementario | todos', 'ementa')
  .option('--ramo <ramo>', 'Ramo do direito (label ou trecho)')
  .option('--magistrado <nome>', 'Magistrado (label ou trecho; 805 opcoes)')
  .option('-oj, --orgao <nome>', 'Orgao julgador (label ou trecho; 78 opcoes)')
  .option('--listar-combos', 'Lista origens, ramos, magistrados e orgaos aceitos e sai')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (10 registros/pagina; 20 no escopo ementario)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjrj-ejuris.json')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor (PDF publico) de cada resultado')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjrj-ejuris')
  .option('-v, --visible', 'Ignored (eJURIS usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (eJURIS usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.listarCombos) {
        const listas = await new TJRJEjurisNavigator().listas();
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...listas }) + '\n');
        else {
          console.log('=== ORIGENS ==='); listas.origens.forEach(o => console.log(`  ${o.valor}  ${o.texto}`));
          console.log('=== RAMOS DO DIREITO ==='); listas.ramos.forEach(r => console.log(`  ${r.texto}`));
          console.log(`=== ORGAOS JULGADORES (${listas.orgaos.length}) ===`); listas.orgaos.forEach(o => console.log(`  ${o.texto}`));
          console.log(`=== MAGISTRADOS (${listas.magistrados.length}) ===`); listas.magistrados.forEach(m => console.log(`  ${m.texto}`));
        }
        process.exit(0);
      }

      if (opts.numero) {
        const res = await new TJRJEjurisChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      log('='.repeat(60));
      log('TJRJ eJURIS — modulo LEGADO (HTTP direto, sem browser)');
      log('ESCOPO: acervo historico da 2a Instancia (1995+) e Turmas Recursais.');
      log('A base nova (e-Proc, ~2023+) e outro comando: jur tjrj');
      log('='.repeat(60));

      const crawler = new TJRJEjurisCrawler({ timeout: 90000, log });
      const results = await crawler.search(opts.query, {
        origem: opts.origem,
        competencia: opts.competencia,
        anoInicio: opts.dataInicio || null,
        anoFim: opts.dataFim || null,
        escopo: opts.escopo,
        ramo: opts.ramo || null,
        magistrado: opts.magistrado || null,
        orgao: opts.orgao || null,
      }, { maxPages: parseInt(opts.maxPages, 10) });

      if (opts.fetchInteiroTeor) {
        const fs = require('fs');
        const path = require('path');
        fs.mkdirSync(opts.outputDir, { recursive: true });
        const nav = new TJRJEjurisNavigator();
        let ok = 0, falhas = 0;
        for (const r of results) {
          if (!r.arqGed) { falhas += 1; continue; }
          try {
            const pdf = await nav.baixarInteiroTeor(r.arqGed);
            const destino = path.join(opts.outputDir, `${r.id}.pdf`);
            fs.writeFileSync(destino, pdf);
            r.inteiroTeorArquivo = destino;
            ok += 1;
          } catch (e) {
            r.inteiroTeorErro = e.message;
            falhas += 1;
          }
        }
        log(`Inteiro teor: ${ok} PDFs baixados, ${falhas} falharam`);
      }

      let auditoria = null;
      if (opts.verificar) {
        const n = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        auditoria = await new TJRJEjurisChecker({ log }).verificarLote(results, n);
        log(`Auditoria: ${auditoria.confirmados}/${auditoria.amostra} confirmados`);
      }

      const fs = require('fs');
      const path = require('path');
      fs.mkdirSync(path.dirname(opts.output), { recursive: true });
      fs.writeFileSync(opts.output, JSON.stringify(results, null, 2));

      if (jsonMode) {
        process.stdout.write(JSON.stringify({
          success: true,
          count: results.length,
          total: crawler.total,
          avisos: crawler.avisos,
          auditoria,
          output: path.resolve(opts.output),
        }) + '\n');
      } else {
        log('='.repeat(60));
        log(`${results.length} documentos gravados em ${opts.output}`);
      }
    } catch (error) {
      if (opts.json) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcesc')
  .description('Search TCE-SC (Tribunal de Contas do Estado de Santa Catarina) — GraphQL publico, sem browser')
  .option('-q, --query <text>', 'Termo livre. ATENCAO: o ESPACO e OR (uniao) e NAO existe AND; so "frase exata" restringe')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (aceita "REP 26/00137305" ou "2600137305"); dispensa -q')
  .option('--base <b>', 'deliberacoes (default: Deliberacoes/Votos + Decisoes Singulares) | enunciados | informativos | sumulas')
  .option('--abrangencia <a>', 'inteiro-teor (default) | ementa')
  .option('--ordenacao <o>', 'relevancia (default) | recentes | antigos')
  .option('--singular <v>', 'so | sem — recorta as "Decisoes Singulares Ratificadas por Colegiado" (NAO particiona a base)')
  .option('-r, --relator <id>', 'Identificador do relator (use --listar-filtros)')
  .option('-t, --tipo-processo <id>', 'Identificador do tipo de processo (use --listar-filtros)')
  .option('-u, --unidade <id>', 'Identificador da unidade gestora')
  .option('--refinamento <texto>', 'Texto de refinamento dentro do resultado')
  .option('--eixo-data <e>', 'autuacao (default, unica completa) | sessao | publicacao', 'autuacao')
  .option('-di, --data-inicio <date>', 'Data inicial (DD/MM/YYYY ou YYYY-MM-DD)')
  .option('-df, --data-fim <date>', 'Data final (DD/MM/YYYY ou YYYY-MM-DD)')
  .option('--listar-filtros', 'Lista tipos de processo e relatores (direto do servidor) e sai')
  .option('--verificar [amostra]', 'Audita N resultados reabrindo o PDF publico em requisicao limpa (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--page-size <n>', 'Resultados por pagina (default 20)', 20)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcesc.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF publico do inteiro teor (1 GET por documento)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcesc')
  .option('-v, --visible', 'Ignored (TCE-SC usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-SC usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.numero) {
        const res = await new TCESCChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const TCESCNavigator = require('../src/TCESCNavigator');
        const combos = await new TCESCNavigator({ log }).combos();
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos }) + '\n');
        else console.log(JSON.stringify(combos, null, 2));
        process.exit(0);
      }

      // As tres bases que NAO estao no GraphQL (ver src/TCESCCojur.js).
      const baseCojur = ['enunciados', 'informativos', 'sumulas'].includes(opts.base);
      if (baseCojur) {
        const cojur = new TCESCCojur({ log });
        const porPagina = parseInt(opts.pageSize, 10);
        const maxPages = parseInt(opts.maxPages, 10);
        let itens = []; let total = 0; const extra = {};

        if (opts.base === 'sumulas') {
          const r = cojur.sumulas(opts.query || '');
          itens = r.resultados; total = r.total;
          extra.totalBase = r.totalBase; extra.distintas = r.distintas;
          log('ATENCAO: a base de SUMULAS do TCE-SC nao e uma consulta — sao 4 registros');
          log(`         embutidos no bundle do portal (${r.distintas} distintos; os ids 1 e 2 sao o mesmo`);
          log('         documento). Nao ha endpoint, e o arquivo envelhece com o deploy do site.');
        } else {
          for (let pg = 1; pg <= maxPages; pg++) {
            const r = opts.base === 'enunciados'
              ? await cojur.enunciados(opts.query || '', { page: pg, size: porPagina })
              : await cojur.informativos(opts.query || '', { page: pg, perPage: porPagina });
            if (pg === 1) { total = r.total; log(`Total no servidor: ${total}`); }
            if (!r.resultados.length) break;
            itens = itens.concat(r.resultados);
            log(`Pagina ${pg}: ${r.resultados.length} resultado(s) — acumulado ${itens.length}`);
            if (itens.length >= total || pg >= r.ultimaPagina) break;
          }
          if (opts.base === 'enunciados') {
            const revogados = itens.filter((x) => !x.vigente).length;
            if (revogados) log(`  [aviso] ${revogados} enunciado(s) com st_valido != S — NAO os cite como vigentes.`);
          }
        }

        log('='.repeat(60));
        log(`Base "${opts.base}": ${total} no servidor | coletados: ${itens.length}`);
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(itens, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: itens.length, output: outputPath, base: opts.base, totalResults: total, ...extra,
          }) + '\n');
        }
        process.exit(0);
      }

      if (!opts.query && !opts.relator && !opts.tipoProcesso && !opts.dataInicio) {
        throw new Error('Informe -q "<termos>" (ou -n <numero>, ou um filtro como -r/-t/-di)');
      }

      log('='.repeat(60));
      log('TCE-SC Jurisprudencia Crawler (GraphQL publico, sem browser)');
      log('ESCOPO: CONTROLE EXTERNO, nao Judiciario — contas, licitacao, contrato e');
      log('        pessoal do Estado de SC e dos municipios (SC NAO tem TCM).');
      log('ATENCAO: o ESPACO entre termos e OR (UNIAO) e NAO existe AND.');
      log('         Nenhum operador booleano funciona; so "frase exata" entre aspas.');
      log('ATENCAO: termo com menos de 3 caracteres e IGNORADO e devolve o ACERVO INTEIRO.');
      log('ATENCAO: a maioria dos documentos vem SEM ementa — o texto do card e o');
      log('         trecho onde o termo casou. Use --fetch-inteiro-teor para o PDF.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'}`);
      log(`Eixo de data: ${opts.eixoData} | ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log('='.repeat(60));

      const crawler = new TCESCCrawler({
        log,
        porPagina: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        abrangencia: opts.abrangencia || null,
        ordenacao: opts.ordenacao || null,
        relator: opts.relator || null,
        tipoProcesso: opts.tipoProcesso || null,
        unidadeGestora: opts.unidade || null,
        refinamento: opts.refinamento || null,
        eixoData: opts.eixoData || 'autuacao',
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
        ...(opts.singular === 'so' ? { decisaoSingular: true }
          : opts.singular === 'sem' ? { decisaoSingular: false } : {}),
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total no servidor: ${results.totalResults} (exato) | coletados: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} pelo PDF publico...`);
        verificacao = await new TCESCChecker({ log }).auditar(results, amostra);
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.amostra} confirmados`);
      }

      const resumo = {
        totalResults: results.totalResults,
        semEmenta: results.filter((r) => r.semEmenta).length,
        semInteiroTeor: results.filter((r) => r.semInteiroTeor).length,
        avisos: results.avisos,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let okC = 0; let failC = 0;
        for (const r of results) {
          if (r.inteiroTeorPdfBuffer && r.inteiroTeorPdfBuffer.length > 0) {
            fs.writeFileSync(path.join(outputDir, `${r.id}.pdf`), r.inteiroTeorPdfBuffer);
            okC++;
          } else failC++;
        }
        for (const r of results) delete r.inteiroTeorPdfBuffer;
        log(`\nGravacao concluida: ${okC} arquivo(s), ${failC} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: okC, failed: failC, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcers')
  .description('Search TCE-RS (Tribunal de Contas do Estado do Rio Grande do Sul) — API REST publica, sem browser')
  .option('-q, --query <text>', 'Termo livre. ATENCAO: o ESPACO e OR (uniao); use AND para exigir os dois termos')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (aceita "013714-0200/25-3" ou "137140200253"); dispensa -q')
  .option('--base <b>', 'decisoes (default) | sumulas | pareceres | informacoes', 'decisoes')
  .option('--ano <ano>', 'Filtra pelo ANO da sessao (filtro proprio da tela)')
  .option('-oj, --orgao-julgador <nome>', 'Orgao julgador exato (use --listar-filtros)')
  .option('-r, --relator <nome>', 'Nome do relator/Conselheiro (use --listar-filtros)')
  .option('-t, --tipo-processo <nome>', 'Tipo de processo exato (use --listar-filtros)')
  .option('--orgao <nome>', 'Orgao FISCALIZADO exato (ex.: "EXECUTIVO MUNICIPAL DE NOVO BARREIRO")')
  .option('-di, --data-inicio <date>', 'Data inicial da SESSAO (YYYY-MM-DD; formato BR derruba a API com 500)')
  .option('-df, --data-fim <date>', 'Data final da SESSAO (YYYY-MM-DD)')
  .option('-dpi, --data-pub-inicio <date>', 'Alias de -di: NAO existe data de publicacao nesta base')
  .option('-dpf, --data-pub-fim <date>', 'Alias de -df: NAO existe data de publicacao nesta base')
  .option('--listar-filtros', 'Lista tipos de processo, relatores e orgaos julgadores (direto do servidor) e sai')
  .option('--verificar [amostra]', 'Audita N resultados por reconsulta pelo numero (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--page-size <n>', 'Resultados por pagina (default 20; 500 aceito, 1000 recusado)', 20)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcers.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF da peca (o TEXTO ja vem na busca; isto grava o arquivo)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcers')
  .option('-v, --visible', 'Ignored (TCE-RS usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-RS usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.numero) {
        const res = await new TCERSChecker({ quiet: jsonMode }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const TCERSNavigator = require('../src/TCERSNavigator');
        const nav = new TCERSNavigator();
        const { LISTAS } = TCERSNavigator;
        const combos = {};
        for (const [chave, nome] of Object.entries(LISTAS)) combos[chave] = await nav.lista(nome);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos }) + '\n');
        else console.log(JSON.stringify(combos, null, 2));
        process.exit(0);
      }

      const dataInicio = opts.dataInicio || opts.dataPubInicio || null;
      const dataFim = opts.dataFim || opts.dataPubFim || null;
      if ((opts.dataPubInicio || opts.dataPubFim) && !(opts.dataInicio || opts.dataFim)) {
        log('[aviso] O TCE-RS NAO tem data de publicacao (o campo vem null em 100% da amostra).');
        log('        -dpi/-dpf foram tratados como data da SESSAO. Nunca apresente essa data como publicacao.');
      }

      if (!opts.query && !opts.relator && !opts.tipoProcesso && !opts.orgaoJulgador && !dataInicio && !opts.ano) {
        throw new Error('Informe -q "<termos>" (ou -n <numero>, ou um filtro como -r/-t/-oj/-di/--ano)');
      }

      log('='.repeat(60));
      log('TCE-RS Jurisprudencia Crawler (API REST publica, sem browser)');
      log('ESCOPO: CONTROLE EXTERNO, nao Judiciario — contas, licitacao, contrato e');
      log('        pessoal do Estado do RS e dos municipios (o RS NAO tem TCM).');
      log('ATENCAO: o ESPACO entre termos e OR (UNIAO). Os operadores que funcionam');
      log('         sao os INGLESES (AND, OR, NOT, "frase exata"). Os que a tela');
      log('         anuncia — E, OU, NAO, PROX, MESMO, $ — INFLAM ate o teto ou zeram.');
      log('ATENCAO: o total SATURA em 10.000, e o servidor declara isso em total.relacao.');
      log('ATENCAO: nao existe data de publicacao — o unico eixo e a data da SESSAO.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'} | base: ${opts.base}`);
      log(`Data da sessao: ${dataInicio || '-'} a ${dataFim || '-'}${opts.ano ? ` | ano: ${opts.ano}` : ''}`);
      log('='.repeat(60));

      const crawler = new TCERSCrawler({
        quiet: jsonMode,
        base: opts.base,
        porPagina: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        ano: opts.ano || null,
        orgaoJulgador: opts.orgaoJulgador || null,
        relator: opts.relator || null,
        tipoProcesso: opts.tipoProcesso || null,
        orgao: opts.orgao || null,
        dataInicio,
        dataFim,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(
        `Total no servidor: ${results.totalResults}${results.totalSaturado ? '+ (SATURADO)' : ' (exato)'} | coletados: ${results.length}`,
      );

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} por reconsulta pelo numero...`);
        verificacao = await new TCERSChecker({ quiet: jsonMode }).auditar(results, amostra);
      }

      const resumo = {
        totalResults: results.totalResults,
        totalSaturado: results.totalSaturado,
        semEmenta: results.filter((r) => r.semEmenta).length,
        dispositivoDegenerado: results.filter((r) => r.dispositivoDegenerado).length,
        avisos: results.avisos,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let okC = 0;
        let failC = 0;
        for (const r of results) {
          if (r.inteiroTeorPdfBuffer && r.inteiroTeorPdfBuffer.length > 0) {
            fs.writeFileSync(path.join(outputDir, `${r.id}.pdf`), r.inteiroTeorPdfBuffer);
            okC++;
          } else failC++;
        }
        for (const r of results) delete r.inteiroTeorPdfBuffer;
        log(`\nGravacao concluida: ${okC} arquivo(s), ${failC} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(
            JSON.stringify({ success: true, count: results.length, downloaded: okC, failed: failC, outputDir, ...resumo }) + '\n',
          );
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, count: results.length, output: outputPath, ...resumo }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcesp')
  .description('Search TCE-SP (Tribunal de Contas do Estado de Sao Paulo) — HTTP direto, sem browser')
  .option('-q, --query <text>', 'Termos que devem TODOS aparecer (caixa "Todas estas Palavras" = AND)')
  .option('--frase <texto>', 'Expressao ou frase EXATA (caixa 2)')
  .option('--qualquer <texto>', 'Qualquer uma dessas palavras (caixa 3 = OU). NAO use "OU" dentro de -q')
  .option('--excluir <texto>', 'Nenhuma destas palavras (caixa 4 = NAO). NAO use "NAO" dentro de -q')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (aceita "1681/989/20" ou "168198920"); dispensa -q')
  .option('-t, --tipo <tipos>', 'Tipo(s) de documento, separados por virgula: acordao, sumula, parecer, despacho, relatorio-voto...')
  .option('--escopo <e>', 'Onde buscar o texto: documento (default), partes, objeto — separados por virgula', 'documento')
  .option('-r, --relator <nome>', 'Nome do Conselheiro relator (use --listar-filtros)')
  .option('--auditor <nome>', 'Nome do Auditor (use --listar-filtros). NAO provado por contagem')
  .option('--materia <nome>', 'Materia exata (164 opcoes; use --listar-filtros)')
  .option('--exercicio <anos>', 'Exercicio, ex.: "2015,2016,2017"')
  .option('-dpi, --data-pub-inicio <date>', 'Data inicial de PUBLICACAO (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Data final de PUBLICACAO (DD/MM/YYYY)')
  .option('-di, --data-inicio <date>', 'Data inicial de AUTUACAO (DD/MM/YYYY) — eixo distinto da publicacao')
  .option('-df, --data-fim <date>', 'Data final de AUTUACAO (DD/MM/YYYY)')
  .option('--num-ini <n>', 'Faixa "Numeros que variam" — inicio (ex.: 2010)')
  .option('--num-fim <n>', 'Faixa "Numeros que variam" — fim (ex.: 2017)')
  .option('--trechos <n>', 'Quantidade de trechos por documento, 0..6 (0 devolve NENHUM texto)', 3)
  .option('--detalhes', 'Faz 1 GET por processo para trazer RELATOR e data de publicacao (a busca nao tem)')
  .option('--listar-filtros', 'Lista tipos de documento, relatores, auditores e materias e sai')
  .option('--verificar [amostra]', 'Audita N resultados por reconsulta pelo numero (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (pagina FIXA em 10 documentos)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcesp.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF do inteiro teor (1 GET por documento; o texto NAO vem na busca)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcesp')
  .option('-v, --visible', 'Ignored (TCE-SP usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-SP usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.numero) {
        const res = await new TCESPChecker({ quiet: jsonMode }).porNumero(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const combos = require('../human-codegen/TCESP/01-jurisprudencia/combos.json');
        const saida = {
          tipoDocumento: Object.entries(require('../src/TCESPNavigator').TIPOS_DOCUMENTO).map(
            ([k, v]) => `${k} (${v.rotulo})`,
          ),
          relator: combos.relator.map((o) => o.value),
          auditor: combos.auditor.map((o) => o.value),
          materia: combos.materia.map((o) => o.value),
        };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      const temFiltro =
        opts.query || opts.frase || opts.qualquer || opts.relator || opts.materia ||
        opts.tipo || opts.dataPubInicio || opts.dataInicio || opts.exercicio;
      if (!temFiltro) {
        throw new Error('Informe -q "<termos>" (ou -n <numero>, ou um filtro como -t/-r/--materia/-dpi)');
      }

      log('='.repeat(60));
      log('TCE-SP Jurisprudencia Crawler (HTTP direto, sem browser, sem captcha)');
      log('ESCOPO: CONTROLE EXTERNO, nao Judiciario — contas, licitacao, contrato e');
      log('        pessoal do Estado de SP e dos 644 municipios paulistas.');
      log('🔴 A CAPITAL NAO ESTA NESTA BASE: Sao Paulo capital e do TCM-SP, orgao');
      log('   separado que este repo nao cobre. Contas da Prefeitura de SP nao tem');
      log('   resposta aqui, e o numero baixo NAO e ausencia de julgado.');
      log('ATENCAO: o modelo de operadores e de QUATRO CAIXAS, nao inline. Dentro de');
      log('         -q, "OU" e DESCARTADO e a busca continua AND (voce pede uniao e');
      log('         recebe intersecao). Use --qualquer para OU e --excluir para NAO.');
      log('ATENCAO: nao existe EMENTA no TCE-SP — o texto e um TRECHO com highlight.');
      log('ATENCAO: um julgado decide varios processos; o total conta pares');
      log('         processo x documento (fator medido ~2,9x). Veja totalDeduplicadoEstimado.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'}`);
      log(`Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'} | Autuacao: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log('='.repeat(60));

      const crawler = new TCESPCrawler({
        quiet: jsonMode,
        quantTrechos: parseInt(opts.trechos, 10),
        includeFullText: !!opts.fetchInteiroTeor,
        outputDir: opts.outputDir,
      });

      const filters = {
        frase: opts.frase || '',
        qualquer: opts.qualquer || '',
        excluir: opts.excluir || '',
        numIni: opts.numIni || '',
        numFim: opts.numFim || '',
        escopos: String(opts.escopo).split(',').map((s) => s.trim()).filter(Boolean),
        tipoDocumento: opts.tipo ? String(opts.tipo).split(',').map((s) => s.trim()) : null,
        relator: opts.relator || null,
        auditor: opts.auditor || null,
        materia: opts.materia || null,
        exercicio: opts.exercicio || '',
        dataPubInicio: opts.dataPubInicio || null,
        dataPubFim: opts.dataPubFim || null,
        dataAutuacaoInicio: opts.dataInicio || null,
        dataAutuacaoFim: opts.dataFim || null,
      };

      const res = await crawler.search(opts.query || '', filters, { maxPages: parseInt(opts.maxPages, 10) });
      if (opts.detalhes) {
        log('\nCompletando relator e data de publicacao pelo detalhe do processo...');
        await crawler.completarDetalhes(res.resultados);
      }

      log('='.repeat(60));
      log(`Total no servidor: ${res.total} (exato) | documentos distintos coletados: ${res.resultados.length}`);
      log(`Estimativa deduplicada do acervo: ${res.totalDeduplicadoEstimado}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} por reconsulta pelo numero...`);
        verificacao = await new TCESPChecker({ quiet: jsonMode }).verificar(res.resultados, amostra);
      }

      const resumo = {
        totalResults: res.total,
        totalDeduplicadoEstimado: res.totalDeduplicadoEstimado,
        totalSaturado: false,
        semEmenta: res.resultados.length,
        semInteiroTeor: res.resultados.filter((r) => r.semInteiroTeor).length,
        urlBusca: res.urlBusca,
        avisos: res.avisos,
        ...(verificacao ? { verificacao } : {}),
      };

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(res.resultados, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);
      if (opts.fetchInteiroTeor) log(`Files saved to: ${path.resolve(opts.outputDir)}`);
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: true, count: res.resultados.length, output: outputPath, ...resumo }) + '\n',
        );
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcerj')
  .description('Search TCE-RJ (Tribunal de Contas do Estado do Rio de Janeiro) — API REST, sem browser')
  .option('-q, --query <text>', 'Termos de busca. ACENTO E OBRIGATORIO (o indice nao normaliza)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (aceita "103.885-0/2026" ou "10388502026"); dispensa -q')
  .option('--macro-tema <id>', 'Macro-tema: 1=Auditoria, 2=Contas, 3=Licitacoes e Contratos, 7=Direito Processual... (--listar-filtros)')
  .option('--tema <id>', 'Tema (subordinado ao macro-tema)')
  .option('--conselheiro <nome>', 'Nome do Conselheiro. ATENCAO: o campo "relator" da API e IGNORADO — use este')
  .option('-r, --relator <nome>', 'Alias de --conselheiro (avisa: o campo relator da API nao filtra)')
  .option('-di, --data-inicio <date>', 'Data inicial do VOTO (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Data final do VOTO (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Alias de -di (NAO existe data de publicacao nesta base)')
  .option('-dpf, --data-pub-fim <date>', 'Alias de -df (NAO existe data de publicacao nesta base)')
  .option('--listar-filtros', 'Lista macro-temas e conselheiros e sai')
  .option('--verificar [amostra]', 'Audita N resultados baixando o PDF do acordao (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--page-size <n>', 'Resultados por pagina (sem teto medido; 1089 traz o acervo inteiro)', 20)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcerj.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF publico do acordao (1 GET por documento)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcerj')
  .option('-v, --visible', 'Ignored (TCE-RJ usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-RJ usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.numero) {
        const res = await new TCERJChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const nav = new (require('../src/TCERJNavigator'))({ log });
        const saida = { macroTemas: await nav.macroTemas(), conselheiros: await nav.relatores() };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.macroTema && !opts.tema && !opts.conselheiro && !opts.dataInicio && !opts.dataPubInicio) {
        throw new Error('Informe -q "<termos>" (ou -n <numero>, ou um filtro como --macro-tema/--conselheiro/-di)');
      }

      log('='.repeat(60));
      log('TCE-RJ Jurisprudencia Crawler (API REST, sem browser, sem captcha)');
      log('ESCOPO: CONTROLE EXTERNO, nao Judiciario — contas, licitacao, contrato e');
      log('        pessoal do Estado do RJ e dos municipios fluminenses.');
      log('🔴 A CAPITAL NAO ESTA NESTA BASE: o Municipio do Rio de Janeiro e do');
      log('   TCM-RJ, orgao separado que este repo nao cobre (confirmado por medicao:');
      log('   o combo traz 91 municipios dos 92 do estado, e falta a capital).');
      log('🔴 BASE CURADA E PEQUENA: 1.089 documentos selecionados pelo Servico de');
      log('   Jurisprudencia. NAO e o acervo de decisoes do TCE-RJ.');
      log('ATENCAO: ACENTO E OBRIGATORIO ("licitacao" = 0 x "licitação" = 267).');
      log('ATENCAO: "NAO"/"NÃO" nao exclui — vira palavra e DEFLACIONA. "AND"/"OR"');
      log('         derrubam a busca com HTTP 500. Use E e OU.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'}`);
      log(`Voto: ${opts.dataInicio || opts.dataPubInicio || '-'} a ${opts.dataFim || opts.dataPubFim || '-'}`);
      log('='.repeat(60));

      const crawler = new TCERJCrawler({
        log,
        porPagina: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });

      const filters = {
        macroTema: opts.macroTema || null,
        tema: opts.tema || null,
        conselheiro: opts.conselheiro || null,
        relator: opts.relator || null,
        dataInicio: opts.dataInicio || opts.dataPubInicio || null,
        dataFim: opts.dataFim || opts.dataPubFim || null,
      };
      if ((opts.dataPubInicio || opts.dataPubFim) && !opts.dataInicio && !opts.dataFim) {
        log('  [aviso] -dpi/-dpf sao alias de -di/-df: NAO existe data de publicacao nesta base, so a data do VOTO.');
      }

      const res = await crawler.search(opts.query || '', filters, { maxPages: parseInt(opts.maxPages, 10) });

      log('='.repeat(60));
      log(`Total no servidor: ${res.totalResults} (exato) | coletados: ${res.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} baixando o PDF do acordao...`);
        verificacao = await new TCERJChecker({ log }).verificar(res, amostra);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      if (opts.fetchInteiroTeor) {
        const dir = path.resolve(opts.outputDir);
        fs.mkdirSync(dir, { recursive: true });
        for (const r of res) {
          if (r.inteiroTeorPdfBuffer) {
            fs.writeFileSync(path.join(dir, `acordao-${String(r.numeroAcordao).replace('/', '-')}.pdf`), r.inteiroTeorPdfBuffer);
            delete r.inteiroTeorPdfBuffer;
          }
        }
        log(`Files saved to: ${dir}`);
      }
      fs.writeFileSync(outputPath, JSON.stringify(res, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({
            success: true,
            count: res.length,
            output: outputPath,
            totalResults: res.totalResults,
            totalSaturado: false,
            semEmenta: res.filter((r) => r.semEmenta).length,
            semInteiroTeor: res.filter((r) => r.semInteiroTeor).length,
            avisos: res.avisos,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n',
        );
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tceba')
  .description('Search TCE-BA (Tribunal de Contas do Estado da Bahia) — API REST, sem browser')
  .option('-q, --query <text>', 'Termo de busca. ATENCAO: e FRASE LITERAL, nao ha operador booleano')
  .option('-n, --numero <numero>', 'Consulta por numero ("TCE/000405/2025"); dispensa -q')
  .option('--colegiado <id>', 'Colegiado: 1=1a Camara, 2=2a Camara, 3=Plenario')
  .option('-t, --tipo <sigla>', 'Tipo de decisao: ACRDO, DMNCR, VOTO, R1CMR, R2CMR (--listar-filtros)')
  .option('--natureza <id>', 'Natureza do processo (--listar-filtros)')
  .option('-r, --relator <id>', 'ID do Conselheiro relator (--listar-filtros). Sao apenas 7')
  .option('--ano-decisao <ano>', 'Ano da decisao (2001-2026)')
  .option('--ano-processo <ano>', 'Ano do processo')
  .option('--ano-exercicio <ano>', 'Exercicio')
  .option('-di, --data-inicio <date>', 'NAO existe filtro de data no TCE-BA; so ANO. Ver aviso')
  .option('-df, --data-fim <date>', 'NAO existe filtro de data no TCE-BA; so ANO. Ver aviso')
  .option('-dpi, --data-pub-inicio <date>', 'NAO existe data de publicacao nesta base')
  .option('-dpf, --data-pub-fim <date>', 'NAO existe data de publicacao nesta base')
  .option('--qt-registros <n>', 'Limiar de recusa do servidor (o portal usa 200)', String(TCEBACrawler.QT_DEFAULT))
  .option('--listar-filtros', 'Lista conselheiros, colegiados e naturezas e sai')
  .option('--verificar [amostra]', 'Audita N resultados baixando o PDF publico (default 3)')
  .option('-m, --max-pages <number>', 'Ignorado (a API do TCE-BA nao pagina)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tceba.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF publico (o TEXTO ja vem na busca)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tceba')
  .option('-v, --visible', 'Ignored (TCE-BA usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-BA usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.numero) {
        const res = await new TCEBAChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const nav = new (require('../src/TCEBANavigator'))({ log });
        const saida = {
          conselheiros: await nav.conselheiros(),
          colegiados: await nav.colegiados(),
          naturezas: await nav.naturezas(),
        };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.colegiado && !opts.tipo && !opts.natureza && !opts.relator && !opts.anoDecisao) {
        throw new Error('Informe -q "<termo>" (ou -n <numero>, ou um filtro como --colegiado/--tipo/-r)');
      }

      // 🔴 NAO EXISTE filtro de data no TCE-BA — so combos de ANO. As flags de data
      // sao aceitas para nao quebrar a convencao do repo, mas NAO podem ser aplicadas
      // em silencio: quando as duas pontas caem no mesmo ano civil, viram --ano-decisao
      // (e o crawler diz isso); quando nao cabem, o recorte NAO acontece e o aviso
      // precisa chegar ao usuario. Filtro ignorado calado e a falha nº 1 do repo.
      const avisosData = [];
      const anoDe = (d) => (String(d || '').match(/\/(\d{4})$/) || [])[1] || null;
      const di = opts.dataInicio || opts.dataPubInicio;
      const df = opts.dataFim || opts.dataPubFim;
      if (opts.dataPubInicio || opts.dataPubFim) {
        avisosData.push(
          'NAO EXISTE data de publicacao no TCE-BA, nem como campo do documento: o unico ' +
            'eixo e a data da SESSAO, e ela nao e filtravel. Nunca apresente a data do ' +
            'TCE-BA como publicacao.',
        );
      }
      if (di || df) {
        const a1 = anoDe(di);
        const a2 = anoDe(df);
        if (a1 && a2 && a1 === a2 && !opts.anoDecisao) {
          opts.anoDecisao = a1;
          avisosData.push(
            `NAO existe filtro de data no TCE-BA, so combos de ANO. As duas pontas caem ` +
              `em ${a1}, entao o recorte virou --ano-decisao ${a1} — o intervalo DENTRO ` +
              `do ano NAO foi aplicado.`,
          );
        } else {
          avisosData.push(
            'NAO existe filtro de data no TCE-BA, so combos de ANO (2001-2026), e o ' +
              'intervalo pedido nao cabe num ano civil: O RECORTE DE DATA NAO FOI ' +
              'APLICADO. Use --ano-decisao. A contagem abaixo e SEM recorte temporal.',
          );
        }
      }
      for (const a of avisosData) log(`  [aviso] ${a}`);

      log('='.repeat(60));
      log('TCE-BA — Consulta de Jurisprudencia (controle externo)');
      log('  [escopo] SO O ESTADO: todos os municipios baianos sao do TCM-BA,');
      log('           orgao separado que este repo NAO cobre.');
      log('  [aviso] NAO ha operador booleano, e o espaco NAO e conectivo: o termo e');
      log('          casado como FRASE LITERAL contigua. "nepotismo sumula" da 0, mas');
      log('          "de nepotismo" da 4 — o zero NAO e ausencia de jurisprudencia.');
      log('          Para cruzar dois conceitos, rode duas buscas. Aspas dao HTTP 500;');
      log('          o curinga e * (nepotism* = nepotismo), nunca $.');
      log('  [aviso] A maior parte do acervo vem SEM EMENTA; o que ha e o texto integral.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'}`);
      log('='.repeat(60));

      const crawler = new TCEBACrawler({ log });
      const res = await crawler.buscar({
        query: opts.query,
        idColegiado: opts.colegiado,
        tipo: opts.tipo,
        idNatureza: opts.natureza,
        idRelator: opts.relator,
        anoDecisao: opts.anoDecisao,
        anoProtocolo: opts.anoProcesso,
        anoExercicio: opts.anoExercicio,
        qtRegistros: parseInt(opts.qtRegistros, 10),
        fetchInteiroTeor: !!opts.fetchInteiroTeor,
        outputDir: opts.outputDir,
      });

      log('='.repeat(60));
      log(`Total: ${res.total} documentos (${res.totalExato ? 'exato' : 'INCOMPLETO — ver avisos'})`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} baixando o PDF publico...`);
        verificacao = await new TCEBAChecker({ log }).verificar(res.resultados, amostra);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(res.resultados, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({
            success: true,
            count: res.total,
            output: outputPath,
            totalExato: res.totalExato,
            fatiadoPorAno: res.fatiadoPorAno,
            semEmenta: res.resultados.filter((r) => r.semEmenta).length,
            avisos: [...avisosData, ...res.avisos],
            ...(verificacao ? { verificacao } : {}),
          }) + '\n',
        );
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

