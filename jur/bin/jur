      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjpr')
  .description('Search TJPR (Tribunal de Justica do Parana) jurisprudence')
  .requiredOption('-q, --query <text>', 'Search query (supports operators: E, OU, !NAO, PROX, $)')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-l, --local <scope>', 'Search scope: 1=EMENTA, 2=INTEIRO TEOR, 99=AMBAS', '2')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'results-tjpr.json')
  .option('--fetch-inteiro-teor', 'Download full text of each result (visits each processo page)')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados-tjpr')
  .option('-v, --visible', 'Show browser window (disable headless mode)')
  .option('--headed', 'Alias for --visible: show browser window for debugging')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    const scopeNames = { '1': 'EMENTA', '2': 'INTEIRO TEOR', '99': 'AMBAS' };

    log('='.repeat(60));
    log('TJPR Jurisprudencia Crawler');
    log('='.repeat(60));
    log(`Query: ${opts.query}`);
    log(`Data Julgamento Inicio: ${opts.dataInicio || 'not set'}`);
    log(`Data Julgamento Fim: ${opts.dataFim || 'not set'}`);
    log(`Local Pesquisa: ${scopeNames[opts.local] || opts.local}`);
    log(`Max Pages: ${opts.maxPages}`);
    log(`Fetch Inteiro Teor: ${!!opts.fetchInteiroTeor}`);
    log(`Output: ${opts.fetchInteiroTeor ? opts.outputDir : opts.output}`);
    log(`Headless: ${!(opts.visible || opts.headed)}`);
    log('='.repeat(60));

    const headless = !(opts.visible || opts.headed);
    const crawler = new TJPRCrawler({
      headless,
      slowMo: headless ? 0 : 100,
      timeout: 60000,
    });

    try {
      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        localPesquisa: opts.local || '2',
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading inteiro teor for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });

        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(
            JSON.stringify({
              success: true,
              count: results.length,
              downloaded: successCount,
              failed: failCount,
              outputDir,
            }) + '\n'
          );
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(
            JSON.stringify({ success: true, count: results.length, output: outputPath }) + '\n'
          );
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjpa')
  .description('Search TJPA (Tribunal de Justica do Para) jurisprudence')
  .option('-q, --query <text>', 'Search query (operadores nativos: OU, E, NAO, "expressao exata")')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ ou numero do acordao/decisao')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('-r, --relator <names>', 'Relator name(s), comma-separated (exact names from /filtros)')
  .option('-oj, --orgao <orgao>', 'Orgao Julgador Colegiado (ex: "1ª Câmara Cível Isolada")')
  .option('-c, --classe <classe>', 'Case class')
  .option('-a, --assunto <assunto>', 'Subject')
  .option('--origem <origem>', 'Origin: tjpa (default), turmas, ambas', 'tjpa')
  .option('-t, --tipo <tipo>', 'Document type: acordao, monocratica, ambos', 'ambos')
  .option('--escopo <escopo>', 'Search scope: ementa (default) or inteiroTeor', 'ementa')
  .option('--tipo-consulta <tc>', 'Query type: free (Formato Livre, default) or anywords (Qualquer Palavra)', 'free')
  .option('-ord, --ordenacao <tipo>', 'Sort: relevancia (default), recentes, antigos', 'relevancia')
  .option('--full-text', 'Include inteiro teor text in the JSON results')
  .option('--fetch-inteiro-teor', 'Download full text of each result as .txt files')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados-tjpa')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'results-tjpa.json')
  .option('-v, --visible', 'Ignored (TJPA uses direct API, no browser)')
  .option('--headed', 'Ignored (TJPA uses direct API, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modo consulta direta por numero (TJPAChecker)
      if (opts.numero) {
        const checker = new TJPAChecker();
        const digits = opts.numero.replace(/\D/g, '');
        const res = digits.length >= 14
          ? await checker.consultarProcesso(opts.numero)
          : await checker.consultarDocumento(opts.numero);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" para pesquisa livre ou -n <numero> para consulta direta');
      }

      log('='.repeat(60));
      log('TJPA Jurisprudencia Crawler (API direta)');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Origem: ${opts.origem} | Tipo: ${opts.tipo} | Escopo: ${opts.escopo}`);
      log(`Relator: ${opts.relator || '-'} | Orgao: ${opts.orgao || '-'}`);
      log(`Max Pages: ${opts.maxPages} | Ordenacao: ${opts.ordenacao}`);
      log('='.repeat(60));

      const crawler = new TJPACrawler({
        timeout: 60000,
        includeFullText: !!opts.fullText,
        log,
      });

      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        origem: opts.origem,
        tipo: opts.tipo,
        escopo: opts.escopo,
        tipoConsulta: opts.tipoConsulta,
        ordenacao: opts.ordenacao,
        classe: opts.classe || null,
        assunto: opts.assunto || null,
        relatores: opts.relator ? opts.relator.split(',').map(r => r.trim()) : null,
        orgaoJulgadorColegiado: opts.orgao || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      if (jsonMode) {
        // silencia logs internos do crawler em modo JSON
        const origLog = console.log;
        console.log = () => {};
        var results = await crawler.search(opts.query, filters, searchOptions);
        console.log = origLog;
      } else {
        var results = await crawler.search(opts.query, filters, searchOptions);
      }

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJPAChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading inteiro teor for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjgo')
  .description('Search TJGO (Tribunal de Justica de Goias) jurisprudence — Novo Modulo PROJUDI')
  .option('-q, --query <text>', 'Search query (aspas duplas = frase exata; palavras soltas = E implicito)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ (TJGOChecker)')
  .option('-i, --instancia <inst>', 'Instancia: todas (default), 1grau, turmas, tribunal', 'todas')
  .option('-a, --area <area>', 'Area: todas (default), civel, criminal', 'todas')
  .option('-om, --orgao-materia <nome>', 'Orgao/Materia (nome ou codigo; use --listar-orgaos)')
  .option('-u, --unidade <nome>', 'Unidade especifica (serventia; resolvida pela lupa)')
  .option('-mag, --magistrado <nome>', 'Magistrado(a) (resolvido pela lupa)')
  .option('-ta, --tipo-ato <nome>', 'Tipo de Ato: Acordao, Ementa, Sentenca, Decisao, Decisao Monocratica, ...')
  .option('-p, --processo <numero>', 'Filtro por numero do processo (dentro da busca)')
  .option('-di, --data-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--listar-orgaos', 'Lista as opcoes do combo Orgao/Materia e sai')
  .option('--listar-tipos-ato', 'Lista os Tipos de Ato disponiveis e sai')
  .option('--unidades <termo>', 'Consulta a lupa de serventias por termo e sai')
  .option('--magistrados <termo>', 'Consulta a lupa de magistrados por termo e sai')
  .option('--full-text', 'Include full decision text in the JSON results')
  .option('--fetch-inteiro-teor', 'Save full text of each result as .txt files (sem novo acesso a rede)')
  .option('--output-dir <dir>', 'Directory for saved full-text files', './resultados-tjgo')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (50 results/page)', 10)
  .option('--qtde <n>', 'Results per page: 10, 20 or 50', '50')
  .option('-o, --output <file>', 'Output JSON file', 'results-tjgo.json')
  .option('-v, --visible', 'Ignored (TJGO uses direct HTTP, no browser)')
  .option('--headed', 'Ignored (TJGO uses direct HTTP, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modos utilitarios de listagem (lupas / combo embutido)
      if (opts.listarOrgaos) {
        const lista = TJGONavigator.ORGAOS_MATERIA;
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, orgaosMateria: lista }) + '\n');
        else console.table(lista.map(o => ({ codigo: o.codigo, descricao: o.descricao, area: o.areaId, instancia: o.servTipoId })));
        process.exit(0);
      }
      if (opts.listarTiposAto) {
        const lista = TJGONavigator.TIPOS_ATO;
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, tiposAto: lista }) + '\n');
        else console.table(lista);
        process.exit(0);
      }
      if (opts.unidades !== undefined || opts.magistrados !== undefined) {
        const navigator = new TJGONavigator();
        const res = opts.unidades !== undefined
          ? await navigator.consultarServentias(opts.unidades)
          : await navigator.consultarMagistrados(opts.magistrados);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else {
          console.log(`Total na base: ${res.total} (mostrando ${res.itens.length})`);
          console.table(res.itens);
        }
        process.exit(0);
      }

      // Modo consulta direta por numero (TJGOChecker)
      if (opts.numero) {
        const checker = new TJGOChecker();
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.magistrado && !opts.unidade) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -p/-mag/-u)');
      }

      log('='.repeat(60));
      log('TJGO Jurisprudencia Crawler (HTTP direto, Novo Modulo PROJUDI)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Instancia: ${opts.instancia} | Area: ${opts.area} | Orgao/Materia: ${opts.orgaoMateria || '-'}`);
      log(`Unidade: ${opts.unidade || '-'} | Magistrado: ${opts.magistrado || '-'} | Tipo de Ato: ${opts.tipoAto || '-'}`);
      log(`Processo: ${opts.processo || '-'}`);
      log(`Data Publicacao: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Max Pages: ${opts.maxPages} (${opts.qtde}/pagina)`);
      log('='.repeat(60));

      const crawler = new TJGOCrawler({
        timeout: 60000,
        pageSize: parseInt(opts.qtde, 10),
        includeFullText: !!opts.fullText || !!opts.fetchInteiroTeor,
        log,
      });

      const filters = {
        instancia: opts.instancia,
        area: opts.area,
        orgaoMateria: opts.orgaoMateria || null,
        serventia: opts.unidade || null,
        magistrado: opts.magistrado || null,
        tipoAto: opts.tipoAto || null,
        processo: opts.processo || null,
        dataPublicacaoInicio: opts.dataInicio || null,
        dataPublicacaoFim: opts.dataFim || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      if (jsonMode) {
        const origLog = console.log;
        console.log = () => {};
        var results = await crawler.search(opts.query, filters, searchOptions);
        console.log = origLog;
      } else {
        var results = await crawler.search(opts.query, filters, searchOptions);
      }

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJGOChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nSaving full text for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nSave complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjsp')
  .description('Search TJSP (Tribunal de Justica de Sao Paulo) jurisprudence')
  .requiredOption('-q, --query <text>', 'Search query (supports operators: E, OU, NAO, "")')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--2grau', 'Include 2° grau (default: true)')
  .option('--no-2grau', 'Exclude 2° grau')
  .option('--recursal', 'Include Colégios Recursais (default: true)')
  .option('--no-recursal', 'Exclude Colégios Recursais')
  .option('--acordaos', 'Include Acórdãos (default: true)')
  .option('--no-acordaos', 'Exclude Acórdãos')
  .option('--homologacoes', 'Include Homologações de Acordo')
  .option('--decisoes-mono', 'Include Decisões Monocráticas')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'results-tjsp.json')
  .option('-v, --visible', 'Show browser window (disable headless mode)')
  .option('--headed', 'Alias for --visible: show browser window for debugging')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    log('='.repeat(60));
    log('TJSP Jurisprudencia Crawler');
    log('='.repeat(60));
    log(`Query: ${opts.query}`);
    log(`Data Julgamento Inicio: ${opts.dataInicio || 'not set'}`);
    log(`Data Julgamento Fim: ${opts.dataFim || 'not set'}`);
    log(`Data Publicacao Inicio: ${opts.dataPubInicio || 'not set'}`);
    log(`Data Publicacao Fim: ${opts.dataPubFim || 'not set'}`);
    log(`Origem 2° grau: ${opts['2grau'] !== false}`);
    log(`Origem Recursal: ${opts.recursal !== false}`);
    log(`Max Pages: ${opts.maxPages}`);
    log(`Output: ${opts.output}`);
    log(`Headless: ${!(opts.visible || opts.headed)}`);
    log('='.repeat(60));

    const headless = !(opts.visible || opts.headed);
    const crawler = new TJSPCrawler({
      headless,
      slowMo: headless ? 0 : 100,
      timeout: 60000,
    });

    try {
      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        origem2grau: opts['2grau'] !== false,
        origemRecursal: opts.recursal !== false,
        tipoAcordao: opts.acordaos !== false,
        tipoHomologacao: opts.homologacoes || false,
        tipoDecisaoMono: opts.decisoesMono || false,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      const outputPath = path.resolve(opts.output);
      fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: true, count: results.length, output: outputPath }) + '\n'
        );
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program.parse();
