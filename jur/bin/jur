  .option('--ano <ano>', 'Ano da decisao (filtro proprio, independente de -di/-df)')
  .option('-r, --relator <nome>', 'Relator (--listar-filtros; o combo da tela so mostra os 10 maiores)')
  .option('--numero-documento <n>', 'Numero do DOCUMENTO (ex.: 4760), nao do processo')
  .option('--sessao-tipo <tipo>', 'ORDINÁRIA | EXTRAORDINÁRIA | ORDINÁRIA VIRTUAL | ADMINISTRATIVA')
  .option('--tematica <valor>', 'Classificacao tematica (--listar-filtros)')
  .option('--paradigmatica <valor>', '"Em sede de consulta" | "Estudos Especiais"')
  .option('--emissor <valor>', 'Federal | Distrital (emissor da legislacao citada)')
  .option('--assunto <valor>', 'FILTRO QUEBRADO no servidor (sempre zero) — vira aviso, nao e enviado')
  .option('--normativo <valor>', 'FILTRO QUEBRADO no servidor (sempre zero) — vira aviso, nao e enviado')
  .option('-di, --data-inicio <date>', 'Data da SESSAO de julgamento inicial (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Data da SESSAO de julgamento final (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'NAO medido: o recorte por data e por SESSAO, nao por publicacao')
  .option('-dpf, --data-pub-fim <date>', 'NAO medido: o recorte por data e por SESSAO, nao por publicacao')
  .option('--size <n>', 'Documentos por pagina (o teto do proxy e em BYTES, nao em documentos)', String(TCDFCrawler.SIZE_DEFAULT))
  .option('--listar-filtros', 'Lista as agregacoes (relatores, anos, tematicas, situacoes) e sai')
  .option('--verificar [amostra]', 'Audita N julgados por reconsulta do e-doc (default 3)')
  .option('-m, --max-pages <number>', 'Numero de paginas', 1)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcdf.json')
  .option('--fetch-inteiro-teor', 'Grava o texto em disco (ele JA vem na busca — nao ha segundo salto)')
  .option('--fetch-documento', 'Busca tambem o ato formatado no e-TCDF (devolve MENOS texto que a busca)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcdf')
  .option('-v, --visible', 'Ignored (TCDF usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCDF usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.numero) {
        const res = await new TCDFChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrados > 0 ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const nav = new (require('../src/TCDFNavigator'))({ log });
        const aggs = await nav.agregacoes();
        const saida = {};
        for (const [k, v] of Object.entries(aggs)) {
          saida[k] = {
            buckets: (v.buckets || []).map((b) => ({ valor: b.key, documentos: b.doc_count })),
            foraDaLista: v.sum_other_doc_count ?? 0,
          };
        }
        saida['⚠️ leia'] =
          'Ano e Relator vem TRUNCADOS em 10 buckets — `foraDaLista` diz quantos documentos ' +
          'ficaram de fora. O combo da tela NAO e o dominio: filtrar por um relator ausente ' +
          'da lista funciona.';
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.ano && !opts.relator && !opts.numeroDocumento
          && !opts.sessaoTipo && !opts.tematica && !opts.dataInicio && !opts.selecionada) {
        throw new Error('Informe -q "<termo>" (ou -n <numero>, ou um filtro como --ano/--relator/--selecionada)');
      }

      const avisosData = [];
      if (opts.dataPubInicio || opts.dataPubFim) {
        avisosData.push(
          'O recorte temporal medido e por `sessao_data` (data da SESSAO de julgamento). ' +
            'Existe `jurisprudencia_data_publicacao` no documento, mas filtrar POR ela NAO foi ' +
            'medido — as flags -dpi/-dpf foram tratadas como -di/-df. Nao apresente o recorte ' +
            'como se fosse por publicacao.',
        );
      }

      log('='.repeat(60));
      log('TCDF — Busca de Jurisprudencia (controle externo, Bloco 5)');
      log('  [escopo] O DF e ente unico: NAO ha TCM nem combo de municipio. A ressalva');
      log('           "onde existe TCM o TCE nao cobre os municipios" nao tem par aqui.');
      log('  [aviso] "E" e "OU" em portugues NAO sao operadores, e o erro AMPLIA:');
      log('          "nepotismo E licitação" = 8.034 contra 6.773 do OR real. Use AND/OR/NOT.');
      log('  [aviso] O total vem SATURADO em 10.000 quando a busca e larga. O acervo de');
      log('          inteiro teor e 18.370 documentos (soma das agregacoes).');
      log('  [aviso] "Jurisprudencia Selecionada" e SUBCONJUNTO (2.430 de 18.370), nao');
      log('          outra base: e o mesmo endpoint com situacao=Publicada.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros)'}`);
      log('='.repeat(60));

      const crawler = new TCDFCrawler({ log });
      const res = await crawler.buscar({
        query: opts.query,
        selecionada: !!opts.selecionada,
        situacao: opts.situacao,
        ano: opts.ano,
        relator: opts.relator,
        numero: opts.numeroDocumento,
        sessaoTipo: opts.sessaoTipo,
        classificacaoTematica: opts.tematica,
        paradigmatica: opts.paradigmatica,
        emissor: opts.emissor,
        assunto: opts.assunto,
        normativo: opts.normativo,
        dataInicio: opts.dataInicio || opts.dataPubInicio,
        dataFim: opts.dataFim || opts.dataPubFim,
        size: opts.size,
        maxPages: opts.maxPages,
      });

      log('='.repeat(60));
      log(
        `Total: ${res.total} documentos ${res.totalExato ? '(exato)' : '(SATURADO — o acervo real e 18.370)'}` +
          ` — ${res.retornados} baixados em ${res.paginas} pagina(s)`,
      );

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} por reconsulta do e-doc...`);
        verificacao = await new TCDFChecker({ log }).verificar(res.resultados, amostra);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(res.resultados, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (opts.fetchInteiroTeor || opts.fetchDocumento) {
        const dir = path.resolve(opts.outputDir);
        fs.mkdirSync(dir, { recursive: true });
        const nav = new (require('../src/TCDFNavigator'))({ log });
        let n = 0;
        let docs = 0;
        for (const r of res.resultados) {
          const base = `${(r.numeroDocumento || 'sem-numero').replace(/[^\w.-]/g, '_')}_${r.id}`;
          if (opts.fetchInteiroTeor && r.inteiroTeor) {
            fs.writeFileSync(path.join(dir, base + '.txt'), r.inteiroTeor, 'utf-8');
            n++;
          }
          if (opts.fetchDocumento && r.id) {
            const d = await nav.documento(r.id);
            if (d) { fs.writeFileSync(path.join(dir, base + '.etcdf.json'), JSON.stringify(d, null, 2), 'utf-8'); docs++; }
            else log(`   [e-TCDF] ${r.id}: HTTP 404`);
          }
        }
        log(`Inteiro teor gravado: ${n} arquivo(s)${opts.fetchDocumento ? ` e ${docs} ato(s) do e-TCDF` : ''} em ${dir}`);
        if (opts.fetchInteiroTeor) log('   (o TEXTO ja vinha na busca — nao houve segundo salto para ele)');
        if (opts.fetchDocumento) {
          log('   ⚠️ o ato do e-TCDF tem MENOS texto que a busca (1.742 contra 4.405 chars');
          log('      medidos no e-doc B0AB532D). Ele nao e o inteiro teor — esse e o PDF,');
          log('      e o caminho do CAS ate o PDF NAO foi fechado.');
        }
      }

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({
            success: true,
            count: res.total,
            retornados: res.retornados,
            output: outputPath,
            totalExato: res.totalExato,
            acervoTotalConhecido: res.acervoTotalConhecido,
            avisos: [...avisosData, ...res.avisos],
            ...(verificacao ? { verificacao } : {}),
          }) + '\n',
        );
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcemg')
  .description('Search TCE-MG (Tribunal de Contas do Estado de Minas Gerais) — MapJuris, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Termo. Conectores: E / OU / NÃO (acentuado), "frase exata", curinga %')
  .option('-n, --numero <numero>', 'Consulta por nº do processo do TCE-MG (6-8 digitos, ex.: 1188139); dispensa -q e datas')
  .option('-r, --relator <codigo>', 'CODIGO do relator (--listar-filtros). O NOME sozinho nao filtra')
  .option('--natureza <codigo>', 'Codigo numerico da natureza (--listar-filtros). Na pratica a base toda e 17 (CONSULTA)')
  .option('--tipo-pesquisa <t>', 'IndexExcerto (default) | EXCERTO | INDEXACAO — INDEXACAO e subconjunto', 'IndexExcerto')
  .option('-di, --data-inicio <date>', 'Data da SESSAO inicial (DD/MM/YYYY). Sem ela o crawler fatia por ano')
  .option('-df, --data-fim <date>', 'Data da SESSAO final (DD/MM/YYYY)')
  .option('-m, --max-pages <number>', 'Numero de FATIAS DE ANO percorridas quando nao ha -di/-df', 3)
  .option('--teses <termo>', 'Busca separada de Teses/Sumulas (_ListarTituloResenha) e sai')
  .option('--listar-filtros', 'Lista os combos (relatores, naturezas) com os codigos e sai')
  .option('--verificar [amostra]', 'Audita N julgados por reconsulta do numero (default 3)')
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcemg.json')
  .option('--fetch-inteiro-teor', 'Grava o texto em disco (ele JA vem na busca — nao ha segundo salto para texto)')
  .option('--fetch-pdf', 'Baixa tambem o PDF do excerto (exige sessao; o href do card e quebrado)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcemg')
  .option('-v, --visible', 'Ignored (TCE-MG usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-MG usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      if (opts.listarFiltros) {
        const nav = new (require('../src/TCEMGNavigator'))({ log });
        const c = await nav.combos();
        const saida = {};
        for (const [k, v] of Object.entries(c)) {
          saida[k] = Array.isArray(v)
            ? v.filter((o) => o.Value !== '').map((o) => ({ codigo: o.Value, nome: o.Text }))
            : v;
        }
        saida['⚠️ leia'] =
          'O que filtra e o CODIGO. Mandar so o nome do relator devolve o total sem filtro ' +
          '(medido). E natureza nao-numerica e IGNORADA em silencio pelo servidor.';
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      if (opts.teses) {
        const nav = new (require('../src/TCEMGNavigator'))({ log });
        const r = await nav.tituloResenha(opts.teses);
        const out = {
          tribunal: 'TCE-MG',
          busca: 'Teses/Sumulas (_ListarTituloResenha)',
          termo: opts.teses,
          status: r.status,
          bytes: r.bytes,
          vazio: r.vazio,
          ressalva:
            'Busca SEPARADA da de excertos: so aceita termo (sem data, sem relator) e devolve ' +
            'outro grid (ConsultarInformacaoResenha). O contrato foi medido; o parser de ' +
            'resenha NAO foi escrito — use isto para saber se ha tese sobre o tema, nao para citar.',
        };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...out }) + '\n');
        else console.log(JSON.stringify(out, null, 2));
        process.exit(r.vazio ? 1 : 0);
      }

      if (opts.numero) {
        const res = await new TCEMGChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrados > 0 ? 0 : 1);
      }

      if (!opts.query && !opts.dataInicio && !opts.relator && !opts.natureza) {
        throw new Error(
          'Informe -q "<termo>" (ou -n <numero>, ou -di/-df, ou --relator). Busca sem termo ' +
            'E sem janela de data nao responde nem em 240 s — nao e bloqueio, e custo.',
        );
      }

      log('='.repeat(60));
      log('TCE-MG — MapJuris, Textual/Dados do Processo (controle externo, Bloco 5)');
      log('  [escopo] 🔴 A base e de EXCERTOS DE CONSULTA, nao do acervo inteiro do TCE-MG:');
      log('           natureza=17 (CONSULTA) devolve o mesmo total do sem-filtro, em 2013 e');
      log('           em 2025. Contas julgadas, denuncias e representacoes NAO estao aqui.');
      log('  [escopo] ✅ MG nao tem TCM, e as consultas municipais estao mesmo no TCE — as');
      log('           ementas trazem MUNICIPIO, CAMARA MUNICIPAL, PREFEITURA. Medido no acervo.');
      log('  [porta]  O portal rotulado "Jurisprudencia" (TCJuris) esta atras de reCAPTCHA v2');
      log('           conferido no servidor. Esta e a porta ABERTA, do mesmo tribunal.');
      log('  [aviso]  Conectores: E / OU / NÃO acentuado, "frase", curinga %. Espaco NAO une');
      log('           termos ("licitação pregão" = 0) e "NAO" sem til ZERA.');
      log('  [aviso]  🔴 O operador NÃO PERDE RESULTADO: "licitação NÃO pregão" = 6 quando a');
      log('           diferenca real e 14. Restringe demais, em silencio.');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo — so filtros/janela)'}`);
      log('='.repeat(60));

      // Uma sessao para tudo: busca, --verificar e --fetch-*. Ver o 429 no Navigator.
      const nav = new (require('../src/TCEMGNavigator'))({ log });
      const crawler = new TCEMGCrawler({ log, nav });
      const res = await crawler.buscar({
        query: opts.query,
        tipoPesquisa: opts.tipoPesquisa,
        codRelator: opts.relator,
        natureza: opts.natureza,
        dataInicio: opts.dataInicio,
        dataFim: opts.dataFim,
        maxPages: opts.maxPages,
      });

      log('='.repeat(60));
      log(
        `Total: ${res.total} documento(s) (exato)` +
          (res.totalEhSomaDeFatias ? ' — SOMA das fatias de ano percorridas, nao o acervo' : '') +
          ` — ${res.retornados} baixados em ${(res.duracaoMs / 1000).toFixed(1)} s`,
      );

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} por reconsulta do numero...`);
        verificacao = await new TCEMGChecker({ log, nav }).verificar(res.resultados, amostra);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(res.resultados, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (opts.fetchInteiroTeor || opts.fetchPdf) {
        const dir = path.resolve(opts.outputDir);
        fs.mkdirSync(dir, { recursive: true });
        let n = 0;
        let pdfs = 0;
        for (const r of res.resultados) {
          const base = String(r.id || 'sem-id').replace(/[^\w.-]/g, '_');
          if (opts.fetchInteiroTeor && r.inteiroTeor) {
            fs.writeFileSync(path.join(dir, base + '.txt'), r.inteiroTeor, 'utf-8');
            n++;
          }
          if (opts.fetchPdf && r.id) {
            const p = await nav.pdf(r.id);
            if (p.ok) {
              fs.writeFileSync(path.join(dir, base + '.pdf'), p.buffer);
              pdfs++;
            } else {
              log(`   [pdf] ${r.id}: HTTP ${p.status} (${p.contentType})`);
            }
          }
        }
        log(`Inteiro teor gravado: ${n} arquivo(s)${opts.fetchPdf ? ` e ${pdfs} PDF(s)` : ''} em ${dir}`);
        if (opts.fetchInteiroTeor) log('   (o TEXTO ja vinha na busca — nao houve segundo salto para ele)');
      }

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({
            success: true,
            count: res.total,
            retornados: res.retornados,
            output: outputPath,
            totalExato: res.totalExato,
            totalEhSomaDeFatias: res.totalEhSomaDeFatias,
            fatias: res.fatias,
            avisos: res.avisos,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n',
        );
      }
    } catch (error) {
      if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
      else console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tcees')
  .description('Search TCE-ES (Tribunal de Contas do Estado do Espirito Santo) — Pesquisa de Jurisprudencia (excertos), HTTP direto, sem browser')
  .option('-q, --query <text>', 'Termo livre. ESPACO = E (AND). NAO existe operador booleano: E/OU/NAO/AND/OR/NOT viram termo e RESTRINGEM. Sem curinga (* e descartado, $ zera). Indice normaliza acento e faz stemming')
  .option('--frase <text>', 'Frase exata (campo proprio BuscaExata) — aspas em -q NAO fazem isso')
  .option('--excluir <text>', 'Excluir termo (campo proprio BuscaExcetuacao) — a aritmetica fecha exata')
  .option('--enunciado', 'Restringe a busca ao ENUNCIADO do excerto')
  .option('-n, --numero <numero>', 'Procura excertos de um processo NNNNN/AAAA (ex. 01522/2026). NAO e CNJ')
  .option('--area <id>', 'Filtro Area (id da faceta — use --listar-filtros)')
  .option('--tema <id>', 'Filtro Tema (id da faceta)')
  .option('--subtema <id>', 'Filtro Subtema (id da faceta)')
  .option('--tipo-deliberacao <id>', 'Filtro Tipo de deliberacao (id da faceta)')
  .option('--colegiado <id>', 'Filtro Colegiado: 1 Plenario | 2 1a Camara | 3 2a Camara')
  .option('--norma <id>', 'Filtro Norma (id da faceta)')
  .option('--palavra-chave <id>', 'Filtro Palavra-chave (id da faceta)')
  .option('--atividade <id>', 'Filtro Atividade (id da faceta)')
  .option('--natureza <id>', 'Filtro Natureza (id da faceta)')
  .option('--especie <id>', 'Filtro Especie (id da faceta)')
  .option('--subespecie <id>', 'Filtro Subespecie (id da faceta)')
  .option('--classificacao <id>', 'Filtro Classificacao do processo (id da faceta; aceita multi-valor com virgula)')
  .option('-r, --relator <nome>', 'Relator — NOME exato da faceta (o campo e NomeRelator, nao id)')
  .option('-di, --data-inicio <date>', 'Data inicial (DD/MM/YYYY) — e a data da DELIBERACAO, apesar de o campo se chamar CriacaoData')
  .option('-df, --data-fim <date>', 'Data final (DD/MM/YYYY)')
  .option('--ordem <o>', 'relevancia (default) | data', 'relevancia')
  .option('--agrupar', 'Agrupa excertos da mesma deliberacao (muda os cards, NAO muda o total)')
  .option('--listar-filtros', 'Lista as 14 facetas com contador e sai')
  .option('--verificar [amostra]', 'Audita N excertos abrindo a pagina de detalhe (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (25 excertos por pagina, fixo no servidor)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcees.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF da deliberacao (1 GET por excerto; chave composta idDocumento+key)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcees')
  .option('-v, --visible', 'Ignored (TCE-ES usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-ES usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      const navOpts = { log };

      if (opts.numero) {
        const res = await new TCEESChecker({ ...navOpts, maxPages: parseInt(opts.maxPages, 10) || 40 })
          .porNumero(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const nav = new (require('../src/TCEESNavigator'))(navOpts);
        const facetas = TCEESCrawler.facetas(await nav.buscar({}));
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, facetas }) + '\n');
        else console.log(JSON.stringify(facetas, null, 2));
        process.exit(0);
      }

      log('='.repeat(60));
      log('TCE-ES Jurisprudencia Crawler (Pesquisa de Excertos, HTTP direto, sem browser)');
      log('ESCOPO: CONTROLE EXTERNO, nao Judiciario. O ES NAO tem TCM — as contas');
      log('        MUNICIPAIS estao nesta base (medido no acervo: Prefeitura de Serra,');
      log('        Camara Municipal de Vitoria, Prefeitura de Vitoria).');
      log('ATENCAO: esta base sao 9.730 EXCERTOS CURADOS pelo Nucleo de Jurisprudencia');
      log('        e Sumula (NJS) — NAO e o acervo de deliberacoes do TCE-ES. O');
      log('        "enunciado" e redacao do NJS e NAO e resumo oficial da decisao.');
      log('ATENCAO: NAO ha operador booleano — E/OU/NAO/AND/OR/NOT viram termo e');
      log('        RESTRINGEM em silencio. Use --frase e --excluir.');
      log('OK: total EXATO, paginacao estavel, permalink publico e PDF sem captcha.');
      log('='.repeat(60));

      const crawler = new TCEESCrawler({
        ...navOpts,
        includeFullText: !!opts.fetchInteiroTeor,
        agrupar: !!opts.agrupar,
      });
      const filters = {
        frase: opts.frase || null,
        excluir: opts.excluir || null,
        enunciado: !!opts.enunciado,
        area: opts.area || null,
        tema: opts.tema || null,
        subtema: opts.subtema || null,
        tipoDeliberacao: opts.tipoDeliberacao || null,
        colegiado: opts.colegiado || null,
        norma: opts.norma || null,
        palavraChave: opts.palavraChave || null,
        atividade: opts.atividade || null,
        natureza: opts.natureza || null,
        especie: opts.especie || null,
        subespecie: opts.subespecie || null,
        classificacao: opts.classificacao || null,
        relator: opts.relator || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
      };
      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
        ordem: opts.ordem,
        agrupar: !!opts.agrupar,
      });

      log('='.repeat(60));
      log(`Total no servidor: ${results.totalResults} excertos (exato) | coletados: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} excertos na pagina de detalhe...`);
        verificacao = await new TCEESChecker({ ...navOpts, crawler }).verificar(results, amostra);
      }

      const semEnunciado = results.filter((r) => !r.enunciado).length;
      const resumo = {
        totalResults: results.totalResults,
        semEnunciado,
        avisoBase: 'Base CURADA de excertos (9.730), nao o acervo de deliberacoes do TCE-ES. O enunciado e redacao do NJS, nao ementa oficial.',
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let ok = 0; let fail = 0;
        for (const r of results) {
          if (r.inteiroTeorPdfBuffer && r.inteiroTeorPdfBuffer.length > 0) {
            fs.writeFileSync(path.join(outputDir, `excerto-${r.id}-doc-${r.idDocumento}.pdf`), r.inteiroTeorPdfBuffer);
            ok++;
          } else fail++;
        }
        for (const r of results) delete r.inteiroTeorPdfBuffer;
        log(`\nGravacao concluida: ${ok} arquivo(s), ${fail} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: ok, failed: fail, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error(`Erro: ${error.message}`);
      process.exit(1);
    }
  });

program
  .command('tcepa')
  .description('Search TCE-PA (Tribunal de Contas do Estado do Para) — Pesquisa Integrada, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Termo livre. ESPACO = E. Operadores MEDIDOS: && (E), -termo (excluir), "frase", *, ?. NAO use || (devolve o acervo inteiro)')
  .option('-n, --numero <numero>', 'Consulta por numero de ACORDAO (ex. 24768); dispensa -q')
  .option('-b, --base <base>', 'Base de dados: acordaos | acordaos-plenario-virtual | prejulgados | informativos-jurisprudencia | resolucoes | atos | portarias-tcepa', 'acordaos')
  .option('-r, --relator <nome>', 'Relator(a) — nome EXATO do combo (use --listar-filtros)')
  .option('--decisao <texto>', 'Decisao — valor EXATO do combo (use --listar-filtros)')
  .option('--classe <texto>', 'Classe/subclasse — valor EXATO do combo (use --listar-filtros)')
  .option('--unidade <texto>', 'Unidade jurisdicionada (texto)')
  .option('--interessado <texto>', 'Interessado (texto)')
  .option('--exercicio <ano>', 'Exercicio (AAAA)')
  .option('--ano-sessao <ano>', 'Ano da sessao plenaria (AAAA)')
  .option('--ementa <texto>', 'Busca restrita ao campo EMENTA')
  .option('-di, --data-inicio <date>', 'Data inicial (DD/MM/YYYY) — vira faixa Lucene; uma ponta so tambem vale')
  .option('-df, --data-fim <date>', 'Data final (DD/MM/YYYY)')
  .option('--campo-data <c>', 'sessao (default) | publicacao', 'sessao')
  .option('--ordem <o>', 'relevancia | titulo | data-sessao-plenaria | numeroacordao | data-publicacao-doe | data-conteudo', 'relevancia')
  .option('--asc', 'Ordem crescente (default: decrescente)')
  .option('--listar-filtros', 'Lista os combos capturados no mapeamento e sai')
  .option('--verificar [amostra]', 'Audita N resultados abrindo o permalink em requisicao limpa (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (25 resultados por pagina)', 10)
  .option('--page-size <n>', 'Resultados por pagina (TETO MEDIDO: 25; acima disso e silenciosamente limitado)', 25)
  .option('--pausa <ms>', 'Pausa entre requisicoes (WAF F5 pune rajada)', 2000)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tcepa.json')
  .option('--fetch-inteiro-teor', 'Baixa o PDF do inteiro teor (1 GET por documento)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tcepa')
  .option('-v, --visible', 'Ignored (TCE-PA usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TCE-PA usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    try {
      const navOpts = { log, pausaMs: parseInt(opts.pausa, 10) };

      if (opts.numero) {
        const res = await new TCEPAChecker(navOpts).consultarAcordao(opts.numero, opts.base);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const dir = '../human-codegen/TCEPA/01-pesquisa-integrada/';
        const combos = {
          bases: require('../src/TCEPANavigator').BASES_JURIDICAS,
          relatores: require(dir + 'avancada-relatores.json'),
          decisoes: require(dir + 'avancada-decisoes.json'),
          classesSubclasses: require(dir + 'avancada-classes-subclasses.json'),
          exercicios: require(dir + 'avancada-exercicios.json'),
          anoSessaoPlenaria: require(dir + 'avancada-ano-sessao-plenaria.json'),
        };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combos }) + '\n');
        else console.log(JSON.stringify(combos, null, 2));
        process.exit(0);
      }

      log('='.repeat(60));
      log('TCE-PA Jurisprudencia Crawler (Pesquisa Integrada, HTTP direto, sem browser)');
      log('ESCOPO: CONTROLE EXTERNO, nao Judiciario — contas, licitacoes, contratos,');
      log('        pessoal e consultas do ESTADO do Para. Os MUNICIPIOS paraenses sao');
      log('        do TCM-PA e NAO estao aqui (a tela nao tem filtro de municipio).');
      log('ATENCAO: o operador || NAO faz uniao — devolve o acervo inteiro. Use && e -.');
      log('ATENCAO: as contagens das facetas da tela IGNORAM o termo buscado (sao globais).');
      log('ATENCAO: WAF F5 devolve CAPTCHA com HTTP 200 se apressar; cooldown ~7 min.');
      log('OK: a EMENTA INTEIRA e o PERMALINK ja vem na busca; o PDF e publico, sem captcha.');
      log('='.repeat(60));

      const crawler = new TCEPACrawler({
        ...navOpts,
        base: opts.base,
        porPagina: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        relator: opts.relator || null,
        decisao: opts.decisao || null,
        classe: opts.classe || null,
        unidade: opts.unidade || null,
        interessado: opts.interessado || null,
        exercicio: opts.exercicio || null,
        anoSessao: opts.anoSessao || null,
        ementa: opts.ementa || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
        campoData: opts.campoData,
      };
      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
        base: opts.base,
        ordem: opts.ordem,
        reversa: !opts.asc,
      });

      log('='.repeat(60));
      log(`Total no servidor: ${results.totalResults} (exato) | coletados: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados pelo permalink publico...`);
        verificacao = await new TCEPAChecker(navOpts).auditar(results, amostra);
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.amostra} confirmados`);
      }

      const resumo = {
        totalResults: results.totalResults,
        query: crawler.ultimaBusca ? crawler.ultimaBusca.q : null,
        listasTruncadas: results.filter((r) => r.listaTruncada).length,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let ok = 0; let fail = 0;
        for (const r of results) {
          if (r.inteiroTeorPdfBuffer && r.inteiroTeorPdfBuffer.length > 0) {
            fs.writeFileSync(path.join(outputDir, `${r.base}-${r.identificador}.pdf`), r.inteiroTeorPdfBuffer);
            ok++;
          } else fail++;
        }
        for (const r of results) delete r.inteiroTeorPdfBuffer;
        log(`\nGravacao concluida: ${ok} arquivo(s), ${fail} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: ok, failed: fail, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });


program.parse();
