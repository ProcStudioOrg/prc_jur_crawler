  .option('-df, --data-fim <date>', 'Data de JULGAMENTO final (DD/MM/YYYY) — use JUNTO com -di')
  .option('-dpi, --data-pub-inicio <date>', 'Alias de -di — o TJPB NAO tem data de publicacao')
  .option('-dpf, --data-pub-fim <date>', 'Alias de -df — o TJPB NAO tem data de publicacao')
  .option('--instancia <inst>', 'todas (default) | comum (2º grau) | turmas (Juizado) | primeiro (1º grau)', 'todas')
  .option('--grau <grau>', 'todos (default) | 1 | 2 — so vale SEM filtro avancado (vira recorte de cliente)', 'todos')
  .option('-t, --tipo <tipo>', 'todos (default) | acordao | sentenca | monocratica — recorte no cliente', 'todos')
  .option('--apenas-ementa', 'Procura o termo so na ementa (medido: 12.208 -> 10.961)')
  .option('--comarca <id>', 'Id de comarca (use --listar-filtros comarcas <termo>)')
  .option('--classe <id>', 'Id de classe processual')
  .option('--orgao <id>', 'Id de orgao julgador')
  .option('--vara <id>', 'Id de vara')
  .option('--competencia <id>', 'Id de competencia')
  .option('--relator <id>', 'Id de relator (id, NAO nome)')
  .option('--listar-filtros <combo> <termo>', 'Autocomplete de um combo (comarcas, classes, relatores, varas, orgaos-julgadores, competencias, processos)')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('--page-size <number>', 'Registros por pagina (max 50)', 20)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjpb.json')
  .option('--fetch-inteiro-teor', 'Grava o inteiro teor (ja vem na busca — sem request extra)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjpb')
  .option('-v, --visible', 'Ignored (TJPB usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJPB usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJPBChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        // `--listar-filtros comarcas joao` — o combo e AUTOCOMPLETE, exige termo.
        const combo = opts.listarFiltros;
        const termo = program.args.filter((a) => a !== 'tjpb').pop();
        const out = await new TJPBNavigator({ log }).opcoes(combo, termo);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, combo, termo, opcoes: out }) + '\n');
        else console.log(JSON.stringify(out, null, 2));
        process.exit(0);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      const di = opts.dataInicio || opts.dataPubInicio || null;
      const df = opts.dataFim || opts.dataPubFim || null;
      if (opts.dataPubInicio || opts.dataPubFim) {
        log('AVISO: o TJPB NAO tem data de publicacao (`meioPublicacao` null em 200/200). ' +
            '-dpi/-dpf foram tratados como JULGAMENTO.');
      }

      log('='.repeat(60));
      log('TJPB Jurisprudencia Crawler (API REST publica, HTTP direto, sem browser)');
      log('ESCOPO: 1º grau (78% da base) + 2º grau + Turmas Recursais.');
      log('ATENCAO: acento e OBRIGATORIO na query — o indice NAO normaliza.');
      log('ATENCAO: so ACORDAO de 2º grau comum tem ementa.');
      log('ATENCAO: NAO EXISTE PERMALINK. Verificacao e por reconsulta (-n).');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data julgamento: ${di || '-'} a ${df || '-'}`);
      log(`Instancia: ${opts.instancia} | Grau: ${opts.grau} | Tipo: ${opts.tipo}`);
      log(`Max Pages: ${opts.maxPages} | Page Size: ${opts.pageSize}`);
      log('='.repeat(60));

      const crawler = new TJPBCrawler({
        timeout: 120000,
        log,
        pageSize: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        dataInicio: di,
        dataFim: df,
        instancia: opts.instancia,
        grau: opts.grau,
        tipo: opts.tipo,
        apenasEmenta: !!opts.apenasEmenta,
        comarca: opts.comarca,
        classe: opts.classe,
        orgao: opts.orgao,
        vara: opts.vara,
        competencia: opts.competencia,
