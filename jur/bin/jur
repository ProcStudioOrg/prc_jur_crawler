program
  .command('tjpr')
  .description('Search TJPR (Tribunal de Justica do Parana) jurisprudence — HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores: E, OU, !NAO, PROXn, $)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (TJPRChecker); dispensa -q')
  .option('--acordao <numero>', 'Consulta direta por numero do acordao')
  .option('--foro <foro>', 'DESAMBIGUACAO: comum (default) | juizados | todos', 'comum')
  .option('--base <base>', 'Combo BASE DE CONSULTA do site: todas (default), turmas, tj, vice, cidh', 'todas')
  .option('-oj, --orgao <nome>', 'Orgao julgador especifico (nome ou id; use --listar-orgaos)')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--escopo <escopo>', 'Onde buscar o termo: ementa (default), inteiroTeor, ambas', 'ementa')
  .option('-l, --local <scope>', '[legado] 1=EMENTA, 2=INTEIRO TEOR, 99=AMBAS')
  .option('-t, --tipo <tipo>', 'Tipo de decisao: todas (default), acordao, monocratica, duvida', 'todas')
  .option('-p, --processo <numero>', 'Filtro por numero de processo DENTRO da busca (use -n p/ consulta direta)')
  .option('-ord, --ordem <ordem>', 'recentes (default) | antigos', 'recentes')
  .option('--listar-orgaos', 'Lista os orgaos julgadores mapeados (com foro) e sai')
  .option('--listar-orgaos-ao-vivo', 'Reconstroi a lista de orgaos pela faceta do site e sai')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (50 registros/pagina)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjpr.json')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor de cada resultado como .txt')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjpr')
  .option('-v, --visible', 'Ignored (TJPR usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJPR usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.listarOrgaos || opts.listarOrgaosAoVivo) {
        const lista = opts.listarOrgaosAoVivo
          ? (await new TJPRNavigator().listarOrgaosAoVivo())
            .map(o => ({ ...o, foro: TJPRNavigator.foro(o.nome) }))
          : TJPRNavigator.orgaos();
        const filtrada = opts.foro && opts.foro !== 'todos'
          ? lista.filter(o => TJPRNavigator.foro(o.nome) === opts.foro) : lista;
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, total: filtrada.length, orgaos: filtrada }) + '\n');
        else console.table(filtrada);
        process.exit(0);
      }

      if (opts.numero || opts.acordao) {
        const checker = new TJPRChecker();
        const res = opts.numero
          ? await checker.consultarProcesso(opts.numero)
          : await checker.consultarAcordao(opts.acordao);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.orgao) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      // -l legado (1/2/99) ainda funciona e vence --escopo quando informado
      const escopoLegado = { 1: 'ementa', 2: 'inteiroTeor', 99: 'ambas' }[opts.local];

      log('='.repeat(60));
      log('TJPR Jurisprudencia Crawler (HTTP direto, sem browser)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`FORO: ${opts.orgao ? `orgao especifico (${opts.orgao})` : opts.foro}   | Base de consulta: ${opts.base}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Escopo: ${escopoLegado || opts.escopo} | Tipo: ${opts.tipo} | Ordem: ${opts.ordem}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJPRCrawler({ timeout: 90000, log });
      const filters = {
        foro: opts.foro,
        base: opts.base,
        orgao: opts.orgao || null,
        escopo: escopoLegado || opts.escopo,
        tipo: opts.tipo,
        ordem: opts.ordem,
        processo: opts.processo || null,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJPRChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      // totalResults = total do TJPR no servidor (sem a Corte IDH), que é o que
      // tests/aceite.js compara para saber se um filtro restringiu de fato
      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJPR : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nBaixando inteiro teor de ${results.length} julgados...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjrj')
  .description('Search TJRJ (Tribunal de Justica do Rio de Janeiro) jurisprudence — e-Proc, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores: "expressao", E, OU, NAO, PROX, *)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (TJRJChecker); dispensa -q')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--escopo <escopo>', 'Onde buscar o termo: ementa (default) ou inteiroTeor', 'ementa')
  .option('-t, --tipo <tipo>', 'Tipo de documento: todas (default), acordao, monocratica', 'todas')
  .option('-oj, --orgao <nome>', 'Orgao julgador (label ou trecho; ex: "6ª Câmara de Direito Privado")')
  .option('-r, --relator <nome>', 'Relator(a) (label ou trecho)')
  .option('-c, --classe <classe>', 'Classe processual (label ou trecho; ex: "Agravo de Instrumento")')
  .option('-p, --processo <numero>', 'Filtro por numero de processo DENTRO da busca (use -n p/ consulta direta)')
  .option('--precedente-relevante', 'Somente precedentes marcados como relevantes')
  .option('-ord, --ordem <ordem>', 'recentes (default) | antigos', 'recentes')
  .option('--listar-combos', 'Lista classes, relatores e orgaos julgadores aceitos e sai')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (10 registros/pagina)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjrj.json')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor de cada resultado como .txt')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjrj')
  .option('-v, --visible', 'Ignored (TJRJ usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJRJ usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.listarCombos) {
        const listas = await new TJRJNavigator().listas();
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...listas }) + '\n');
        else {
          console.log('=== ORGAOS JULGADORES ==='); listas.orgaos.forEach(o => console.log('  ' + o));
          console.log('=== CLASSES ==='); listas.classes.forEach(c => console.log('  ' + c));
          console.log(`=== RELATORES (${listas.relatores.length}) ===`); listas.relatores.forEach(r => console.log('  ' + r));
        }
        process.exit(0);
      }

      if (opts.numero) {
        const res = await new TJRJChecker().consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.orgao && !opts.relator) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      log('='.repeat(60));
      log('TJRJ Jurisprudencia Crawler (e-Proc, HTTP direto, sem browser)');
      log('ESCOPO: 2º grau da Justica Comum (base e-Proc, ~2023+).');
      log('Turmas Recursais/Juizados e acervo antigo: eJURIS (sem crawler) — ver CLAUDE-TJRJ.md');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Escopo: ${opts.escopo} | Tipo: ${opts.tipo}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJRJCrawler({ timeout: 90000, log });
      const filters = {
        escopo: opts.escopo,
        tipo: opts.tipo,
        orgao: opts.orgao || null,
        relator: opts.relator || null,
        classe: opts.classe || null,
        processo: opts.processo || null,
        precedenteRelevante: Boolean(opts.precedenteRelevante),
        ordem: opts.ordem,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJRJChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJRJ : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nBaixando inteiro teor de ${results.length} julgados...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjpa')
  .description('Search TJPA (Tribunal de Justica do Para) jurisprudence')
  .option('-q, --query <text>', 'Search query (operadores nativos: OU, E, NAO, "expressao exata")')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ ou numero do acordao/decisao')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('-r, --relator <names>', 'Relator name(s), comma-separated (exact names from /filtros)')
  .option('-oj, --orgao <orgao>', 'Orgao Julgador Colegiado (ex: "1ª Câmara Cível Isolada")')
  .option('-c, --classe <classe>', 'Case class')
  .option('-a, --assunto <assunto>', 'Subject')
  .option('--origem <origem>', 'Origin: tjpa (default), turmas, ambas', 'tjpa')
  .option('-t, --tipo <tipo>', 'Document type: acordao, monocratica, ambos', 'ambos')
  .option('--escopo <escopo>', 'Search scope: ementa (default) or inteiroTeor', 'ementa')
  .option('--tipo-consulta <tc>', 'Query type: free (Formato Livre, default) or anywords (Qualquer Palavra)', 'free')
  .option('-ord, --ordenacao <tipo>', 'Sort: relevancia (default), recentes, antigos', 'relevancia')
  .option('--full-text', 'Include inteiro teor text in the JSON results')
  .option('--fetch-inteiro-teor', 'Download full text of each result as .txt files')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjpa')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjpa.json')
  .option('-v, --visible', 'Ignored (TJPA uses direct API, no browser)')
  .option('--headed', 'Ignored (TJPA uses direct API, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modo consulta direta por numero (TJPAChecker)
      if (opts.numero) {
        const checker = new TJPAChecker();
        const digits = opts.numero.replace(/\D/g, '');
        const res = digits.length >= 14
          ? await checker.consultarProcesso(opts.numero)
          : await checker.consultarDocumento(opts.numero);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" para pesquisa livre ou -n <numero> para consulta direta');
      }

      log('='.repeat(60));
      log('TJPA Jurisprudencia Crawler (API direta)');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Origem: ${opts.origem} | Tipo: ${opts.tipo} | Escopo: ${opts.escopo}`);
      log(`Relator: ${opts.relator || '-'} | Orgao: ${opts.orgao || '-'}`);
      log(`Max Pages: ${opts.maxPages} | Ordenacao: ${opts.ordenacao}`);
      log('='.repeat(60));

      const crawler = new TJPACrawler({
        timeout: 60000,
        includeFullText: !!opts.fullText,
        log,
      });

      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        origem: opts.origem,
        tipo: opts.tipo,
        escopo: opts.escopo,
        tipoConsulta: opts.tipoConsulta,
        ordenacao: opts.ordenacao,
        classe: opts.classe || null,
        assunto: opts.assunto || null,
        relatores: opts.relator ? opts.relator.split(',').map(r => r.trim()) : null,
        orgaoJulgadorColegiado: opts.orgao || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      if (jsonMode) {
        // silencia logs internos do crawler em modo JSON
        const origLog = console.log;
        console.log = () => {};
        var results = await crawler.search(opts.query, filters, searchOptions);
        console.log = origLog;
      } else {
        var results = await crawler.search(opts.query, filters, searchOptions);
      }

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJPAChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading inteiro teor for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjmg')
  .description('Search TJMG (Tribunal de Justica de Minas Gerais) jurisprudence — Consulta Unificada (API direta)')
  .option('-q, --query <text>', 'Search query (operadores Elasticsearch: + | - "frase" ( ) * ~ ; E/OU/NAO em portugues sao IGNORADOS)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ (TJMGChecker)')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('-t, --tipo <tipo>', 'Tipo de documento: todos (default), acordao, monocratica, turmas, vice, comum', 'todos')
  .option('--escopo <escopo>', 'Search scope: ementa (default) or inteiroTeor', 'ementa')
  // SEPARADOR E PONTO-E-VIRGULA, nao virgula: 18 dos 575 orgaos julgadores tem
  // virgula no nome (todos de Turma Recursal). Ver CLAUDE-TJMG.md §2.
  .option('-com, --comarca <nomes>', 'Comarca(s), separadas por PONTO-E-VIRGULA (use --listar comarcas)')
  .option('-oj, --orgao <nomes>', 'Orgao(s) julgador(es), separados por PONTO-E-VIRGULA (use --listar orgaosJulgadores)')
  .option('-mag, --magistrado <nomes>', 'Magistrado(s), separados por PONTO-E-VIRGULA (use --listar magistrados)')
  .option('-c, --classe <nomes>', 'Classe(s) processual(is), separadas por PONTO-E-VIRGULA (use --listar classes)')
  .option('-a, --assunto <nomes>', 'Assunto(s), separados por PONTO-E-VIRGULA (use --listar assuntos)')
  .option('--sem-validar-filtros', 'Nao confere os nomes de comarca/orgao/magistrado/classe/assunto contra a API antes de buscar')
  .option('-ord, --ordenacao <tipo>', 'Sort: relevancia (default), recentes (publicacao), julgamento', 'relevancia')
  .option('--listar <dominio>', 'Lista um combo com contagens: tiposDocumento, classes, comarcas, orgaosJulgadores, magistrados, assuntos')
  .option('--fetch-inteiro-teor', 'Download full text of each result as .txt files')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjmg')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjmg.json')
  .option('-v, --visible', 'Ignored (TJMG uses direct API, no browser)')
  .option('--headed', 'Ignored (TJMG uses direct API, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    // ponto-e-virgula: os nomes dos orgaos julgadores contem virgula
    const lista = (s) => (s ? s.split(';').map((x) => x.trim()).filter(Boolean) : []);

    try {
      // Enumera um combo (tiposDocumento, comarcas, ...) com contagens
      if (opts.listar) {
        const nav = new TJMGNavigator({ log });
        const dominios = await nav.dominio(opts.listar);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, dominio: opts.listar, count: dominios.length, valores: dominios }) + '\n');
        } else {
          console.log(`${opts.listar}: ${dominios.length} valores\n`);
          for (const d of dominios) console.log(`  ${String(d.quantidade).padStart(9)}  ${d.dominio}`);
        }
        process.exit(0);
      }

      // Consulta direta por numero (TJMGChecker)
      if (opts.numero) {
        const checker = new TJMGChecker();
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" para pesquisa, -n <numero> para consulta direta, ou --listar <dominio>');
      }

      log('='.repeat(60));
      log('TJMG Jurisprudencia Crawler (Consulta Unificada, API direta)');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Tipo: ${opts.tipo} | Escopo: ${opts.escopo} | Ordenacao: ${opts.ordenacao}`);
      log(`Comarca: ${opts.comarca || '-'} | Orgao: ${opts.orgao || '-'} | Magistrado: ${opts.magistrado || '-'}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJMGCrawler({ timeout: 60000, log });

      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        tipo: opts.tipo,
        escopo: opts.escopo,
        ordenacao: opts.ordenacao,
        comarcas: lista(opts.comarca),
        orgaos: lista(opts.orgao),
        magistrados: lista(opts.magistrado),
        classes: lista(opts.classe),
        assuntos: lista(opts.assunto),
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      // um nome errado não daria erro na API — devolveria 0. Falhar aqui.
      if (!opts.semValidarFiltros) await crawler.validarFiltros(filters);

      const results = await crawler.search(opts.query, filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults !== null) {
        log(`Total results on server: ${results.totalResults}${results.totalResultsExato ? '' : '+ (contador saturado)'}`);
      }

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJMGChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading inteiro teor for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter((r) => r.arquivo).length;
        const failCount = downloaded.filter((r) => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults,
            totalResultsExato: results.totalResultsExato,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(results.avisos && results.avisos.length ? { avisos: results.avisos } : {}),
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults,
            totalResultsExato: results.totalResultsExato,
            count: results.length,
            output: outputPath,
            ...(results.avisos && results.avisos.length ? { avisos: results.avisos } : {}),
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjgo')
  .description('Search TJGO (Tribunal de Justica de Goias) jurisprudence — Novo Modulo PROJUDI')
  .option('-q, --query <text>', 'Search query (aspas duplas = frase exata; palavras soltas = E implicito)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ (TJGOChecker)')
  .option('-i, --instancia <inst>', 'Instancia: todas (default), 1grau, turmas, tribunal', 'todas')
  .option('-a, --area <area>', 'Area: todas (default), civel, criminal', 'todas')
  .option('-om, --orgao-materia <nome>', 'Orgao/Materia (nome ou codigo; use --listar-orgaos)')
  .option('-u, --unidade <nome>', 'Unidade especifica (serventia; resolvida pela lupa)')
  .option('-mag, --magistrado <nome>', 'Magistrado(a) (resolvido pela lupa)')
  .option('-ta, --tipo-ato <nome>', 'Tipo de Ato: Acordao, Ementa, Sentenca, Decisao, Decisao Monocratica, ...')
  .option('-p, --processo <numero>', 'Filtro por numero do processo (dentro da busca)')
  .option('-di, --data-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--listar-orgaos', 'Lista as opcoes do combo Orgao/Materia e sai')
  .option('--listar-tipos-ato', 'Lista os Tipos de Ato disponiveis e sai')
  .option('--unidades <termo>', 'Consulta a lupa de serventias por termo e sai')
  .option('--magistrados <termo>', 'Consulta a lupa de magistrados por termo e sai')
  .option('--full-text', 'Include full decision text in the JSON results')
  .option('--fetch-inteiro-teor', 'Save full text of each result as .txt files (sem novo acesso a rede)')
  .option('--output-dir <dir>', 'Directory for saved full-text files', './resultados/tjgo')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (50 results/page)', 10)
  .option('--qtde <n>', 'Results per page: 10, 20 or 50', '50')
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjgo.json')
  .option('-v, --visible', 'Ignored (TJGO uses direct HTTP, no browser)')
  .option('--headed', 'Ignored (TJGO uses direct HTTP, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modos utilitarios de listagem (lupas / combo embutido)
      if (opts.listarOrgaos) {
        const lista = TJGONavigator.ORGAOS_MATERIA;
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, orgaosMateria: lista }) + '\n');
        else console.table(lista.map(o => ({ codigo: o.codigo, descricao: o.descricao, area: o.areaId, instancia: o.servTipoId })));
        process.exit(0);
      }
      if (opts.listarTiposAto) {
        const lista = TJGONavigator.TIPOS_ATO;
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, tiposAto: lista }) + '\n');
        else console.table(lista);
        process.exit(0);
      }
      if (opts.unidades !== undefined || opts.magistrados !== undefined) {
        const navigator = new TJGONavigator();
        const res = opts.unidades !== undefined
          ? await navigator.consultarServentias(opts.unidades)
          : await navigator.consultarMagistrados(opts.magistrados);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else {
          console.log(`Total na base: ${res.total} (mostrando ${res.itens.length})`);
          console.table(res.itens);
        }
        process.exit(0);
      }

      // Modo consulta direta por numero (TJGOChecker)
      if (opts.numero) {
        const checker = new TJGOChecker();
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.magistrado && !opts.unidade) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -p/-mag/-u)');
      }

      log('='.repeat(60));
      log('TJGO Jurisprudencia Crawler (HTTP direto, Novo Modulo PROJUDI)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Instancia: ${opts.instancia} | Area: ${opts.area} | Orgao/Materia: ${opts.orgaoMateria || '-'}`);
      log(`Unidade: ${opts.unidade || '-'} | Magistrado: ${opts.magistrado || '-'} | Tipo de Ato: ${opts.tipoAto || '-'}`);
      log(`Processo: ${opts.processo || '-'}`);
      log(`Data Publicacao: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Max Pages: ${opts.maxPages} (${opts.qtde}/pagina)`);
      log('='.repeat(60));

      const crawler = new TJGOCrawler({
        timeout: 60000,
        pageSize: parseInt(opts.qtde, 10),
        includeFullText: !!opts.fullText || !!opts.fetchInteiroTeor,
        log,
      });

      const filters = {
        instancia: opts.instancia,
        area: opts.area,
        orgaoMateria: opts.orgaoMateria || null,
        serventia: opts.unidade || null,
        magistrado: opts.magistrado || null,
        tipoAto: opts.tipoAto || null,
        processo: opts.processo || null,
        dataPublicacaoInicio: opts.dataInicio || null,
        dataPublicacaoFim: opts.dataFim || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      if (jsonMode) {
        const origLog = console.log;
        console.log = () => {};
        var results = await crawler.search(opts.query, filters, searchOptions);
        console.log = origLog;
      } else {
        var results = await crawler.search(opts.query, filters, searchOptions);
      }

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJGOChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nSaving full text for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nSave complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjrs')
  .description('Search TJRS (Tribunal de Justica do Rio Grande do Sul) jurisprudence')
  .option('-q, --query <text>', 'Pesquisa livre (AND implicito; OR maiusculo; -palavra exclui; "frase exata")')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (CNJ ou legado) — usa o TJRSChecker')
  .option('--origem <origem>', 'DESAMBIGUACAO: comum (Justica Comum, default), turmas (Turmas Recursais/Juizados), alcada, exceto-turmas, todas', 'comum')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--escopo <escopo>', 'Search scope: ementa (default) or inteiroTeor', 'ementa')
  .option('-s, --secao <secao>', 'Secao: civel, crime, ambas, todas (default)', 'todas')
  .option('-t, --tipo <tipos>', 'Tipo(s) de decisao, virgula: acordao, monocratica, admissibilidade, duvida')
  .option('-oj, --orgao <nome>', 'Orgao julgador (nome ou codigo; exige --origem comum|turmas|alcada)')
  .option('-r, --relator <nome>', 'Relator/redator (nome ou codigo)')
  .option('-cp, --classe-processual <nome>', 'Classe processual, ex.: "Apelacao Civel", "Recurso Inominado"')
  .option('-cc, --classe-cnj <nome>', 'Classe CNJ (nome ou codigo)')
  .option('-ac, --assunto-cnj <nome>', 'Assunto CNJ (depende de --classe-cnj)')
  .option('--comarca <nome>', 'Comarca de origem, ex.: "PORTO ALEGRE"')
  .option('-p, --processo <numero>', 'Filtro por numero do processo DENTRO da busca (use -n para consulta direta)')
  .option('--expressao <texto>', 'Campo "com a expressao" (frase exata)')
  .option('--qualquer <texto>', 'Campo "com qualquer uma das palavras" (OU)')
  .option('--sem <texto>', 'Campo "sem as palavras" (exclusao)')
  .option('--ref-legislativa <texto>', 'Referencia legislativa (acervo legado)')
  .option('-ord, --ordenacao <tipo>', 'Sort by judgment date: recentes (default) or antigos', 'recentes')
  .option('--listar-tribunais', 'Lista o combo Tribunal (a desambiguacao) e sai')
  .option('--listar-orgaos', 'Lista os orgaos julgadores da --origem escolhida e sai')
  .option('--listar-relatores', 'Lista os relatores/redatores da --origem escolhida e sai')
  .option('--listar-classes-processuais', 'Lista as classes processuais da --origem escolhida e sai')
  .option('--listar-classes-cnj', 'Lista as classes CNJ e sai')
  .option('--full-text', 'Inclui o inteiro teor no JSON dos resultados')
  .option('--fetch-inteiro-teor', 'Grava o inteiro teor de cada resultado em .txt (sem novo acesso a rede)')
  .option('--output-dir <dir>', 'Directory for saved full-text files', './resultados/tjrs')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (10 resultados/pagina, fixo no servidor)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjrs.json')
  .option('-v, --visible', 'Ignored (TJRS uses direct HTTP, no browser)')
  .option('--headed', 'Ignored (TJRS uses direct HTTP, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modos utilitarios de listagem dos combos
      const listagens = {
        listarTribunais: ['tribunais', (nav) => nav.listarTribunais()],
        listarOrgaos: ['orgaosJulgadores', (nav, cod) => nav.listarOrgaosJulgadores(cod)],
        listarRelatores: ['relatores', (nav, cod) => nav.listarRelatores(cod)],
        listarClassesProcessuais: ['classesProcessuais', (nav, cod) => nav.listarTiposDeProcessos(cod)],
        listarClassesCnj: ['classesCnj', (nav) => nav.listarClassesCNJ()],
      };
      for (const [flag, [chave, fn]] of Object.entries(listagens)) {
        if (!opts[flag]) continue;
        const nav = new TJRSNavigator({ log });
        const cod = TJRSNavigator.TRIBUNAIS[
          { comum: 'comum', turmas: 'turmas', alcada: 'alcada', todas: 'todas', 'exceto-turmas': 'exceto-turmas' }[opts.origem] || 'comum'
        ];
        const lista = await fn(nav, cod);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, [chave]: lista }) + '\n');
        else console.table(lista);
        process.exit(0);
      }

      // Modo consulta direta por numero (TJRSChecker) — a verificacao de um julgado
      if (opts.numero) {
        const checker = new TJRSChecker();
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.expressao && !opts.qualquer && !opts.relator && !opts.orgao) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -p/-r/-oj/--expressao)');
      }

      log('='.repeat(60));
      log('TJRS Jurisprudencia Crawler (HTTP direto, Solr via ajax.php)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Origem (Tribunal): ${opts.origem}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Escopo: ${opts.escopo} | Secao: ${opts.secao} | Tipo: ${opts.tipo || 'todos'}`);
      log(`Orgao: ${opts.orgao || '-'} | Relator: ${opts.relator || '-'}`);
      log(`Classe processual: ${opts.classeProcessual || '-'} | Classe CNJ: ${opts.classeCnj || '-'}`);
      log(`Max Pages: ${opts.maxPages} (10/pagina) | Ordenacao: ${opts.ordenacao}`);
      log('='.repeat(60));

      const crawler = new TJRSCrawler({
        timeout: 120000,
        includeFullText: !!opts.fullText,
        log,
      });

      const filters = {
        origem: opts.origem,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        escopo: opts.escopo,
        secao: opts.secao,
        tipos: opts.tipo ? opts.tipo.split(',').map(t => t.trim()).filter(Boolean) : [],
        orgaoJulgador: opts.orgao || null,
        relator: opts.relator || null,
        classeProcessual: opts.classeProcessual || null,
        classeCnj: opts.classeCnj || null,
        assuntoCnj: opts.assuntoCnj || null,
        comarca: opts.comarca || null,
        processo: opts.processo || null,
        expressao: opts.expressao || null,
        qualquerPalavra: opts.qualquer || null,
        semPalavras: opts.sem || null,
        referenciaLegislativa: opts.refLegislativa || null,
        ordenacao: opts.ordenacao,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query || '', filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJRSChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nSaving full text for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nSave complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            filtroSolr: results.filtroSolr,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        // `raw` (docs crus do Solr, com o inteiro teor em base64) fica fora do JSON
        fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            filtroSolr: results.filtroSolr,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjma')
  .description('TJMA (Tribunal de Justica do Maranhao) — BUSCA BLOQUEADA por captcha; -n consulta processo via DataJud')
  .option('-q, --query <text>', 'Search query (BLOQUEADA: o JurisConsult exige captcha — ver CLAUDE-TJMA.md)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo CNJ (via DataJud/CNJ — FUNCIONA)')
  .option('--diagnostico', 'Checa ao vivo se o bloqueio de captcha do TJMA ainda existe')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY) — o TJMA so filtra por publicacao')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--foro <foro>', 'Foro: comum (default), turmas (Turmas Recursais), juizados (Juizado Especial)', 'comum')
  .option('-t, --tipo <tipo>', 'Tipo: acordao (default), monocratica, sentenca', 'acordao')
  .option('--relatorio <chave>', 'Relatorio explicito: acordaos, acordaos-tr, monocraticas, monocraticas-tr, sentencas, sentencas-je')
  .option('--condicao <cond>', 'Condicao dos termos (so relatorio Acordaos): e, ou, unico (default)', 'unico')
  .option('--frase-exata', 'Frase exata (nao existe no relatorio Acordaos)')
  .option('--sistema <sis>', 'Sistema de origem (so Acordaos): todos (default), themis, pje', 'todos')
  .option('-r, --relator <id>', 'Matricula do relator (ver human-codegen/TJMA/09-jurisconsult/03-magistrados.json)')
  .option('-oj, --orgao <id>', 'Id do orgao julgador (ver 03-orgaos-julgadores.json)')
  .option('-c, --classe <id>', 'Id da classe judicial (ver 03-classes.json)')
  .option('--comarca <id>', 'Id da comarca (so 1o grau — ver 03-comarcas.json)')
  .option('--vara <id>', 'Id da vara (so 1o grau)')
  .option('--verificar [amostra]', 'Audita N processos contra o DataJud (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjma.json')
  .option('-v, --visible', 'Ignored (TJMA usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJMA usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // --- Diagnostico do bloqueio (nao precisa de captcha) ---
      if (opts.diagnostico) {
        const crawler = new TJMACrawler({ log });
        const diag = await crawler.diagnosticar();
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...diag }) + '\n');
        } else {
          console.log(JSON.stringify(diag, null, 2));
        }
        process.exit(0);
      }

      // --- Consulta por numero de processo (DataJud) — o que funciona ---
      if (opts.numero) {
        const checker = new TJMAChecker({ log });
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error(
          'Informe -n <numero> para consultar um processo (funciona, via DataJud) '
          + 'ou --diagnostico para checar o bloqueio. A busca por termo (-q) esta '
          + 'bloqueada por captcha no TJMA — leia CLAUDE-TJMA.md.',
        );
      }

      log('='.repeat(60));
      log('TJMA Jurisprudencia (JurisConsult) — API direta');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Foro: ${opts.foro} | Tipo: ${opts.tipo} | Relatorio: ${opts.relatorio || '(derivado)'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJMACrawler({ timeout: 60000, log });

      const filters = {
        foro: opts.foro,
        tipo: opts.tipo,
        relatorio: opts.relatorio || null,
        dataInicio: opts.dataPubInicio || null,
        dataFim: opts.dataPubFim || null,
        condicao: opts.condicao,
        fraseExata: !!opts.fraseExata,
        sistema: opts.sistema,
        relator: opts.relator || null,
        orgao: opts.orgao || null,
        classe: opts.classe || null,
        comarca: opts.comarca || null,
        vara: opts.vara || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query, filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra o DataJud...`);
        verificacao = await new TJMAChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(JSON.stringify({
          success: true,
          totalResults: results.totalResults || null,
          count: results.length,
          output: outputPath,
          ...(verificacao ? { verificacao } : {}),
        }) + '\n');
      }
    } catch (error) {
      const bloqueio = error instanceof TJMANavigator.CaptchaBloqueadoError
        ? { bloqueio: 'captcha', tribunal: 'TJMA', alternativa: 'TRF1 (MA e da 1a Regiao) para materia federal; nenhum TJ vizinho cobre jurisprudencia estadual do MA' }
        : {};
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message, ...bloqueio }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjsp')
  .description('Search TJSP (Tribunal de Justica de Sao Paulo) jurisprudence')
  .requiredOption('-q, --query <text>', 'Search query (supports operators: E, OU, NAO, "")')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--2grau', 'Include 2° grau (default: true)')
  .option('--no-2grau', 'Exclude 2° grau')
  .option('--recursal', 'Include Colégios Recursais (default: true)')
  .option('--no-recursal', 'Exclude Colégios Recursais')
  .option('--acordaos', 'Include Acórdãos (default: true)')
  .option('--no-acordaos', 'Exclude Acórdãos')
  .option('--homologacoes', 'Include Homologações de Acordo')
  .option('--decisoes-mono', 'Include Decisões Monocráticas')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjsp.json')
  .option('-v, --visible', 'Show browser window (disable headless mode)')
  .option('--headed', 'Alias for --visible: show browser window for debugging')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    log('='.repeat(60));
    log('TJSP Jurisprudencia Crawler');
    log('='.repeat(60));
    log(`Query: ${opts.query}`);
    log(`Data Julgamento Inicio: ${opts.dataInicio || 'not set'}`);
    log(`Data Julgamento Fim: ${opts.dataFim || 'not set'}`);
    log(`Data Publicacao Inicio: ${opts.dataPubInicio || 'not set'}`);
    log(`Data Publicacao Fim: ${opts.dataPubFim || 'not set'}`);
    log(`Origem 2° grau: ${opts['2grau'] !== false}`);
    log(`Origem Recursal: ${opts.recursal !== false}`);
    log(`Max Pages: ${opts.maxPages}`);
    log(`Output: ${opts.output}`);
    log(`Headless: ${!(opts.visible || opts.headed)}`);
    log('='.repeat(60));

    const headless = !(opts.visible || opts.headed);
    const crawler = new TJSPCrawler({
      headless,
      slowMo: headless ? 0 : 100,
      timeout: 60000,
    });

    try {
      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        origem2grau: opts['2grau'] !== false,
        origemRecursal: opts.recursal !== false,
        tipoAcordao: opts.acordaos !== false,
        tipoHomologacao: opts.homologacoes || false,
        tipoDecisaoMono: opts.decisoesMono || false,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: true, count: results.length, output: outputPath }) + '\n'
        );
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjsc')
  .description('Search TJSC (Tribunal de Justica de Santa Catarina) jurisprudence')
  .option('-q, --query <text>', 'Pesquisa livre (E implicito; ou; nao; "frase exata"; * curinga)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (CNJ) — usa o TJSCChecker')
  .option('--origem <origem>', 'DESAMBIGUACAO: comum (Justica Comum, default), turmas (Turmas Recursais/Juizados), uniformizacao, conselho, todas', 'comum')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--escopo <escopo>', 'Search scope: inteiroTeor (default, igual ao site) or ementa', 'inteiroTeor')
  .option('-t, --tipo <tipos>', 'Tipo(s) de documento, virgula: acordao, monocratica, despacho (exige --origem especifica)')
  .option('-oj, --orgao <nomes>', 'Orgao(s) julgador(es), virgula (nome como no combo da origem escolhida)')
  .option('-r, --relator <nomes>', 'Relator(es), virgula')
  .option('-cl, --classe <nomes>', 'Classe(s) processual(is), virgula, ex.: "Apelacao"')
  .option('-p, --processo <numero>', 'Filtro por numero do processo DENTRO da busca (use -n para consulta direta)')
  .option('--precedente-relevante', 'So precedentes marcados como relevantes')
  .option('-ord, --ordenacao <tipo>', 'Sort by date: recentes (default) or antigos', 'recentes')
  .option('--por-pagina <n>', 'Resultados por pagina: 10 (default), 25, 50, 100', 10)
  .option('--listar-combos', 'Lista os combos (origens, tipos, orgaos, relatores, classes) da --origem e sai')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor de cada resultado (.txt)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjsc')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjsc.json')
  .option('-v, --visible', 'Show browser window (disable headless mode)')
  .option('--headed', 'Alias for --visible: show browser window for debugging')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    const headless = !(opts.visible || opts.headed);
    const lista = (v) => (v ? String(v).split(',').map((s) => s.trim()).filter(Boolean) : []);

    try {
      // Listagem dos combos (dependem da origem: o combo de orgaos do TJSC nao e o das Turmas)
      if (opts.listarCombos) {
        const chave = TJSCCrawler.chaveOrigem(opts.origem);
        const codigos = chave === 'todas'
          ? Object.values(TJSCNavigator.ORIGENS)
          : [TJSCNavigator.ORIGENS[chave]];
        const nav = new TJSCNavigator({ headless, log });
        try {
          const combos = await nav.listarCombos(codigos);
          if (jsonMode) process.stdout.write(JSON.stringify({ success: true, origem: chave, ...combos }) + '\n');
          else console.log(JSON.stringify(combos, null, 2));
        } finally {
          await nav.fechar();
        }
        process.exit(0);
      }

      // Modo consulta direta por numero (TJSCChecker) — a verificacao de um julgado
      if (opts.numero) {
        const checker = new TJSCChecker({ headless });
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.orgao && !opts.relator) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -p/-r/-oj)');
      }

      log('='.repeat(60));
      log('TJSC Jurisprudencia Crawler (eproc-jur, browser)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Origem: ${opts.origem}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Escopo: ${opts.escopo} | Tipo: ${opts.tipo || 'todos'}`);
      log(`Orgao: ${opts.orgao || '-'} | Relator: ${opts.relator || '-'} | Classe: ${opts.classe || '-'}`);
      log(`Max Pages: ${opts.maxPages} (${opts.porPagina}/pagina) | Headless: ${headless}`);
      log('='.repeat(60));

      const crawler = new TJSCCrawler({ headless, slowMo: headless ? 0 : 100, timeout: 60000, log });

      const filters = {
        origem: opts.origem,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
        dataPubInicio: opts.dataPubInicio || null,
        dataPubFim: opts.dataPubFim || null,
        escopo: opts.escopo,
        tipos: lista(opts.tipo),
        orgaos: lista(opts.orgao),
        relatores: lista(opts.relator),
        classes: lista(opts.classe),
        processo: opts.processo || null,
        precedenteRelevante: !!opts.precedenteRelevante,
        ordenacao: opts.ordenacao,
      };

      const searchOptions = {
        maxPages: parseInt(opts.maxPages, 10),
        tamanhoPagina: parseInt(opts.porPagina, 10),
        // o download do inteiro teor reaproveita os cookies do desafio F5:
        // a sessao precisa sobreviver a busca
        keepOpen: !!opts.fetchInteiroTeor,
      };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query || '', filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let downloaded = null;
      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading full text for ${results.length} results...`);
        downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        log(`Files saved to: ${outputDir}`);
      }
      await crawler.close();

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJSCChecker({ headless });
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(JSON.stringify({
          success: true,
          totalResults: results.totalResults || null,
          count: results.length,
          origemAplicada: results.origemAplicada,
          output: outputPath,
          ...(downloaded ? {
            downloaded: downloaded.filter((d) => d.arquivo).length,
            failed: downloaded.filter((d) => !d.arquivo).length,
            outputDir: path.resolve(opts.outputDir),
          } : {}),
          ...(verificacao ? { verificacao } : {}),
        }) + '\n');
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

// ---------------------------------------------------------------------------
// FALCAO — Justica do Trabalho: TST + TRT1..TRT24 + CSJT (26 acervos)
//
// O Falcao e UMA base nacional (jurisprudencia.jt.jus.br): os 26 acervos vivem
// no mesmo indice e o que os separa e o parametro `tribunais`. Por isso os 26
// comandos sao REGISTRADOS EM LACO a partir de src/FalcaoTribunais.js em vez de
// copiados 26 vezes — todos tem exatamente a mesma superficie de flags, e uma
// correcao no laco corrige a Justica do Trabalho inteira.
//
// `jur tst -q "..."` == `jur trt2 -q "..."` == `jur trt15 -q "..."`.
// ---------------------------------------------------------------------------

// --grau e o rotulo humano da desambiguacao; --colecao e a forma crua.
const FALCAO_GRAUS = {
  '1': ['sentencas'],
  '2': ['acordaos'],
  primeiro: ['sentencas'],
  segundo: ['acordaos'],
  monocraticas: ['decisoesmonocraticas'],
  admissibilidade: ['recursorevista'],
  ambos: ['acordaos', 'sentencas'],
  todos: ['acordaos', 'sentencas', 'decisoesmonocraticas', 'recursorevista'],
};

for (const meta of Object.values(FalcaoTribunais.TRIBUNAIS)) {
  const SIGLA = meta.sigla;
  const cmd = meta.comando;

  program
    .command(cmd)
    .description(
      `Search ${SIGLA} (${meta.nome}) jurisprudence via FALCAO`
      + (meta.ressalva ? ` -- ATENCAO: ${meta.ressalva}` : '')
    )
    .option('-q, --query <text>', 'Pesquisa livre (OU implicito; "frase exata"; -palavra exclui)')
    .option('-n, --numero <numero>', `Consulta direta por numero de processo CNJ - usa o ${SIGLA}Checker`)
    .option('-g, --grau <grau>', 'DESAMBIGUACAO PRINCIPAL: 1 (sentencas/Varas), 2 (acordaos/Turmas, default), monocraticas, admissibilidade, ambos, todos', '2')
    .option('-c, --colecao <colecoes>', 'Colecao(oes) crua(s), virgula: acordaos, sentencas, decisoesmonocraticas, recursorevista, precedentes (sobrepoe --grau)')
    .option('-di, --data-inicio <date>', 'Data inicial de julgamento/juntada (DD/MM/YYYY)')
    .option('-df, --data-fim <date>', 'Data final de julgamento/juntada (DD/MM/YYYY)')
    .option('-oj, --orgao <nome>', 'Orgao julgador, ex.: "1a Turma", "Secao Especializada", "03a VARA DO TRABALHO DE SAO PAULO" (use --listar-orgaos)')
    .option('-r, --relator <nome>', 'Magistrada/magistrado (nome completo, como no combo)')
    .option('-cp, --classe <sigla>', 'Classe processual pela sigla, ex.: ROT, AP, AIRO, ATSum')
    .option('--prioridade <nome>', 'Prioridade, ex.: "Idoso", "Acidente de Trabalho"')
    .option('--com-ementa', 'Apenas documentos que possuem ementa (temEmenta=S)')
    .option('--sem-ementa', 'Apenas documentos sem ementa (temEmenta=N)')
    .option('--escopo <escopo>', 'Escopo da busca: inteiroTeor (default) ou ementa', 'inteiroTeor')
    .option('-ord, --ordenacao <tipo>', 'Ordenacao: relevancia (default), recentes, antigos', 'relevancia')
    .option('--listar-colecoes', 'Lista as colecoes (a desambiguacao de grau) com as contagens e sai')
    .option('--listar-orgaos', 'Lista os orgaos julgadores da colecao escolhida e sai')
    .option('--listar-relatores', 'Lista os relatores da colecao escolhida e sai')
    .option('--listar-classes', 'Lista as classes processuais da colecao escolhida e sai')
    .option('--listar-tribunais', 'Lista os 26 acervos do FALCAO (TST + 24 TRTs + CSJT) com as contagens e sai')
    .option('--full-text', 'Inclui o inteiro teor no JSON dos resultados (payload pesado)')
    .option('--fetch-inteiro-teor', 'Grava o inteiro teor de cada resultado em .txt (sem novo acesso a rede)')
    .option('--output-dir <dir>', 'Directory for saved full-text files', `./resultados/${cmd}`)
    .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
    .option('--max-results <number>', 'Maximum total results to collect (teto do servidor: 200 por colecao)')
    .option('-m, --max-pages <number>', 'Maximum pages to crawl (10 resultados/pagina, max 20 paginas)', 10)
    .option('-o, --output <file>', 'Output JSON file', `resultados/results-${cmd}.json`)
    .option('-v, --visible', `Ignored (${SIGLA}/FALCAO uses direct HTTP, no browser)`)
    .option('--headed', `Ignored (${SIGLA}/FALCAO uses direct HTTP, no browser)`)
    .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
    .action(async (opts) => {
      const jsonMode = opts.json;
      const log = jsonMode ? () => {} : console.log.bind(console);
      const { Navigator, Crawler, Checker } = FalcaoTribunais.classes(SIGLA);

      try {
        const colecoes = opts.colecao
          ? opts.colecao.split(',').map((c) => c.trim()).filter(Boolean)
          : (FALCAO_GRAUS[String(opts.grau)] || null);
        if (!colecoes) {
          throw new Error(`--grau "${opts.grau}" invalido (use: ${Object.keys(FALCAO_GRAUS).join(', ')})`);
        }

        // Modos utilitarios de listagem
        const listagens = {
          listarColecoes: ['colecoes', (nav, c) => nav.listarColecoes({ colecao: c })],
          listarOrgaos: ['orgaosJulgadores', (nav, c) => nav.listarOrgaosJulgadores(c)],
          listarRelatores: ['relatores', (nav, c) => nav.listarRelatores(c)],
          listarClasses: ['classes', (nav, c) => nav.listarClasses(c)],
          listarTribunais: ['tribunais', (nav, c) => nav.listarTribunais({ colecao: c })],
        };
        for (const [flag, [chave, fn]] of Object.entries(listagens)) {
          if (!opts[flag]) continue;
          const nav = new Navigator({ log });
          const lista = await fn(nav, colecoes[0]);
          if (jsonMode) process.stdout.write(JSON.stringify({ success: true, tribunal: SIGLA, colecao: colecoes[0], [chave]: lista }) + '\n');
          else { console.log(`Tribunal: ${SIGLA} | Colecao: ${colecoes[0]}`); console.table(lista); }
          process.exit(0);
        }

        // Consulta direta por numero (a verificacao de um julgado)
        if (opts.numero) {
          const checker = new Checker();
          const res = await checker.consultarProcesso(opts.numero);
          if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
          else console.log(JSON.stringify(res, null, 2));
          process.exit(res.encontrado ? 0 : 1);
        }

        if (!opts.query && !opts.orgao && !opts.relator && !opts.classe) {
          throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -oj/-r/-cp)');
        }

        // Coleção que este acervo estruturalmente NAO tem: avisar, nunca devolver
        // 0 em silencio (0 aqui significa "a corte nao julga isso", nao "nada achado").
        const vazias = FalcaoTribunais.colecoesVaziasDe(SIGLA, colecoes);
        if (vazias.length === colecoes.length) {
          throw new Error(
            `${SIGLA} nao possui acervo de ${vazias.join(', ')} — ${meta.alternativaColecaoVazia}`
          );
        }
        if (vazias.length) {
          log(`AVISO: ${SIGLA} nao possui acervo de ${vazias.join(', ')} (ignorado) — ${meta.alternativaColecaoVazia}`);
        }

        const rotulos = colecoes.map((c) => `${c} (${FalcaoNavigator.COLECOES[c]?.grau ?? '?'}o grau)`).join(', ');
        log('='.repeat(60));
        log(`${SIGLA} Jurisprudencia - FALCAO (HTTP direto, API JSON publica)`);
        log(meta.nome);
        if (meta.ressalva) log(`ATENCAO: ${meta.ressalva}`);
        log('='.repeat(60));
        log(`Query: ${opts.query || '-'}`);
        log(`Grau/Colecao: ${rotulos}`);
        log(`Data: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
        log(`Orgao: ${opts.orgao || '-'} | Relator: ${opts.relator || '-'} | Classe: ${opts.classe || '-'}`);
        log(`Escopo: ${opts.escopo} | Ordenacao: ${opts.ordenacao}`);
        log(`Max Pages: ${opts.maxPages} (10/pagina; teto do servidor: 20 paginas = 200 resultados)`);
        log('='.repeat(60));

        const crawler = new Crawler({
          timeout: 90000,
          includeFullText: !!opts.fullText,
          log,
        });

        const filters = {
          colecoes,
          dataInicio: opts.dataInicio || null,
          dataFim: opts.dataFim || null,
          orgaoJulgador: opts.orgao || null,
          relator: opts.relator || null,
          classe: opts.classe || null,
          prioridade: opts.prioridade || null,
          temEmenta: opts.comEmenta ? 'S' : (opts.semEmenta ? 'N' : null),
          escopo: opts.escopo,
          ordenacao: opts.ordenacao,
        };

        const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
        if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

        const results = await crawler.search(opts.query || '', filters, searchOptions);

        log('='.repeat(60));
        log(`Total results collected: ${results.length}`);
        if (results.totalResults) log(`Total results on server: ${results.totalResults}`);
        if (results.totaisPorColecao) log(`Por colecao: ${JSON.stringify(results.totaisPorColecao)}`);

        let verificacao = null;
        if (opts.verificar) {
          const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
          log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
          const checker = new Checker();
          verificacao = await checker.verificarResultados(results, { amostra, log });
          log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
        }

        if (opts.fetchInteiroTeor) {
          const outputDir = path.resolve(opts.outputDir);
          log(`\nSaving full text for ${results.length} results...`);
          const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
          const successCount = downloaded.filter((r) => r.arquivo).length;
          const failCount = downloaded.filter((r) => !r.arquivo).length;
          log(`\nSave complete: ${successCount} success, ${failCount} failed`);
          log(`Files saved to: ${outputDir}`);

          if (jsonMode) {
            process.stdout.write(JSON.stringify({
              success: true,
              tribunal: SIGLA,
              totalResults: results.totalResults || null,
              totaisPorColecao: results.totaisPorColecao,
              count: results.length,
              downloaded: successCount,
              failed: failCount,
              outputDir,
              ...(verificacao ? { verificacao } : {}),
            }) + '\n');
          }
        } else {
          const outputPath = path.resolve(opts.output);
          fs.mkdirSync(path.dirname(outputPath), { recursive: true });
          fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
          log(`Results saved to: ${outputPath}`);

          if (jsonMode) {
            process.stdout.write(JSON.stringify({
              success: true,
              tribunal: SIGLA,
              totalResults: results.totalResults || null,
              totaisPorColecao: results.totaisPorColecao,
              count: results.length,
              output: outputPath,
              ...(verificacao ? { verificacao } : {}),
            }) + '\n');
          }
        }
      } catch (error) {
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: false, tribunal: SIGLA, error: error.message }) + '\n');
          process.exit(1);
        }
        console.error('Error during crawling:', error.message);
        process.exit(1);
      }
    });
}

program
  .command('stf')
  .description('Search STF (Supremo Tribunal Federal) jurisprudence — acordaos, sumulas (inc. vinculantes), decisoes monocraticas, informativos')
  .option('-q, --query <text>', 'Search query (operadores em portugues: e, ou, nao, "frase exata", " "~N, ~, $, ?, parenteses)')
  .option('-n, --numero <numero>', 'Consulta direta: "ARE 1596565" / "ADI 4277" (classe+numero) ou numero unico CNJ (20 digitos)')
  .option('-b, --base <base>', 'Base: acordaos (default), decisoes, sumulas, informativos', 'acordaos')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('-oj, --orgao <orgaos>', 'Orgao julgador, comma-separated: "Tribunal Pleno","Primeira Turma","Segunda Turma"')
  .option('-c, --classe <classes>', 'Classe processual, comma-separated: ADI,ADPF,ADC,RE,ARE,HC,MS,AI,RCL...')
  .option('-r, --relator <ministros>', 'Ministro(s), comma-separated (nome exato: "GILMAR MENDES")')
  .option('-uf, --uf <ufs>', 'UF de procedencia, comma-separated: SP,PR,RJ...')
  .option('--rg', 'Somente acordaos com REPERCUSSAO GERAL reconhecida')
  .option('--sem-rg', 'Somente acordaos SEM repercussao geral')
  .option('--vinculantes', 'Base sumulas: somente SUMULAS VINCULANTES (implica -b sumulas)')
  .option('--sumulas-simples', 'Base sumulas: somente sumulas nao vinculantes (implica -b sumulas)')
  .option('--questao-ordem', 'Somente questoes de ordem')
  .option('--coletanea', 'Somente a Coletanea de acordaos (anteriores a 1950)')
  .option('--presidencia', 'Base decisoes: somente decisoes da Presidencia')
  .option('--inteiro-teor', 'Buscar tambem no inteiro teor (so acordaos publicados a partir de 2012)')
  .option('--sem-sinonimos', 'Desliga a expansao por sinonimos do Tesauro do STF')
  .option('--sem-plural', 'Desliga a equivalencia singular/plural')
  .option('--radicais', 'Liga a busca por radicais (exclui plural)')
  .option('--tema <texto>', 'Campo especifico: tema de repercussao geral (numero ou texto)')
  .option('--tese <texto>', 'Campo especifico: tese firmada')
  .option('--partes <texto>', 'Campo especifico: nome das partes/procuradores')
  .option('--legislacao <texto>', 'Campo especifico: legislacao citada (ex: "CF-1988 ART-00005")')
  .option('--ementa <texto>', 'Campo especifico: ementa / decisao / indexacao')
  .option('-ord, --ordenacao <tipo>', 'Sort: relevancia (default), recentes, antigos', 'relevancia')
  .option('--full-text', 'Include inteiro teor text in the JSON results')
  .option('--fetch-inteiro-teor', 'Download full text of each result as .txt files')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/stf')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--listar-facetas [faceta]', 'Lista as opcoes de uma faceta da base (orgao_julgador, ministro_facet, processo_classe_processual_unificada_classe_sigla, procedencia_geografica_uf_sigla, ramo_direito, situacao_sumula)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (100 results/page)', 10)
  .option('--page-size <n>', 'Results per page (max 250)', 100)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-stf.json')
  .option('-v, --visible', 'Show the browser used ONLY to solve the AWS WAF challenge')
  .option('--headed', 'Alias for --visible')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    const headless = !(opts.visible || opts.headed);

    try {
      let base = opts.base;
      if (opts.vinculantes || opts.sumulasSimples) base = 'sumulas';

      if (opts.listarFacetas) {
        const faceta = opts.listarFacetas === true ? 'orgao_julgador' : opts.listarFacetas;
        const nav = new STFNavigator({ headless, log });
        const lista = await nav.facetas(base, faceta);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, base, faceta, opcoes: lista }) + '\n');
        else console.log(JSON.stringify({ base, faceta, opcoes: lista }, null, 2));
        process.exit(0);
      }

      if (opts.numero) {
        const checker = new STFChecker({ headless, log: () => {} });
        const res = await checker.consultar(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      // Sem termo só se houver algo que recorte a base: um campo específico, um filtro, ou
      // uma base pequena o bastante para ser varrida inteira (súmulas, informativos).
      const temCampoEspecifico = opts.tema || opts.tese || opts.partes || opts.legislacao || opts.ementa;
      const temFiltro = opts.orgao || opts.classe || opts.relator || opts.uf || opts.dataInicio
        || opts.dataFim || opts.dataPubInicio || opts.dataPubFim || opts.questaoOrdem || opts.coletanea;
      const basePequena = base === 'sumulas' || base === 'informativos';
      if (!opts.query && !temCampoEspecifico && !temFiltro && !basePequena
          && !opts.vinculantes && !opts.sumulasSimples && !opts.rg) {
        throw new Error('Informe -q "<termos>", um campo especifico (--tema/--tese/--partes/--legislacao/--ementa), um filtro (-oj/-c/-r/-uf/-di), --rg/--vinculantes, ou -n <numero>');
      }

      log('='.repeat(60));
      log('STF Jurisprudencia Crawler (API direta)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '(sem termo)'}`);
      log(`Base: ${base}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Orgao: ${opts.orgao || '-'} | Classe: ${opts.classe || '-'} | Ministro: ${opts.relator || '-'} | UF: ${opts.uf || '-'}`);
      log(`Max Pages: ${opts.maxPages} | Page size: ${opts.pageSize} | Ordenacao: ${opts.ordenacao}`);
      log('='.repeat(60));

      const crawler = new STFCrawler({
        pageSize: parseInt(opts.pageSize, 10),
        includeFullText: !!opts.fullText,
        headless,
        log,
      });

      const filters = {
        base,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        orgao: opts.orgao || null,
        classe: opts.classe || null,
        ministro: opts.relator || null,
        uf: opts.uf || null,
        repercussaoGeral: opts.rg ? true : (opts.semRg ? false : undefined),
        vinculante: opts.vinculantes ? true : (opts.sumulasSimples ? false : undefined),
        questaoOrdem: !!opts.questaoOrdem,
        coletanea: !!opts.coletanea,
        presidencia: opts.presidencia ? true : undefined,
        inteiroTeor: !!opts.inteiroTeor,
        sinonimos: !opts.semSinonimos,
        plural: !opts.semPlural,
        radicais: !!opts.radicais,
        ordenacao: opts.ordenacao,
        tema: opts.tema || null,
        tese: opts.tese || null,
        partes: opts.partes || null,
        legislacao: opts.legislacao || null,
        ementaAtaIndexacao: opts.ementa || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query || '', filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new STFChecker({ headless, log });
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nSalvando inteiro teor de ${results.length} resultados...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, totalResults: results.totalResults || null, count: results.length,
            downloaded: successCount, failed: failCount, outputDir,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, totalResults: results.totalResults || null, count: results.length,
            output: outputPath, ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('stj')
  .description('Search STJ (Superior Tribunal de Justica) jurisprudence via SCON')
  .option('-q, --query <text>', 'Pesquisa livre (operadores nativos: e, ou, nao, adj, prox, mesmo, com, $)')
  .option('-n, --numero <numero>', 'Consulta direta: "REsp 1809043" | 2019/0116080-0 | no CNJ (usa o STJChecker)')
  .option('--base <base>', 'DESAMBIGUACAO 1 (tipo de documento): acordao (default), monocratica, sumula, informativo, tese', 'acordao')
  .option('-oj, --orgao <orgaos>', 'DESAMBIGUACAO 2 (orgao julgador), virgula: T1..T6, S1..S3, CE, PS, VP (ou "terceira-turma")')
  .option('-s, --secao <secao>', 'Atalho de orgao: 1|publico, 2|privado, 3|penal, corte (Secao + suas Turmas)')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--ementa <text>', 'Termos restritos ao campo Ementa (em vez de todo o espelho)')
  .option('-r, --relator <codigo>', 'Codigo do ministro (ver --listar-ministros)')
  .option('-cl, --classe <sigla>', 'Classe do processo, ex.: RESP, ARESP, HC')
  .option('--uf <uf>', 'UF de origem do processo, ex.: SP')
  .option('-p, --processo <numero>', 'Filtro por numero DENTRO da busca (use -n para consulta direta)')
  .option('--nota <chave>', 'Recorte tematico pronto do STJ, ex.: repetitivos, afetacao, overruling (--listar-notas)')
  .option('--repetitivos', 'Atalho para --nota repetitivos: so acordaos julgados sob o rito dos repetitivos/IACs')
  .option('--temas [tipo]', 'MODULO DE PRECEDENTES QUALIFICADOS: busca TEMAS (repetitivo|controversia|iac|sirdr|puil)')
  .option('--tema-inicial <n>', 'Faixa de temas: numero inicial (com --temas)')
  .option('--tema-final <n>', 'Faixa de temas: numero final (com --temas)')
  .option('--ramo <ramo>', 'Ramo do direito (com --temas), ex.: "DIREITO CIVIL"')
  .option('-ord, --ordenacao <tipo>', 'recentes (default), antigos, relevancia', 'recentes')
  .option('--por-pagina <n>', 'Documentos por pagina: 10 (default), 25, 50', 10)
  .option('--listar-orgaos', 'Lista os orgaos julgadores e sai')
  .option('--listar-notas', 'Lista os recortes tematicos prontos (combo Notas) e sai')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor de cada resultado (.txt) — ~1 MB por acordao')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/stj')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled julgados against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-stj.json')
  .option('-v, --visible', 'Ignored: o SCON JA roda headful (o Cloudflare do STJ nao libera headless)')
  .option('--headed', 'Ignored: o SCON JA roda headful')
  .option('--headless', 'Forca modo headless — o Cloudflare do STJ costuma BLOQUEAR; use so para testar se caiu')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    // O default e HEADFUL de proposito: nenhuma variante de headless atravessa
    // o desafio Cloudflare do scon.stj.jus.br (ver CLAUDE-STJ.md).
    const headless = !!opts.headless;
    const lista = (v) => (v ? String(v).split(',').map((s) => s.trim()).filter(Boolean) : []);

    try {
      if (opts.listarOrgaos) {
        const saida = Object.entries(STJNavigator.ORGAOS).map(([codigo, nome]) => ({ codigo, nome }));
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, orgaos: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }
      if (opts.listarNotas) {
        const saida = Object.entries(STJNavigator.NOTAS).map(([chave, expressao]) => ({ chave, expressao }));
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, notas: saida }) + '\n');
        else console.log(JSON.stringify(saida, null, 2));
        process.exit(0);
      }

      // Consulta direta por numero (STJChecker) — a verificacao de um julgado
      if (opts.numero) {
        const checker = new STJChecker({ headless, log });
        try {
          const res = await checker.consultarProcesso(opts.numero);
          if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
          else console.log(JSON.stringify(res, null, 2));
          process.exit(res.encontrado ? 0 : 1);
        } finally {
          await checker.fechar();
        }
      }

      const crawler = new STJCrawler({ headless, timeout: 90000, log });

      // MODULO DE PRECEDENTES QUALIFICADOS — outro host, sem Cloudflare, headless
      if (opts.temas) {
        const tipo = opts.temas === true ? 'repetitivo' : String(opts.temas);
        log('='.repeat(60));
        log(`STJ — Precedentes Qualificados (${tipo})`);
        log('='.repeat(60));
        const temas = await crawler.buscarTemas(opts.query || '', {
          tipo,
          temaInicial: opts.temaInicial,
          temaFinal: opts.temaFinal,
          ramo: opts.ramo,
          classe: opts.classe,
          processo: opts.processo,
        }, { porPagina: parseInt(opts.porPagina, 10) === 10 ? 50 : parseInt(opts.porPagina, 10) });
        log(`Total de ${tipo}s encontrados: ${temas.totalResults ?? '(desconhecido)'} (coletados: ${temas.length})`);
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(Array.from(temas), null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, modulo: 'precedentes-qualificados', tipo,
            totalResults: temas.totalResults ?? null, count: temas.length, output: outputPath,
          }) + '\n');
        }
        process.exit(0);
      }

      if (!opts.query && !opts.ementa && !opts.processo && !opts.relator && !opts.nota && !opts.repetitivos) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: --ementa/-p/-r/--nota)');
      }

      log('='.repeat(60));
      log('STJ Jurisprudencia Crawler (SCON, browser headful)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Base: ${opts.base} | Orgao: ${opts.orgao || opts.secao || 'todos'}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Nota: ${opts.repetitivos ? 'repetitivos' : (opts.nota || '-')}`);
      log(`Max Pages: ${opts.maxPages} (${opts.porPagina}/pagina) | Headless: ${headless}`);
      log('='.repeat(60));

      const filters = {
        base: opts.base,
        orgaos: lista(opts.orgao),
        secao: opts.secao || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
        dataPubInicio: opts.dataPubInicio || null,
        dataPubFim: opts.dataPubFim || null,
        ementa: opts.ementa || null,
        processo: opts.processo || null,
        classe: opts.classe || null,
        uf: opts.uf || null,
        relator: opts.relator || null,
        nota: opts.repetitivos ? 'repetitivos' : (opts.nota || null),
        ordenacao: opts.ordenacao,
      };

      const searchOptions = {
        maxPages: parseInt(opts.maxPages, 10),
        porPagina: parseInt(opts.porPagina, 10),
        // o download do inteiro teor reaproveita os cookies do Cloudflare:
        // a sessao precisa sobreviver a busca
        keepOpen: !!opts.fetchInteiroTeor,
      };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query || '', filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let downloaded = null;
      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading full text for ${results.length} results...`);
        downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        log(`Files saved to: ${outputDir}`);
      }
      await crawler.close();

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} julgados contra a base...`);
        const checker = new STJChecker({ headless, log });
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(JSON.stringify({
          success: true,
          totalResults: results.totalResults || null,
          count: results.length,
          baseAplicada: results.baseAplicada,
          orgaosAplicados: results.orgaosAplicados,
          // a expressao que o SCON montou no servidor — sem `inpath (org)` o
          // filtro de orgao nao pegou; sem `@dtde` a data nao pegou
          expressaoServidor: results.expressaoServidor || null,
          ...(results.aviso ? { aviso: results.aviso } : {}),
          output: outputPath,
          ...(downloaded ? {
            downloaded: downloaded.filter((d) => d.arquivo).length,
            failed: downloaded.filter((d) => !d.arquivo).length,
            outputDir: path.resolve(opts.outputDir),
          } : {}),
          ...(verificacao ? { verificacao } : {}),
        }) + '\n');
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program.parse();
