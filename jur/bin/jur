        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nGravacao concluida: ${successCount} arquivo(s), ${failCount} falha(s)`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjba')
  .description('Search TJBA (Tribunal de Justica da Bahia) jurisprudence — GraphQL publico, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores: AND, OR, NOT, "frase exata", curinga * — NAO use E/OU/NAO)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (TJBAChecker); dispensa -q')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  // O TJBA so tem filtro de PUBLICACAO: dataJulgamento volta no resultado mas
  // nao e filtravel. -di/-df ficam como alias explicito (e avisado) para nao
  // quebrar a convencao do repo nem o smoke.
  .option('-di, --data-inicio <date>', 'Alias de -dpi — o TJBA so filtra por PUBLICACAO')
  .option('-df, --data-fim <date>', 'Alias de -dpf — o TJBA so filtra por PUBLICACAO')
  .option('--origem <origem>', 'comum (2º grau, default) | turmas (Turmas Recursais) | ambas', 'comum')
  .option('-t, --tipo <tipo>', 'todos (default) | acordao | monocratica (nao compoe com --origem)', 'todos')
  .option('-p, --processo <numero>', 'Filtro por numero de processo DENTRO da busca (use -n p/ consulta direta)')
  .option('-r, --relator <nome>', 'Relator(a) — NOME exato (a API rejeita id; use --listar-filtros)')
  .option('-oj, --orgao <ids>', 'Orgao(s) julgador(es) — ids separados por virgula')
  .option('-c, --classe <ids>', 'Classe(s) processual(is) — ids separados por virgula')
  .option('--listar-filtros', 'Lista orgaos, relatores e classes disponiveis e sai')
  .option('-ord, --ordem <ordem>', 'publicacao (default) — o TJBA nao ordena por relevancia', 'publicacao')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (50 registros/pagina)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjba.json')
  .option('--fetch-inteiro-teor', 'Grava o inteiro teor (ja vem na busca — sem request extra)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjba')
  .option('-v, --visible', 'Ignored (TJBA usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJBA usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJBAChecker().consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const TJBANavigator = require('../src/TJBANavigator');
        const c = await new TJBANavigator().combos();
        const out = {
          orgaosSegundoGrau: c.findAllOrgaosJulgadoresGroupByInstancia.orgaosJulgadoresSegundoGrau,
          orgaosTurmaRecursal: c.findAllOrgaosJulgadoresGroupByInstancia.orgaosJulgadoresTurmaRecursal,
          relatoresSegundoGrau: c.findAllRelatoresGroupByInstancia.relatoresSegundoGrau,
          relatoresTurmaRecursal: c.findAllRelatoresGroupByInstancia.relatoresTurmaRecursal,
          classes: c.findAllClasses,
        };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...out }) + '\n');
        else console.log(JSON.stringify(out, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.processo) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      log('='.repeat(60));
      log('TJBA Jurisprudencia Crawler (GraphQL publico, HTTP direto, sem browser)');
      log('ESCOPO: 2º grau + Turmas Recursais. Cobre Projudi e PJe. NAO tem 1º grau.');
      log('ATENCAO: o texto do resultado e o INTEIRO TEOR, nao a ementa — nao existe');
      log('campo de ementa separado nesta base.');
      log('ATENCAO: NAO EXISTE PERMALINK. Verificacao de julgado e por reconsulta (-n).');
      log('='.repeat(60));
      const dpi = opts.dataPubInicio || opts.dataInicio || null;
      const dpf = opts.dataPubFim || opts.dataFim || null;
      if ((opts.dataInicio || opts.dataFim) && !opts.dataPubInicio && !opts.dataPubFim) {
        log('AVISO: no TJBA so existe filtro de PUBLICACAO — -di/-df foram tratados ' +
            'como -dpi/-dpf. A data de julgamento vem no resultado mas nao e filtravel.');
      }

      log(`Query: ${opts.query || '-'}`);
      log(`Data Publicacao: ${dpi || '-'} a ${dpf || '-'}`);
      log(`Origem: ${opts.origem} | Tipo: ${opts.tipo}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJBACrawler({
        timeout: 90000,
        log,
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        origem: opts.origem,
        tipo: opts.tipo,
        processo: opts.processo || null,
        // ⚠️ relator vai por NOME (a API devolve 0 em silencio se receber id);
        // orgao e classe vao por ID.
        relatores: opts.relator ? [opts.relator] : null,
        orgaos: opts.orgao ? String(opts.orgao).split(',').map(s => s.trim()).filter(Boolean) : null,
        classes: opts.classe ? String(opts.classe).split(',').map(s => s.trim()).filter(Boolean) : null,
        ordem: opts.ordem,
        dataPublicacaoInicio: dpi,
        dataPublicacaoFim: dpf,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJBAChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJBA : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nGravando ${results.length} inteiros teores (ja vieram na busca)...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nGravacao concluida: ${successCount} arquivo(s), ${failCount} falha(s)`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjpe')
  .description('Search TJPE (Tribunal de Justica de Pernambuco) jurisprudence — API REST publica, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores em PORTUGUES: E, OU, NAO, PROX, "frase exata" — NAO use AND/OR/NOT)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (TJPEChecker); dispensa -q')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('--origem <origem>', 'ambas (default) | comum (2º grau) | turmas (Turmas Recursais) — recorte no cliente', 'ambas')
  .option('--meio <meio>', 'ambos (default) | eletronico | fisico — meio de tramitacao', 'ambos')
  .option('-t, --tipo <tipo>', 'todos (default) | acordao | monocratica', 'todos')
  .option('-p, --processo <numero>', 'Filtro por numero de processo DENTRO da busca (use -n p/ consulta direta)')
  .option('-r, --relator <nome>', 'Relator(a) — NOME exato (use --listar-filtros)')
  .option('-c, --classe <codigos>', 'Classe(s) CNJ — codigos separados por virgula')
  .option('-a, --assunto <codigos>', 'Assunto(s) CNJ — codigos separados por virgula')
  .option('--listar-filtros', 'Lista relatores, classes, assuntos e unidades judiciais e sai')
  .option('--verificar [amostra]', 'Audita N resultados reconsultando por numero (default 5)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (100 registros/pagina)', 10)
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjpe.json')
  .option('--fetch-inteiro-teor', 'Grava o inteiro teor (ja vem na busca — sem request extra)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjpe')
  .option('-v, --visible', 'Ignored (TJPE usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJPE usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJPEChecker().consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const TJPENavigator = require('../src/TJPENavigator');
        const nav = new TJPENavigator();
        const [relatores, classes, assuntos, unidades] = await Promise.all([
          nav.relatores(), nav.classes(), nav.assuntos(), nav.unidadesJudiciais(),
        ]);
        const out = { relatores, classes, assuntos, unidadesJudiciais: unidades };
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...out }) + '\n');
        else console.log(JSON.stringify(out, null, 2));
        process.exit(0);
      }

      if (!opts.query && !opts.processo) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta)');
      }

      log('='.repeat(60));
      log('TJPE Jurisprudencia Crawler (API REST publica, HTTP direto, sem browser)');
      log('ESCOPO: 2º grau + Turmas Recursais (PJe e Projudi). NAO tem 1º grau.');
      log('ATENCAO: a ementa e o INTEIRO TEOR vem juntos na busca, sem captcha.');
      log('ATENCAO: NAO EXISTE PERMALINK por documento. Verificacao e por reconsulta (-n).');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Origem: ${opts.origem} | Tipo: ${opts.tipo} | Meio: ${opts.meio}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJPECrawler({
        timeout: 90000,
        log,
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        origem: opts.origem,
        meio: opts.meio,
        tipo: opts.tipo,
        processo: opts.processo || null,
        relator: opts.relator || null,
        classe: opts.classe || null,
        assunto: opts.assunto || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
      };

      const results = await crawler.search(opts.query || '', filters, {
        maxPages: parseInt(opts.maxPages, 10),
        maxResults: opts.maxResults ? parseInt(opts.maxResults, 10) : undefined,
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJPEChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = {
        totalResults: crawler.ultimaBusca ? crawler.ultimaBusca.totalTJPE : null,
        ...crawler.ultimaBusca,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nGravando ${results.length} inteiros teores (ja vieram na busca)...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nGravacao concluida: ${successCount} arquivo(s), ${failCount} falha(s)`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: successCount,
            failed: failCount, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjpi')
  .description('Search TJPI (Tribunal de Justica do Piaui) jurisprudence — portal JusPI, HTTP direto, sem browser')
  .option('-q, --query <text>', 'Search query (operadores em PORTUGUES: E, OU, NAO acentuado, "frase exata", parenteses — AND/OR/NOT ZERAM)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo (TJPIChecker aplica o contorno); dispensa -q')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY) — use JUNTO com -dpf')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY) — use JUNTO com -dpi')
  // O TJPI SO tem data de publicacao: nao existe data de julgamento na base
  // (nem campo, nem filtro). -di/-df ficam como alias para nao quebrar o
  // contrato comum do repo — e o crawler avisa que a janela e de publicacao.
  .option('-di, --data-inicio <date>', 'Alias de -dpi — o TJPI so tem data de PUBLICACAO')
  .option('-df, --data-fim <date>', 'Alias de -dpf — o TJPI so tem data de PUBLICACAO')
  .option('-t, --tipo <tipo>', 'todos (default) | acordao | terminativa | sumula', 'todos')
  .option('--origem <origem>', 'ambas (default) | comum | turmas — recorte no cliente pelo orgao', 'ambas')
  .option('-r, --relator <nome>', 'Relator(a) — NOME exato do combo (use --listar-filtros)')
  .option('-c, --classe <classe>', 'Classe judicial — NOME exato do combo')
  .option('-oj, --orgao <orgao>', 'Orgao julgador colegiado — NOME exato do combo')
  .option('--listar-filtros', 'Lista relatores, classes, orgaos e tipos e sai')
  .option('--verificar [amostra]', 'Audita N resultados reabrindo o permalink publico (default 3)')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (25 registros/pagina, FIXO)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjpi.json')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor (1 GET por documento, pelo permalink)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/tjpi')
  .option('-v, --visible', 'Ignored (TJPI usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJPI usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.numero) {
        const res = await new TJPIChecker({ log }).consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (opts.listarFiltros) {
        const combos = require('../human-codegen/TJPI/01-juspi/combos.json');
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...combos }) + '\n');
        else console.log(JSON.stringify(combos, null, 2));
        process.exit(0);
      }

      if (!opts.query) throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta por processo)');

      log('='.repeat(60));
      log('TJPI Jurisprudencia Crawler (portal JusPI, HTTP direto, sem browser)');
      log('ESCOPO: 2º grau (acordao, decisao terminativa e sumula). NAO tem 1º grau.');
      log('ATENCAO: a base so tem DATA DE PUBLICACAO — nao ha data de julgamento.');
      log('ATENCAO: a ementa integra e a citacao oficial ja vem na busca, sem captcha.');
      log('OK: existe PERMALINK publico por documento (/jurisprudences/<id>/public).');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data Publicacao: ${opts.dataPubInicio || opts.dataInicio || '-'} a ${opts.dataPubFim || opts.dataFim || '-'}`);
      log(`Tipo: ${opts.tipo} | Origem: ${opts.origem} | Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJPICrawler({
        timeout: 90000,
        log,
        includeFullText: !!opts.fetchInteiroTeor,
      });
      const filters = {
        tipo: opts.tipo,
        origem: opts.origem,
        relator: opts.relator || null,
        classe: opts.classe || null,
        orgao: opts.orgao || null,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total no servidor: ${results.totalResults} (exato) | coletados: ${results.length}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 3 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados pelo permalink publico...`);
        verificacao = await new TJPIChecker({ log }).verificarAmostra(results, amostra);
        log(`Verificacao: ${verificacao.filter(v => v.ok).length}/${verificacao.length} confirmados`);
      }

      const resumo = {
        totalResults: results.totalResults,
        totalExato: results.totalExato,
        paginasLidas: results.paginasLidas,
        porPagina: results.porPagina,
        avisos: results.avisos,
        ...(verificacao ? { verificacao } : {}),
      };

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        fs.mkdirSync(outputDir, { recursive: true });
        let ok = 0; let fail = 0;
        for (const r of results) {
          if (r.inteiroTeor && r.inteiroTeor.length > 0) {
            fs.writeFileSync(path.join(outputDir, `${r.id}.txt`), r.inteiroTeor, 'utf-8');
            ok++;
          } else fail++;
        }
        log(`\nGravacao concluida: ${ok} arquivo(s), ${fail} falha(s)`);
        log(`Files saved to: ${outputDir}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, downloaded: ok, failed: fail, outputDir, ...resumo,
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true, count: results.length, output: outputPath, ...resumo,
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjpa')
  .description('Search TJPA (Tribunal de Justica do Para) jurisprudence')
  .option('-q, --query <text>', 'Search query (operadores nativos: OU, E, NAO, "expressao exata")')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ ou numero do acordao/decisao')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('-r, --relator <names>', 'Relator name(s), comma-separated (exact names from /filtros)')
  .option('-oj, --orgao <orgao>', 'Orgao Julgador Colegiado (ex: "1ª Câmara Cível Isolada")')
  .option('-c, --classe <classe>', 'Case class')
  .option('-a, --assunto <assunto>', 'Subject')
  .option('--origem <origem>', 'Origin: tjpa (default), turmas, ambas', 'tjpa')
  .option('-t, --tipo <tipo>', 'Document type: acordao, monocratica, ambos', 'ambos')
  .option('--escopo <escopo>', 'Search scope: ementa (default) or inteiroTeor', 'ementa')
  .option('--tipo-consulta <tc>', 'Query type: free (Formato Livre, default) or anywords (Qualquer Palavra)', 'free')
  .option('-ord, --ordenacao <tipo>', 'Sort: relevancia (default), recentes, antigos', 'relevancia')
  .option('--full-text', 'Include inteiro teor text in the JSON results')
  .option('--fetch-inteiro-teor', 'Download full text of each result as .txt files')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjpa')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjpa.json')
  .option('-v, --visible', 'Ignored (TJPA uses direct API, no browser)')
  .option('--headed', 'Ignored (TJPA uses direct API, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modo consulta direta por numero (TJPAChecker)
      if (opts.numero) {
        const checker = new TJPAChecker();
        const digits = opts.numero.replace(/\D/g, '');
        const res = digits.length >= 14
          ? await checker.consultarProcesso(opts.numero)
          : await checker.consultarDocumento(opts.numero);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" para pesquisa livre ou -n <numero> para consulta direta');
      }

      log('='.repeat(60));
      log('TJPA Jurisprudencia Crawler (API direta)');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Origem: ${opts.origem} | Tipo: ${opts.tipo} | Escopo: ${opts.escopo}`);
      log(`Relator: ${opts.relator || '-'} | Orgao: ${opts.orgao || '-'}`);
      log(`Max Pages: ${opts.maxPages} | Ordenacao: ${opts.ordenacao}`);
      log('='.repeat(60));

      const crawler = new TJPACrawler({
        timeout: 60000,
        includeFullText: !!opts.fullText,
        log,
      });

      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        origem: opts.origem,
        tipo: opts.tipo,
        escopo: opts.escopo,
        tipoConsulta: opts.tipoConsulta,
        ordenacao: opts.ordenacao,
        classe: opts.classe || null,
        assunto: opts.assunto || null,
        relatores: opts.relator ? opts.relator.split(',').map(r => r.trim()) : null,
        orgaoJulgadorColegiado: opts.orgao || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      if (jsonMode) {
        // silencia logs internos do crawler em modo JSON
        const origLog = console.log;
        console.log = () => {};
        var results = await crawler.search(opts.query, filters, searchOptions);
        console.log = origLog;
      } else {
        var results = await crawler.search(opts.query, filters, searchOptions);
      }

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJPAChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading inteiro teor for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjce')
  .description('Search TJCE (Ceara) jurisprudence — SJURIS (API direta, SAJ + PJe juntos)')
  .option('-q, --query <text>', 'Search query (operadores do portal: e, ou, nao, "frase", ~, $, ?)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ (TJCEChecker)')
  .option('--datajud', 'Com -n: confirma pelo DataJud do CNJ (prova o PROCESSO, nao a decisao)')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-b, --base <base>', 'Acervo: comum (2o grau, default), turmas (Turma Recursal), todos', 'comum')
  .option('-t, --tipo <tipo>', 'Document type: acordao, monocratica, sumula, ambos', 'ambos')
  .option('--origem <origem>', 'Sistema de origem: ambas (default), pje, saj', 'ambas')
  .option('-r, --relator <nome>', 'Relator(a)/magistrado(a) — nome exato (use --listar)')
  .option('-oj, --orgao <nome>', 'Orgao julgador — nome exato (use --listar)')
  .option('-c, --classe <nome>', 'Classe processual — nome exato')
  .option('-ord, --ordenacao <tipo>', 'Sort: relevancia (default), recentes', 'relevancia')
  .option('--listar', 'Lista o dominio dos filtros (orgao, tipo, classe, base, assunto) com contagens')
  .option('--full-text', 'Inclui o inteiro teor no JSON de resultados (ja vem na busca, sem custo extra)')
  .option('--fetch-inteiro-teor', 'Grava o inteiro teor de cada resultado como .txt')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjce')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 resultados/pagina, teto da API)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjce.json')
  .option('-v, --visible', 'Ignored (TJCE uses direct API, no browser)')
  .option('--headed', 'Ignored (TJCE uses direct API, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.listar) {
        const crawler = new TJCECrawler({ log });
        const filtros = await crawler.listarFiltros();
        process.stdout.write(JSON.stringify(filtros, null, jsonMode ? 0 : 2) + '\n');
        process.exit(0);
      }

      // Modo consulta direta por numero (TJCEChecker)
      if (opts.numero) {
        const checker = new TJCEChecker({ log });
        const res = opts.datajud
          ? await checker.consultarDataJud(opts.numero)
          : await checker.consultarProcesso(opts.numero);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" para pesquisa livre ou -n <numero> para consulta direta');
      }

      log('='.repeat(60));
      log('TJCE Jurisprudencia Crawler — SJURIS (API direta)');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Base: ${opts.base} | Tipo: ${opts.tipo} | Origem: ${opts.origem}`);
      log(`Relator: ${opts.relator || '-'} | Orgao: ${opts.orgao || '-'}`);
      log(`Max Pages: ${opts.maxPages} | Ordenacao: ${opts.ordenacao}`);
      log('='.repeat(60));

      const crawler = new TJCECrawler({
        timeout: 60000,
        // o inteiro teor ja vem na busca: gravar em disco nao custa request extra
        includeFullText: !!opts.fullText || !!opts.fetchInteiroTeor,
        log,
      });

      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        base: opts.base,
        tipo: opts.tipo,
        origem: opts.origem,
        ordenacao: opts.ordenacao,
        relator: opts.relator || null,
        orgaoJulgador: opts.orgao || null,
        classe: opts.classe || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query, filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJCEChecker({ log });
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nGravando inteiro teor de ${results.length} resultados...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nGravacao completa: ${successCount} ok, ${failCount} falhas`);
        log(`Arquivos em: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(results.avisos?.length ? { avisos: results.avisos } : {}),
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            ...(results.avisos?.length ? { avisos: results.avisos } : {}),
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjdft')
  .description('Search TJDFT (DF e Territorios) jurisprudence — JurisDF (API PUBLICA OFICIAL)')
  .option('-q, --query <text>', 'Search query (operadores: E OU NAO "frase" $ PROX<n> ADJ<n>; PROX/ADJ SEM parenteses)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ (TJDFTChecker)')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY) — exige -df junto')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY) — exige -di junto')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY) — exige -dpf junto')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY) — exige -dpi junto')
  .option('-b, --acervo <acervo>', 'Acervo: todos (default), acordaos, turmas, comum, decisoes, monocraticas, presidencia, sumulas, informativos, foco', 'todos')
  .option('--escopo <escopo>', 'Onde buscar: espelho (default, = ementa), inteiroTeor, ambos', 'espelho')
  .option('--sinonimos', 'Liga a expansao por sinonimos do portal')
  .option('-r, --relator <nome>', 'Relator(a) — nome exato (use --listar)')
  .option('-rev, --revisor <nome>', 'Revisor(a) — nome exato')
  .option('-oj, --orgao <nome>', 'Orgao julgador — nome exato (use --listar)')
  .option('-c, --classe <nome>', 'Classe processual CNJ — nome exato')
  .option('--listar', 'Lista o dominio dos filtros (relator, revisor, orgao, base, classe) com contagens')
  .option('--fetch-inteiro-teor', 'Grava o inteiro teor de cada resultado como .txt')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjdft')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (max 30 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjdft.json')
  .option('-v, --visible', 'Ignored (TJDFT uses direct API, no browser)')
  .option('--headed', 'Ignored (TJDFT uses direct API, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      if (opts.listar) {
        const nav = new TJDFTNavigator({ log });
        const ag = await nav.agregacoes(opts.query || 'a');
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, agregacoes: ag }) + '\n');
        } else {
          for (const [campo, vals] of Object.entries(ag)) {
            console.log(`\n[${campo}] ${vals.length} valores`);
            for (const v of vals.slice(0, 400)) {
              console.log(`  ${String(v.total).padStart(8)}  ${v.nome}${v.filhos && v.filhos.length ? ` (filhos: ${v.filhos.map((f) => f.nome).join(', ')})` : ''}`);
            }
          }
        }
        process.exit(0);
      }

      if (opts.numero) {
        const res = await new TJDFTChecker().consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>", -n <numero> para consulta direta, ou --listar');
      }

      log('='.repeat(60));
      log('TJDFT Jurisprudencia Crawler (JurisDF — API publica oficial)');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Acervo: ${opts.acervo} | Escopo: ${opts.escopo} | Sinonimos: ${!!opts.sinonimos}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log('='.repeat(60));

      const crawler = new TJDFTCrawler({ timeout: 60000, log });
      const filters = {
        acervo: opts.acervo,
        escopo: opts.escopo,
        sinonimos: !!opts.sinonimos,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        relator: opts.relator || null,
        revisor: opts.revisor || null,
        orgao: opts.orgao || null,
        classe: opts.classe || null,
      };
      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query, filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults !== null) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJDFTChecker({ navigator: crawler.navigator })
          .verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const resumo = (extra) => ({
        success: true,
        totalResults: results.totalResults,
        count: results.length,
        juizado: results.filter((r) => r.juizado).length,
        ...(results.avisos && results.avisos.length ? { avisos: results.avisos } : {}),
        ...(verificacao ? { verificacao } : {}),
        ...extra,
      });

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nGravando inteiro teor de ${results.length} resultados...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const ok = downloaded.filter((r) => r.arquivo).length;
        log(`\nDownload complete: ${ok} success, ${downloaded.length - ok} failed`);
        if (jsonMode) {
          process.stdout.write(JSON.stringify(resumo({ downloaded: ok, failed: downloaded.length - ok, outputDir })) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);
        if (jsonMode) process.stdout.write(JSON.stringify(resumo({ output: outputPath })) + '\n');
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjmg')
  .description('Search TJMG (Tribunal de Justica de Minas Gerais) jurisprudence — Consulta Unificada (API direta)')
  .option('-q, --query <text>', 'Search query (operadores Elasticsearch: + | - "frase" ( ) * ~ ; E/OU/NAO em portugues sao IGNORADOS)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ (TJMGChecker)')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('-t, --tipo <tipo>', 'Tipo de documento: todos (default), acordao, monocratica, turmas, vice, comum', 'todos')
  .option('--escopo <escopo>', 'Search scope: ementa (default) or inteiroTeor', 'ementa')
  // SEPARADOR E PONTO-E-VIRGULA, nao virgula: 18 dos 575 orgaos julgadores tem
  // virgula no nome (todos de Turma Recursal). Ver CLAUDE-TJMG.md §2.
  .option('-com, --comarca <nomes>', 'Comarca(s), separadas por PONTO-E-VIRGULA (use --listar comarcas)')
  .option('-oj, --orgao <nomes>', 'Orgao(s) julgador(es), separados por PONTO-E-VIRGULA (use --listar orgaosJulgadores)')
  .option('-mag, --magistrado <nomes>', 'Magistrado(s), separados por PONTO-E-VIRGULA (use --listar magistrados)')
  .option('-c, --classe <nomes>', 'Classe(s) processual(is), separadas por PONTO-E-VIRGULA (use --listar classes)')
  .option('-a, --assunto <nomes>', 'Assunto(s), separados por PONTO-E-VIRGULA (use --listar assuntos)')
  .option('--sem-validar-filtros', 'Nao confere os nomes de comarca/orgao/magistrado/classe/assunto contra a API antes de buscar')
  .option('-ord, --ordenacao <tipo>', 'Sort: relevancia (default), recentes (publicacao), julgamento', 'relevancia')
  .option('--listar <dominio>', 'Lista um combo com contagens: tiposDocumento, classes, comarcas, orgaosJulgadores, magistrados, assuntos')
  .option('--fetch-inteiro-teor', 'Download full text of each result as .txt files')
  .option('--output-dir <dir>', 'Directory for downloaded inteiro teor files', './resultados/tjmg')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjmg.json')
  .option('-v, --visible', 'Ignored (TJMG uses direct API, no browser)')
  .option('--headed', 'Ignored (TJMG uses direct API, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    // ponto-e-virgula: os nomes dos orgaos julgadores contem virgula
    const lista = (s) => (s ? s.split(';').map((x) => x.trim()).filter(Boolean) : []);

    try {
      // Enumera um combo (tiposDocumento, comarcas, ...) com contagens
      if (opts.listar) {
        const nav = new TJMGNavigator({ log });
        const dominios = await nav.dominio(opts.listar);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, dominio: opts.listar, count: dominios.length, valores: dominios }) + '\n');
        } else {
          console.log(`${opts.listar}: ${dominios.length} valores\n`);
          for (const d of dominios) console.log(`  ${String(d.quantidade).padStart(9)}  ${d.dominio}`);
        }
        process.exit(0);
      }

      // Consulta direta por numero (TJMGChecker)
      if (opts.numero) {
        const checker = new TJMGChecker();
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error('Informe -q "<termos>" para pesquisa, -n <numero> para consulta direta, ou --listar <dominio>');
      }

      log('='.repeat(60));
      log('TJMG Jurisprudencia Crawler (Consulta Unificada, API direta)');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Tipo: ${opts.tipo} | Escopo: ${opts.escopo} | Ordenacao: ${opts.ordenacao}`);
      log(`Comarca: ${opts.comarca || '-'} | Orgao: ${opts.orgao || '-'} | Magistrado: ${opts.magistrado || '-'}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJMGCrawler({ timeout: 60000, log });

      const filters = {
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        tipo: opts.tipo,
        escopo: opts.escopo,
        ordenacao: opts.ordenacao,
        comarcas: lista(opts.comarca),
        orgaos: lista(opts.orgao),
        magistrados: lista(opts.magistrado),
        classes: lista(opts.classe),
        assuntos: lista(opts.assunto),
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      // um nome errado não daria erro na API — devolveria 0. Falhar aqui.
      if (!opts.semValidarFiltros) await crawler.validarFiltros(filters);

      const results = await crawler.search(opts.query, filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults !== null) {
        log(`Total results on server: ${results.totalResults}${results.totalResultsExato ? '' : '+ (contador saturado)'}`);
      }

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TJMGChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading inteiro teor for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter((r) => r.arquivo).length;
        const failCount = downloaded.filter((r) => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults,
            totalResultsExato: results.totalResultsExato,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(results.avisos && results.avisos.length ? { avisos: results.avisos } : {}),
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults,
            totalResultsExato: results.totalResultsExato,
            count: results.length,
            output: outputPath,
            ...(results.avisos && results.avisos.length ? { avisos: results.avisos } : {}),
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjgo')
  .description('Search TJGO (Tribunal de Justica de Goias) jurisprudence — Novo Modulo PROJUDI')
  .option('-q, --query <text>', 'Search query (aspas duplas = frase exata; palavras soltas = E implicito)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo CNJ (TJGOChecker)')
  .option('-i, --instancia <inst>', 'Instancia: todas (default), 1grau, turmas, tribunal', 'todas')
  .option('-a, --area <area>', 'Area: todas (default), civel, criminal', 'todas')
  .option('-om, --orgao-materia <nome>', 'Orgao/Materia (nome ou codigo; use --listar-orgaos)')
  .option('-u, --unidade <nome>', 'Unidade especifica (serventia; resolvida pela lupa)')
  .option('-mag, --magistrado <nome>', 'Magistrado(a) (resolvido pela lupa)')
  .option('-ta, --tipo-ato <nome>', 'Tipo de Ato: Acordao, Ementa, Sentenca, Decisao, Decisao Monocratica, ...')
  .option('-p, --processo <numero>', 'Filtro por numero do processo (dentro da busca)')
  .option('-di, --data-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--listar-orgaos', 'Lista as opcoes do combo Orgao/Materia e sai')
  .option('--listar-tipos-ato', 'Lista os Tipos de Ato disponiveis e sai')
  .option('--unidades <termo>', 'Consulta a lupa de serventias por termo e sai')
  .option('--magistrados <termo>', 'Consulta a lupa de magistrados por termo e sai')
  .option('--full-text', 'Include full decision text in the JSON results')
  .option('--fetch-inteiro-teor', 'Save full text of each result as .txt files (sem novo acesso a rede)')
  .option('--output-dir <dir>', 'Directory for saved full-text files', './resultados/tjgo')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (50 results/page)', 10)
  .option('--qtde <n>', 'Results per page: 10, 20 or 50', '50')
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjgo.json')
  .option('-v, --visible', 'Ignored (TJGO uses direct HTTP, no browser)')
  .option('--headed', 'Ignored (TJGO uses direct HTTP, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modos utilitarios de listagem (lupas / combo embutido)
      if (opts.listarOrgaos) {
        const lista = TJGONavigator.ORGAOS_MATERIA;
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, orgaosMateria: lista }) + '\n');
        else console.table(lista.map(o => ({ codigo: o.codigo, descricao: o.descricao, area: o.areaId, instancia: o.servTipoId })));
        process.exit(0);
      }
      if (opts.listarTiposAto) {
        const lista = TJGONavigator.TIPOS_ATO;
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, tiposAto: lista }) + '\n');
        else console.table(lista);
        process.exit(0);
      }
      if (opts.unidades !== undefined || opts.magistrados !== undefined) {
        const navigator = new TJGONavigator();
        const res = opts.unidades !== undefined
          ? await navigator.consultarServentias(opts.unidades)
          : await navigator.consultarMagistrados(opts.magistrados);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else {
          console.log(`Total na base: ${res.total} (mostrando ${res.itens.length})`);
          console.table(res.itens);
        }
        process.exit(0);
      }

      // Modo consulta direta por numero (TJGOChecker)
      if (opts.numero) {
        const checker = new TJGOChecker();
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.magistrado && !opts.unidade) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -p/-mag/-u)');
      }

      log('='.repeat(60));
      log('TJGO Jurisprudencia Crawler (HTTP direto, Novo Modulo PROJUDI)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Instancia: ${opts.instancia} | Area: ${opts.area} | Orgao/Materia: ${opts.orgaoMateria || '-'}`);
      log(`Unidade: ${opts.unidade || '-'} | Magistrado: ${opts.magistrado || '-'} | Tipo de Ato: ${opts.tipoAto || '-'}`);
      log(`Processo: ${opts.processo || '-'}`);
      log(`Data Publicacao: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Max Pages: ${opts.maxPages} (${opts.qtde}/pagina)`);
      log('='.repeat(60));

      const crawler = new TJGOCrawler({
        timeout: 60000,
        pageSize: parseInt(opts.qtde, 10),
        includeFullText: !!opts.fullText || !!opts.fetchInteiroTeor,
        log,
      });

      const filters = {
        instancia: opts.instancia,
        area: opts.area,
        orgaoMateria: opts.orgaoMateria || null,
        serventia: opts.unidade || null,
        magistrado: opts.magistrado || null,
        tipoAto: opts.tipoAto || null,
        processo: opts.processo || null,
        dataPublicacaoInicio: opts.dataInicio || null,
        dataPublicacaoFim: opts.dataFim || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      if (jsonMode) {
        const origLog = console.log;
        console.log = () => {};
        var results = await crawler.search(opts.query, filters, searchOptions);
        console.log = origLog;
      } else {
        var results = await crawler.search(opts.query, filters, searchOptions);
      }

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJGOChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nSaving full text for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nSave complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjrs')
  .description('Search TJRS (Tribunal de Justica do Rio Grande do Sul) jurisprudence')
  .option('-q, --query <text>', 'Pesquisa livre (AND implicito; OR maiusculo; -palavra exclui; "frase exata")')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (CNJ ou legado) — usa o TJRSChecker')
  .option('--origem <origem>', 'DESAMBIGUACAO: comum (Justica Comum, default), turmas (Turmas Recursais/Juizados), alcada, exceto-turmas, todas', 'comum')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--escopo <escopo>', 'Search scope: ementa (default) or inteiroTeor', 'ementa')
  .option('-s, --secao <secao>', 'Secao: civel, crime, ambas, todas (default)', 'todas')
  .option('-t, --tipo <tipos>', 'Tipo(s) de decisao, virgula: acordao, monocratica, admissibilidade, duvida')
  .option('-oj, --orgao <nome>', 'Orgao julgador (nome ou codigo; exige --origem comum|turmas|alcada)')
  .option('-r, --relator <nome>', 'Relator/redator (nome ou codigo)')
  .option('-cp, --classe-processual <nome>', 'Classe processual, ex.: "Apelacao Civel", "Recurso Inominado"')
  .option('-cc, --classe-cnj <nome>', 'Classe CNJ (nome ou codigo)')
  .option('-ac, --assunto-cnj <nome>', 'Assunto CNJ (depende de --classe-cnj)')
  .option('--comarca <nome>', 'Comarca de origem, ex.: "PORTO ALEGRE"')
  .option('-p, --processo <numero>', 'Filtro por numero do processo DENTRO da busca (use -n para consulta direta)')
  .option('--expressao <texto>', 'Campo "com a expressao" (frase exata)')
  .option('--qualquer <texto>', 'Campo "com qualquer uma das palavras" (OU)')
  .option('--sem <texto>', 'Campo "sem as palavras" (exclusao)')
  .option('--ref-legislativa <texto>', 'Referencia legislativa (acervo legado)')
  .option('-ord, --ordenacao <tipo>', 'Sort by judgment date: recentes (default) or antigos', 'recentes')
  .option('--listar-tribunais', 'Lista o combo Tribunal (a desambiguacao) e sai')
  .option('--listar-orgaos', 'Lista os orgaos julgadores da --origem escolhida e sai')
  .option('--listar-relatores', 'Lista os relatores/redatores da --origem escolhida e sai')
  .option('--listar-classes-processuais', 'Lista as classes processuais da --origem escolhida e sai')
  .option('--listar-classes-cnj', 'Lista as classes CNJ e sai')
  .option('--full-text', 'Inclui o inteiro teor no JSON dos resultados')
  .option('--fetch-inteiro-teor', 'Grava o inteiro teor de cada resultado em .txt (sem novo acesso a rede)')
  .option('--output-dir <dir>', 'Directory for saved full-text files', './resultados/tjrs')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (10 resultados/pagina, fixo no servidor)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjrs.json')
  .option('-v, --visible', 'Ignored (TJRS uses direct HTTP, no browser)')
  .option('--headed', 'Ignored (TJRS uses direct HTTP, no browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // Modos utilitarios de listagem dos combos
      const listagens = {
        listarTribunais: ['tribunais', (nav) => nav.listarTribunais()],
        listarOrgaos: ['orgaosJulgadores', (nav, cod) => nav.listarOrgaosJulgadores(cod)],
        listarRelatores: ['relatores', (nav, cod) => nav.listarRelatores(cod)],
        listarClassesProcessuais: ['classesProcessuais', (nav, cod) => nav.listarTiposDeProcessos(cod)],
        listarClassesCnj: ['classesCnj', (nav) => nav.listarClassesCNJ()],
      };
      for (const [flag, [chave, fn]] of Object.entries(listagens)) {
        if (!opts[flag]) continue;
        const nav = new TJRSNavigator({ log });
        const cod = TJRSNavigator.TRIBUNAIS[
          { comum: 'comum', turmas: 'turmas', alcada: 'alcada', todas: 'todas', 'exceto-turmas': 'exceto-turmas' }[opts.origem] || 'comum'
        ];
        const lista = await fn(nav, cod);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, [chave]: lista }) + '\n');
        else console.table(lista);
        process.exit(0);
      }

      // Modo consulta direta por numero (TJRSChecker) — a verificacao de um julgado
      if (opts.numero) {
        const checker = new TJRSChecker();
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.expressao && !opts.qualquer && !opts.relator && !opts.orgao) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -p/-r/-oj/--expressao)');
      }

      log('='.repeat(60));
      log('TJRS Jurisprudencia Crawler (HTTP direto, Solr via ajax.php)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Origem (Tribunal): ${opts.origem}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Escopo: ${opts.escopo} | Secao: ${opts.secao} | Tipo: ${opts.tipo || 'todos'}`);
      log(`Orgao: ${opts.orgao || '-'} | Relator: ${opts.relator || '-'}`);
      log(`Classe processual: ${opts.classeProcessual || '-'} | Classe CNJ: ${opts.classeCnj || '-'}`);
      log(`Max Pages: ${opts.maxPages} (10/pagina) | Ordenacao: ${opts.ordenacao}`);
      log('='.repeat(60));

      const crawler = new TJRSCrawler({
        timeout: 120000,
        includeFullText: !!opts.fullText,
        log,
      });

      const filters = {
        origem: opts.origem,
        dataJulgamentoInicio: opts.dataInicio || null,
        dataJulgamentoFim: opts.dataFim || null,
        dataPublicacaoInicio: opts.dataPubInicio || null,
        dataPublicacaoFim: opts.dataPubFim || null,
        escopo: opts.escopo,
        secao: opts.secao,
        tipos: opts.tipo ? opts.tipo.split(',').map(t => t.trim()).filter(Boolean) : [],
        orgaoJulgador: opts.orgao || null,
        relator: opts.relator || null,
        classeProcessual: opts.classeProcessual || null,
        classeCnj: opts.classeCnj || null,
        assuntoCnj: opts.assuntoCnj || null,
        comarca: opts.comarca || null,
        processo: opts.processo || null,
        expressao: opts.expressao || null,
        qualquerPalavra: opts.qualquer || null,
        semPalavras: opts.sem || null,
        referenciaLegislativa: opts.refLegislativa || null,
        ordenacao: opts.ordenacao,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query || '', filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        const checker = new TJRSChecker();
        verificacao = await checker.verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nSaving full text for ${results.length} results...`);
        const downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nSave complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            downloaded: successCount,
            failed: failCount,
            outputDir,
            filtroSolr: results.filtroSolr,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        // `raw` (docs crus do Solr, com o inteiro teor em base64) fica fora do JSON
        fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(JSON.stringify({
            success: true,
            totalResults: results.totalResults || null,
            count: results.length,
            output: outputPath,
            filtroSolr: results.filtroSolr,
            ...(verificacao ? { verificacao } : {}),
          }) + '\n');
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjma')
  .description('TJMA (Tribunal de Justica do Maranhao) — BUSCA BLOQUEADA por captcha; -n consulta processo via DataJud')
  .option('-q, --query <text>', 'Search query (BLOQUEADA: o JurisConsult exige captcha — ver CLAUDE-TJMA.md)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo CNJ (via DataJud/CNJ — FUNCIONA)')
  .option('--diagnostico', 'Checa ao vivo se o bloqueio de captcha do TJMA ainda existe')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY) — o TJMA so filtra por publicacao')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--foro <foro>', 'Foro: comum (default), turmas (Turmas Recursais), juizados (Juizado Especial)', 'comum')
  .option('-t, --tipo <tipo>', 'Tipo: acordao (default), monocratica, sentenca', 'acordao')
  .option('--relatorio <chave>', 'Relatorio explicito: acordaos, acordaos-tr, monocraticas, monocraticas-tr, sentencas, sentencas-je')
  .option('--condicao <cond>', 'Condicao dos termos (so relatorio Acordaos): e, ou, unico (default)', 'unico')
  .option('--frase-exata', 'Frase exata (nao existe no relatorio Acordaos)')
  .option('--sistema <sis>', 'Sistema de origem (so Acordaos): todos (default), themis, pje', 'todos')
  .option('-r, --relator <id>', 'Matricula do relator (ver human-codegen/TJMA/09-jurisconsult/03-magistrados.json)')
  .option('-oj, --orgao <id>', 'Id do orgao julgador (ver 03-orgaos-julgadores.json)')
  .option('-c, --classe <id>', 'Id da classe judicial (ver 03-classes.json)')
  .option('--comarca <id>', 'Id da comarca (so 1o grau — ver 03-comarcas.json)')
  .option('--vara <id>', 'Id da vara (so 1o grau)')
  .option('--verificar [amostra]', 'Audita N processos contra o DataJud (default 5)')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl (20 results/page)', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjma.json')
  .option('-v, --visible', 'Ignored (TJMA usa HTTP direto, sem browser)')
  .option('--headed', 'Ignored (TJMA usa HTTP direto, sem browser)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      // --- Diagnostico do bloqueio (nao precisa de captcha) ---
      if (opts.diagnostico) {
        const crawler = new TJMACrawler({ log });
        const diag = await crawler.diagnosticar();
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...diag }) + '\n');
        } else {
          console.log(JSON.stringify(diag, null, 2));
        }
        process.exit(0);
      }

      // --- Consulta por numero de processo (DataJud) — o que funciona ---
      if (opts.numero) {
        const checker = new TJMAChecker({ log });
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query) {
        throw new Error(
          'Informe -n <numero> para consultar um processo (funciona, via DataJud) '
          + 'ou --diagnostico para checar o bloqueio. A busca por termo (-q) esta '
          + 'bloqueada por captcha no TJMA — leia CLAUDE-TJMA.md.',
        );
      }

      log('='.repeat(60));
      log('TJMA Jurisprudencia (JurisConsult) — API direta');
      log('='.repeat(60));
      log(`Query: ${opts.query}`);
      log(`Foro: ${opts.foro} | Tipo: ${opts.tipo} | Relatorio: ${opts.relatorio || '(derivado)'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Max Pages: ${opts.maxPages}`);
      log('='.repeat(60));

      const crawler = new TJMACrawler({ timeout: 60000, log });

      const filters = {
        foro: opts.foro,
        tipo: opts.tipo,
        relatorio: opts.relatorio || null,
        dataInicio: opts.dataPubInicio || null,
        dataFim: opts.dataPubFim || null,
        condicao: opts.condicao,
        fraseExata: !!opts.fraseExata,
        sistema: opts.sistema,
        relator: opts.relator || null,
        orgao: opts.orgao || null,
        classe: opts.classe || null,
        comarca: opts.comarca || null,
        vara: opts.vara || null,
      };

      const searchOptions = { maxPages: parseInt(opts.maxPages, 10) };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query, filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra o DataJud...`);
        verificacao = await new TJMAChecker().verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(JSON.stringify({
          success: true,
          totalResults: results.totalResults || null,
          count: results.length,
          output: outputPath,
          ...(verificacao ? { verificacao } : {}),
        }) + '\n');
      }
    } catch (error) {
      const bloqueio = error instanceof TJMANavigator.CaptchaBloqueadoError
        ? { bloqueio: 'captcha', tribunal: 'TJMA', alternativa: 'TRF1 (MA e da 1a Regiao) para materia federal; nenhum TJ vizinho cobre jurisprudencia estadual do MA' }
        : {};
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message, ...bloqueio }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('tjrn')
  .description('TJRN (Rio Grande do Norte) — DOMINIO 403 (Akamai); -n consulta processo via DataJud')
  .option('-q, --query <text>', 'Search query (BLOQUEADA: todo o dominio do TJRN responde 403 — ver CLAUDE-TJRN.md)')
  .option('-n, --numero <numero>', 'Consulta por numero de processo CNJ (via DataJud/CNJ — FUNCIONA)')
  .option('--diagnostico', 'Checa ao vivo se o 403 do TJRN ainda existe')
  .option('--verificar [amostra]', 'Audita N processos de um JSON contra o DataJud (default 5)')
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-tjrn.json')
  .option('-v, --visible', 'Ignored (TJRN nao tem busca; o DataJud e HTTP direto)')
  .option('--headed', 'Ignored (TJRN nao tem busca; o DataJud e HTTP direto)')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    try {
      const checker = new TJRNChecker({ log });

      // --- Diagnostico do bloqueio (nao precisa de browser) ---
      if (opts.diagnostico) {
        if (!jsonMode) log('Medindo o bloqueio do TJRN ao vivo...');
        const diag = await checker.diagnosticar();
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...diag }) + '\n');
        } else {
          console.log(JSON.stringify(diag, null, 2));
        }
        process.exit(0);
      }

      // --- Consulta por numero de processo (DataJud) — o que funciona ---
      if (opts.numero) {
        const res = await checker.consultarProcesso(opts.numero);
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        } else {
          console.log(JSON.stringify(res, null, 2));
        }
        process.exit(res.encontrado ? 0 : 1);
      }

      // --- Auditoria de um JSON de resultados ---
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        const caminho = path.resolve(opts.output);
        const results = JSON.parse(fs.readFileSync(caminho, 'utf-8'));
        const verificacao = await checker.verificarResultados(results, { amostra, log });
        if (jsonMode) {
          process.stdout.write(JSON.stringify({ success: true, verificacao }) + '\n');
        } else {
          console.log(JSON.stringify(verificacao, null, 2));
        }
        process.exit(0);
      }

      throw new Error(
        'A busca por termo (-q) NAO existe no TJRN: todo o dominio publico do '
        + 'tribunal responde HTTP 403 (Access Denied do Akamai), inclusive o site '
        + 'institucional. Nao e captcha — nao ha o que resolver. Use -n <numero> '
        + 'para confirmar que um processo existe (via DataJud, funciona) ou '
        + '--diagnostico para checar se o bloqueio caiu. Leia CLAUDE-TJRN.md.',
      );
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({
          success: false,
          error: error.message,
          bloqueio: 'akamai-403',
          tribunal: 'TJRN',
          alternativa: 'TRF5 (RN e da 5a Regiao) para materia federal; nenhum TJ vizinho cobre jurisprudencia estadual do RN',
        }) + '\n');
        process.exit(1);
      }
      console.error('Erro:', error.message);
      process.exit(1);
    }
  });

