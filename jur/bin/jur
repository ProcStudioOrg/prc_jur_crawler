const program = new Command();

program
  .name('jur')
  .description('CLI for searching Brazilian court jurisprudence')
  .version('1.0.0');

program
  .command('trf4')
  .description('Search TRF4 (Tribunal Regional Federal da 4a Regiao) jurisprudence')
  .option('-q, --query <text>', 'Search query')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (CNJ) — usa o TRF4Checker (browser)')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--datajud', 'Com -n: consulta tambem o DataJud (CNJ) como fonte secundaria de metadados')
  .option('-di, --data-inicio <date>', 'Decision start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Decision end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--origem <tipo>', 'Origin: trf4 (default) or turmas-recursais', 'trf4')
  .option('--fetch-inteiro-teor', 'Download full text of each result')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/trf4')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-trf4.json')
  .option('--orgaos <orgaos>', 'Origin filter comma-separated: TRF4,TRU4,"Turmas Recursais","Varas Federais"')
  .option('-v, --visible', 'Show browser window (disable headless mode)')
  .option('--headed', 'Alias for --visible: show browser window for debugging')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    // Modo consulta direta por numero (TRF4Checker) — a verificacao de um julgado
    if (opts.numero) {
      try {
        const checker = new TRF4Checker({ log, headless: !(opts.visible || opts.headed) });
        const res = await checker.consultarProcesso(opts.numero, { datajud: !!opts.datajud });
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      } catch (error) {
        if (jsonMode) process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        else console.error('Erro na consulta:', error.message);
        process.exit(1);
      }
    }
    if (!opts.query) {
      const msg = 'Informe -q "<termos>" (ou -n <numero> para consulta direta)';
      if (jsonMode) { process.stdout.write(JSON.stringify({ success: false, error: msg }) + '\n'); process.exit(1); }
      console.error(msg);
      process.exit(1);
    }

    log('='.repeat(60));
    log('TRF4 Jurisprudencia Crawler');
    log('='.repeat(60));
    log(`Query: ${opts.query}`);
    log(`Origem: ${opts.origem}`);
    log(`Data Decisao Inicio: ${opts.dataInicio || 'not set'}`);
    log(`Data Decisao Fim: ${opts.dataFim || 'not set'}`);
    log(`Data Publicacao Inicio: ${opts.dataPubInicio || 'not set'}`);
    log(`Data Publicacao Fim: ${opts.dataPubFim || 'not set'}`);
    log(`Orgaos: ${opts.orgaos || 'all (default)'}`);
    log(`Max Pages: ${opts.maxPages}`);
    log(`Max Results: ${opts.maxResults || 'unlimited'}`);
    log(`Fetch Inteiro Teor: ${!!opts.fetchInteiroTeor}`);
    log(`Output: ${opts.fetchInteiroTeor ? opts.outputDir : opts.output}`);
    log(`Headless: ${!(opts.visible || opts.headed)}`);
    log('='.repeat(60));

    const headless = !(opts.visible || opts.headed);
    const crawler = new TRF4Crawler({
      headless,
      slowMo: headless ? 0 : 100,
      timeout: 60000,
      log, // com --json o stdout fica só com o resumo
    });

    try {
      const filters = {
        origem: opts.origem !== 'trf4' ? opts.origem : null,
        dataDecisaoInicio: opts.dataInicio || null,
        dataDecisaoFim: opts.dataFim || null,
        dataDisponibilizacaoInicio: opts.dataPubInicio || null,
        dataDisponibilizacaoFim: opts.dataPubFim || null,
        orgaos: opts.orgaos ? opts.orgaos.split(',').map(o => o.trim()) : null,
      };

      const searchOptions = {
        maxPages: parseInt(opts.maxPages, 10),
      };
      if (opts.maxResults) {
        searchOptions.maxResults = parseInt(opts.maxResults, 10);
      }

      const results = await crawler.search(opts.query, filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) {
        log(`Total results on server: ${results.totalResults}`);
      }

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando ${amostra} resultados contra a base (browser, uma sessão)...`);
        verificacao = await new TRF4Checker({ log }).verificarResultados(results, { amostra, log });
        log(`Verificação: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      if (opts.fetchInteiroTeor) {
        const { batchDownload } = require('../src/inteiroTeorFetcher');
        log(`\nDownloading inteiro teor for ${results.length} results...`);
        const outputDir = path.resolve(opts.outputDir);
        const downloaded = await batchDownload(results, outputDir, { log });

        const successCount = downloaded.filter(r => r.arquivo).length;
        const failCount = downloaded.filter(r => !r.arquivo).length;
        log(`\nDownload complete: ${successCount} success, ${failCount} failed`);
        log(`Files saved to: ${outputDir}`);

        if (jsonMode) {
          process.stdout.write(
            JSON.stringify({
              success: true,
              totalResults: results.totalResults || null,
              count: results.length,
              downloaded: successCount,
              failed: failCount,
              outputDir,
              ...(verificacao ? { verificacao } : {}),
            }) + '\n'
          );
        }
      } else {
        const outputPath = path.resolve(opts.output);
        fs.mkdirSync(path.dirname(outputPath), { recursive: true });
        fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
        log(`Results saved to: ${outputPath}`);

        if (jsonMode) {
          process.stdout.write(
            JSON.stringify({
              success: true,
              totalResults: results.totalResults || null,
              count: results.length,
              output: outputPath,
              ...(verificacao ? { verificacao } : {}),
            }) + '\n'
          );
        }
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('trf1')
  .description('Search TRF1 (Tribunal Regional Federal da 1a Regiao) jurisprudence')
  .requiredOption('-q, --query <text>', 'Search query')
  .option('-di, --data-inicio <date>', 'Start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'End date (DD/MM/YYYY)')
  .option('-td, --tipo-data <type>', 'Date type: DTDP (Julgamento) or DTPP (Publicacao)', 'DTDP')
  .option('-r, --relator <name>', 'Relator (Desembargador) name')
  .option('-oj, --orgao-julgador <orgao>', 'Judging body (ex: "PRIMEIRA TURMA")')
  .option('-c, --classe <classe>', 'Case class')
  .option('-n, --numero <numero>', 'Case number')
  .option('-t, --tipos <tipos>', 'Document types comma-separated: ACORDAO,SUMULA,ARGUICAO,DECISAOMONO', 'ACORDAO')
  .option('-f, --fontes <fontes>', 'Sources comma-separated: TRF1,JEF1', 'TRF1')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-trf1.json')
  .option('-v, --visible', 'Show browser window (disable headless mode)')
  .option('--headed', 'Alias for --visible: show browser window for debugging')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);

    log('='.repeat(60));
    log('TRF1 Jurisprudencia Crawler');
    log('='.repeat(60));
    log(`Query: ${opts.query}`);
    log(`Data Inicio: ${opts.dataInicio || 'not set'}`);
    log(`Data Fim: ${opts.dataFim || 'not set'}`);
    log(`Tipo Data: ${opts.tipoData}`);
    log(`Relator: ${opts.relator || 'not set'}`);
    log(`Orgao Julgador: ${opts.orgaoJulgador || 'not set'}`);
    log(`Classe: ${opts.classe || 'not set'}`);
    log(`Numero: ${opts.numero || 'not set'}`);
    log(`Tipos Documento: ${opts.tipos}`);
    log(`Fontes: ${opts.fontes}`);
    log(`Max Pages: ${opts.maxPages}`);
    log(`Output: ${opts.output}`);
    log(`Headless: ${!(opts.visible || opts.headed)}`);
    log('='.repeat(60));

    const headless = !(opts.visible || opts.headed);
    const crawler = new TRF1Crawler({
      headless,
      slowMo: headless ? 0 : 100,
      timeout: 60000,
    });

    try {
      const filters = {
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
        tipoData: opts.tipoData || null,
        relator: opts.relator || null,
        orgaoJulgador: opts.orgaoJulgador || null,
        classe: opts.classe || null,
        numero: opts.numero || null,
        tiposDocumento: opts.tipos ? opts.tipos.split(',').map(t => t.trim()) : null,
        fontes: opts.fontes ? opts.fontes.split(',').map(f => f.trim()) : null,
      };

      const results = await crawler.search(opts.query, filters, {
        maxPages: parseInt(opts.maxPages, 10),
      });

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(results, null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: true, count: results.length, output: outputPath }) + '\n'
        );
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(
          JSON.stringify({ success: false, error: error.message }) + '\n'
        );
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

program
  .command('trf2')
  .description('Search TRF2 (Tribunal Regional Federal da 2a Regiao - RJ/ES) jurisprudence via eproc-jur')
  .option('-q, --query <text>', 'Pesquisa livre. ATENCAO: neste portal o ESPACO quebra a busca — o crawler une os termos com hifen (ver CLAUDE-TRF2.md)')
  .option('-n, --numero <numero>', 'Consulta direta por numero de processo (CNJ) — usa o TRF2Checker')
  .option('--origem <origem>', 'DESAMBIGUACAO: trf2 (Justica Federal comum, default), turmas (Turmas Recursais/Juizados), tru, todas', 'trf2')
  .option('-di, --data-inicio <date>', 'Judgment start date (DD/MM/YYYY)')
  .option('-df, --data-fim <date>', 'Judgment end date (DD/MM/YYYY)')
  .option('-dpi, --data-pub-inicio <date>', 'Publication start date (DD/MM/YYYY)')
  .option('-dpf, --data-pub-fim <date>', 'Publication end date (DD/MM/YYYY)')
  .option('--escopo <escopo>', 'Search scope: inteiroTeor (default, igual ao site) or ementa', 'inteiroTeor')
  .option('--caput', 'Com --escopo ementa: busca so no caput da ementa')
  .option('-t, --tipo <tipos>', 'Tipo(s) de documento, virgula: acordao, monocratica, sumula, despacho-vice')
  .option('-oj, --orgao <nomes>', 'Orgao(s) julgador(es), virgula, ex.: "1a TURMA ESPECIALIZADA"')
  .option('-r, --relator <nomes>', 'Relator(es), virgula')
  .option('-cl, --classe <nomes>', 'Classe(s) processual(is), virgula, ex.: "Apelacao Civel"')
  .option('-p, --processo <numero>', 'Filtro por numero do processo DENTRO da busca (use -n para consulta direta)')
  .option('--precedente-relevante', 'So precedentes marcados como relevantes')
  .option('--sem-agrupar', 'Desliga "Agrupar Resultados" (o site vem com ele ligado)')
  .option('--literal', 'Envia a query EXATAMENTE como digitada, sem a correcao do espaco (reproduz a tela)')
  .option('-ord, --ordenacao <tipo>', 'Sort by date: recentes (default) or antigos', 'recentes')
  .option('--por-pagina <n>', 'Resultados por pagina: 10 (default), 25, 50, 100', 10)
  .option('--listar-combos', 'Lista origens, tipos, orgaos, relatores e classes e sai')
  .option('--fetch-inteiro-teor', 'Baixa o inteiro teor de cada resultado (.txt)')
  .option('--output-dir <dir>', 'Directory for downloaded files', './resultados/trf2')
  .option('--verificar [amostra]', 'Audit results: re-query N sampled processos against the base (default 5)')
  .option('--datajud', 'Com -n: consulta tambem o DataJud (CNJ) como fonte secundaria de metadados')
  .option('--max-results <number>', 'Maximum total results to collect')
  .option('-m, --max-pages <number>', 'Maximum pages to crawl', 10)
  .option('-o, --output <file>', 'Output JSON file', 'resultados/results-trf2.json')
  .option('-v, --visible', 'Sem efeito: o TRF2 e HTTP puro, nao abre browser')
  .option('--headed', 'Sem efeito: o TRF2 e HTTP puro, nao abre browser')
  .option('--json', 'Quiet mode: suppress logs, output JSON summary only')
  .action(async (opts) => {
    const jsonMode = opts.json;
    const log = jsonMode ? () => {} : console.log.bind(console);
    const lista = (v) => (v ? String(v).split(',').map((s) => s.trim()).filter(Boolean) : []);

    try {
      if (opts.listarCombos) {
        const nav = new TRF2Navigator({ log });
        const chave = TRF2Crawler.chaveOrigem(opts.origem);
        const codigo = chave === 'todas' ? '1' : TRF2Navigator.ORIGENS[chave];
        const combos = await nav.combos(codigo);
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, origem: chave, ...combos }) + '\n');
        else console.log(JSON.stringify(combos, null, 2));
        process.exit(0);
      }

      // Modo consulta direta por numero (TRF2Checker) — a verificacao de um julgado
      if (opts.numero) {
        const checker = new TRF2Checker({ log });
        const res = await checker.consultarProcesso(opts.numero, { datajud: !!opts.datajud });
        if (jsonMode) process.stdout.write(JSON.stringify({ success: true, ...res }) + '\n');
        else console.log(JSON.stringify(res, null, 2));
        process.exit(res.encontrado ? 0 : 1);
      }

      if (!opts.query && !opts.processo && !opts.orgao && !opts.relator) {
        throw new Error('Informe -q "<termos>" (ou -n <numero> para consulta direta, ou um filtro forte: -p/-r/-oj)');
      }

      log('='.repeat(60));
      log('TRF2 Jurisprudencia Crawler (eproc-jur, HTTP direto)');
      log('='.repeat(60));
      log(`Query: ${opts.query || '-'}`);
      log(`Origem: ${opts.origem}`);
      log(`Data Julgamento: ${opts.dataInicio || '-'} a ${opts.dataFim || '-'}`);
      log(`Data Publicacao: ${opts.dataPubInicio || '-'} a ${opts.dataPubFim || '-'}`);
      log(`Escopo: ${opts.escopo} | Tipo: ${opts.tipo || 'todos'}`);
      log(`Orgao: ${opts.orgao || '-'} | Relator: ${opts.relator || '-'} | Classe: ${opts.classe || '-'}`);
      log(`Max Pages: ${opts.maxPages} (${opts.porPagina}/pagina)`);
      log('='.repeat(60));

      const crawler = new TRF2Crawler({ timeout: 60000, log });

      const filters = {
        origem: opts.origem,
        dataInicio: opts.dataInicio || null,
        dataFim: opts.dataFim || null,
        dataPubInicio: opts.dataPubInicio || null,
        dataPubFim: opts.dataPubFim || null,
        escopo: opts.escopo,
        somenteCaput: !!opts.caput,
        tipos: lista(opts.tipo),
        orgaos: lista(opts.orgao),
        relatores: lista(opts.relator),
        classes: lista(opts.classe),
        processo: opts.processo || null,
        precedenteRelevante: !!opts.precedenteRelevante,
        agrupar: !opts.semAgrupar,
        ordenacao: opts.ordenacao,
        literal: !!opts.literal,
      };

      const searchOptions = {
        maxPages: parseInt(opts.maxPages, 10),
        tamanhoPagina: parseInt(opts.porPagina, 10),
      };
      if (opts.maxResults) searchOptions.maxResults = parseInt(opts.maxResults, 10);

      const results = await crawler.search(opts.query || '', filters, searchOptions);

      log('='.repeat(60));
      log(`Total results collected: ${results.length}`);
      if (results.totalResults) log(`Total results on server: ${results.totalResults}`);

      let downloaded = null;
      if (opts.fetchInteiroTeor) {
        const outputDir = path.resolve(opts.outputDir);
        log(`\nDownloading full text for ${results.length} results...`);
        downloaded = await crawler.fetchInteiroTeorBatch(results, outputDir, { log });
        log(`Files saved to: ${outputDir}`);
      }
      await crawler.close();

      let verificacao = null;
      if (opts.verificar) {
        const amostra = opts.verificar === true ? 5 : parseInt(opts.verificar, 10);
        log(`\nVerificando amostra de ${amostra} resultados contra a base...`);
        verificacao = await new TRF2Checker({ log }).verificarResultados(results, { amostra, log });
        log(`Verificacao: ${verificacao.confirmados}/${verificacao.verificados} confirmados`);
      }

      const outputPath = path.resolve(opts.output);
      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
      fs.writeFileSync(outputPath, JSON.stringify(Array.from(results), null, 2), 'utf-8');
      log(`Results saved to: ${outputPath}`);

      if (jsonMode) {
        process.stdout.write(JSON.stringify({
          success: true,
          totalResults: results.totalResults || null,
          count: results.length,
          origemAplicada: results.origemAplicada,
          queryEnviada: results.queryEnviada,
          ...(results.avisos && results.avisos.length ? { avisos: results.avisos } : {}),
          output: outputPath,
          ...(downloaded ? {
            downloaded: downloaded.filter((d) => d.arquivo).length,
            failed: downloaded.filter((d) => !d.arquivo).length,
            outputDir: path.resolve(opts.outputDir),
          } : {}),
          ...(verificacao ? { verificacao } : {}),
        }) + '\n');
      }
    } catch (error) {
      if (jsonMode) {
        process.stdout.write(JSON.stringify({ success: false, error: error.message }) + '\n');
        process.exit(1);
      }
      console.error('Error during crawling:', error.message);
      process.exit(1);
    }
  });

