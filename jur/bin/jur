  .option('-dpi, --data-pub-inicio <date>', 'NAO existe data de publicacao nesta base')
  .option('-dpf, --data-pub-fim <date>', 'NAO existe data de publicacao nesta base')
  .option('--size <n>', 'Documentos por pagina (max medido 2000)', String(TCEPECrawler.SIZE_DEFAULT))
  .option('--listar-filtros', 'Lista relatores, orgaos, modalidades, tipos e anos e sai')
  .option('--verificar [amostra]', 'Audita N permalinks oficiais (default 3)')
