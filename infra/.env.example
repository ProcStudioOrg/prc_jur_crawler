JUR_PUBLIC_URL=https://jurcrawler.com.br
PROCSTUDIO_FRONTEND_URL=https://procstudio.example
PROCSTUDIO_API_URL=https://api.procstudio.example
PROCSTUDIO_ISSUER=https://api.procstudio.example
PROCSTUDIO_CLIENT_ID=jurcrawler
# Gere separadamente; iguais a JURCRAWLER_CLIENT_SECRET no Rails.
PROCSTUDIO_CLIENT_SECRET=
# 32 bytes aleatórios em base64, mantidos fora do Git e dos logs.
JUR_ENCRYPTION_KEY=

# Vagas globais para buscas/listagens e prazo para intervenção manual.
JUR_CONCORRENCIA=3
JUR_MEM_LIMIT=2g
# Em produção, use uma imagem por revisão (ex.: jur:<commit>).
JUR_IMAGE=jur:dev
JUR_CAPTCHA_TIMEOUT_MS=120000
# Opcionais: só usados se a conta selecionar Browserbase no painel.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Navegadores remotos. O IP do servidor é bloqueado por TRF3 e Falcão (TST/TRTs/CSJT);
# com uma chave configurada, esses tribunais rodam no fornecedor. Ordem = custo:
# Kernel US$0,06/h por segundo; Steel US$0,10/h por minuto (reserva).
KERNEL_API_KEY=
STEEL_API_KEY=
JUR_NAVEGADOR_REMOTO=kernel,steel
# Vagas remotas: não usam Chromium do servidor; respeite o plano (Kernel Developer = 5).
JUR_CONCORRENCIA_REMOTA=5
# Aviso de deploy ao dashboard (FFD): mesma URL do WAO/Signer, com ?token=. Vazio = desligado.
USAGE_WEBHOOK_URL=
# Sentinela do Kaizen: casos conhecidos (jur/tests/sentinela-casos.json) às 04:00 de SP.
# 1 liga; desligada por padrão. Remoto (TRF3/Falcão/STJ) só às segundas e no 1º boot de versão nova.
JUR_SENTINELA=
# Teto de sessões remotas abertas por rodada (Kernel + Steel de reserva contam as duas).
JUR_SENTINELA_MAX_REMOTO=6
# Prazo total da rodada, em minutos; o que sobrar conta como pulado.
JUR_SENTINELA_PRAZO_MIN=180

# Kaizen (docs/kaizen.md): falhas, conferência de filtros e relatos enviados ao FFD.
# Base dos webhooks; URL ou token vazio = outbox desligada (nada é guardado nem sai do servidor).
KAIZEN_WEBHOOK_URL=https://ffd.belzinhos.com.br/api/webhooks
# Endpoint key "jurcrawler" do FFD, com os sources jur-diagnostico,user-issues. Nunca no Git.
KAIZEN_WEBHOOK_TOKEN=
# openssl rand -base64 32 ; sem ele o usuario_hash vai null.
KAIZEN_SALT=
# Botão Relatar -> card no Linear. LINEAR_TEAM_ID = id (uuid) do time BRU. Sem os dois, só o FFD recebe o
# relato; sem Linear e sem outbox ligada (URL + token), o botão some.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# JUR_SENTINELA=1 só em produção (veja acima); vazio ou 0 = desligada.
