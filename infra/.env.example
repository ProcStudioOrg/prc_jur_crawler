JUR_PUBLIC_URL=https://jurcrawler.com.br
PROCSTUDIO_FRONTEND_URL=https://procstudio.example
PROCSTUDIO_API_URL=https://api.procstudio.example
PROCSTUDIO_ISSUER=https://api.procstudio.example
PROCSTUDIO_CLIENT_ID=jurcrawler
# Gere separadamente; iguais a JURCRAWLER_CLIENT_SECRET no Rails.
PROCSTUDIO_CLIENT_SECRET=
# 32 bytes aleatórios em base64, mantidos fora do Git e dos logs.
JUR_ENCRYPTION_KEY=

# Vagas globais para buscas/listagens e prazo para intervenção manual.
JUR_CONCORRENCIA=3
JUR_MEM_LIMIT=2g
# Em produção, use uma imagem por revisão (ex.: jur:<commit>).
JUR_IMAGE=jur:dev
JUR_CAPTCHA_TIMEOUT_MS=120000
# Opcionais: só usados se a conta selecionar Browserbase no painel.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Navegadores remotos. O IP do servidor é bloqueado por TRF3 e Falcão (TST/TRTs/CSJT);
# com uma chave configurada, esses tribunais rodam no fornecedor. Ordem = custo:
# Kernel US$0,06/h por segundo; Steel US$0,10/h por minuto (reserva).
KERNEL_API_KEY=
STEEL_API_KEY=
JUR_NAVEGADOR_REMOTO=kernel,steel
# Vagas remotas: não usam Chromium do servidor; respeite o plano (Kernel Developer = 5).
JUR_CONCORRENCIA_REMOTA=5
# Aviso de deploy ao dashboard (FFD): mesma URL do WAO/Signer, com ?token=. Vazio = desligado.
USAGE_WEBHOOK_URL=
