JUR_PUBLIC_URL=https://jurcrawler.com.br
PROCSTUDIO_FRONTEND_URL=https://procstudio.example
PROCSTUDIO_API_URL=https://api.procstudio.example
PROCSTUDIO_ISSUER=https://api.procstudio.example
PROCSTUDIO_CLIENT_ID=jurcrawler
# Gere separadamente; iguais a JURCRAWLER_CLIENT_SECRET no Rails.
PROCSTUDIO_CLIENT_SECRET=
# 32 bytes aleatórios em base64, mantidos fora do Git e dos logs.
JUR_ENCRYPTION_KEY=

# Vagas globais para buscas/listagens e prazo para intervenção manual.
JUR_CONCORRENCIA=3
JUR_CAPTCHA_TIMEOUT_MS=120000
# Opcionais: só usados se a conta selecionar Browserbase no painel.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
